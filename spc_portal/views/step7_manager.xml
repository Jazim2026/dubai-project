                                                    </div>
                                                    <div class="upload-item" style="margin-bottom:16px">
                                                        <span class="field-label-top">Upload UAE entry visa or tourist visa</span>
                                                        <div class="upload-area" onclick="document.getElementById('mgr_1_entry_visa').click()">
                                                            <input type="file" id="mgr_1_entry_visa" name="mgr_1_entry_visa" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                                                            <div class="upload-icon">&#11014;</div>
                                                            <div class="upload-text">Upload UAE entry visa or tourist visa</div>
                                                        </div>
                                                    </div>
                                                    <div class="field-flat" style="margin-bottom:16px"><input class="flat-input" type="text" name="mgr_1_id_number" placeholder="ID number"/></div>
                                                    <div class="two-col" style="margin-bottom:16px">
                                                        <div class="date-flat-wrap">
                                                            <span class="date-flat-label">ID issue date</span>
                                                            <input type="date" class="date-flat" name="mgr_1_id_issue_date"/>
                                                        </div>
                                                        <div class="date-flat-wrap">
                                                            <span class="date-flat-label">ID expiry date</span>
                                                            <input type="date" class="date-flat" name="mgr_1_id_expiry_date"/>
                                                        </div>
                                                    </div>
                                                    <div class="select-flat-wrap" style="margin-bottom:16px">
                                                        <label>Country of Residence</label>
                                                        <select class="flat-select" name="mgr_1_country_residence" id="mgr_1_country_res" onchange="showFlatClear('mgr_1_cres_clear',this)">
                                                            <option value=""></option>
                                                            <option value="AE">United Arab Emirates</option>
                                                            <option value="IN">India</option>
                                                            <option value="PK">Pakistan</option>
                                                            <option value="GB">United Kingdom</option>
                                                            <option value="US">United States</option>
                                                            <option value="other">Other</option>
                                                        </select>
                                                        <span class="flat-arrow">&#9660;</span>
                                                        <button type="button" class="flat-clear hidden" id="mgr_1_cres_clear" onclick="clearFlatSelect('mgr_1_country_res','mgr_1_cres_clear')">&#10005;</button>
                                                    </div>
                                                    <div style="margin-bottom:16px">
                                                        <span class="question-label">Do you or your company operate elsewhere?</span>
                                                        <div class="radio-group">
                                                            <label class="radio-label"><input type="radio" name="mgr_1_operate_elsewhere" value="yes"/> Yes</label>
                                                            <label class="radio-label"><input type="radio" name="mgr_1_operate_elsewhere" value="no" checked="checked"/> No</label>
                                                        </div>
                                                    </div>
                                                    <div style="margin-bottom:16px">
                                                        <span class="question-label">Does the Manager have a Nominee?</span>
                                                        <div class="radio-group">
                                                            <label class="radio-label"><input type="radio" name="mgr_1_nominee" value="yes"/> Yes</label>
                                                            <label class="radio-label"><input type="radio" name="mgr_1_nominee" value="no"/> No</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- UAE resident = Yes → resident fields -->
                                                <div id="mgr_1_resident_section" class="hidden">
                                                    <div class="upload-row" style="margin-top:8px">
                                                        <div class="upload-item">
                                                            <span class="field-label-top">Upload UAE resident visa</span>
                                                            <div class="upload-area" onclick="document.getElementById('mgr_1_res_visa').click()">
                                                                <input type="file" id="mgr_1_res_visa" name="mgr_1_res_visa" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                                                                <div class="upload-icon">&#11014;</div>
                                                                <div class="upload-text">Upload UAE resident visa</div>
                                                            </div>
                                                        </div>
                                                        <div class="upload-item">
                                                            <span class="field-label-top">Upload emirates ID</span>
                                                            <div class="upload-area" onclick="document.getElementById('mgr_1_eid').click()">
                                                                <input type="file" id="mgr_1_eid" name="mgr_1_eid" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                                                                <div class="upload-icon">&#11014;</div>
                                                                <div class="upload-text">Upload emirates ID</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="two-col" style="margin-bottom:16px">
                                                        <div class="field-flat"><input class="flat-input" type="text" name="mgr_1_visa_no" placeholder="Resident visa number"/></div>
                                                        <div class="field-flat"><input class="flat-input" type="text" name="mgr_1_eid_no" placeholder="Emirates ID number"/></div>
                                                    </div>
                                                    <div class="two-col" style="margin-bottom:16px">
                                                        <div class="field-flat"><input class="flat-input" type="text" name="mgr_1_uid" placeholder="Unified number (UID)"/></div>
                                                        <div class="date-flat-wrap">
                                                            <span class="date-flat-label">Emirates ID issue date</span>
                                                            <input type="date" class="date-flat" name="mgr_1_eid_issue"/>
                                                        </div>
                                                    </div>
                                                    <div class="two-col" style="margin-bottom:16px">
                                                        <div class="date-flat-wrap">
                                                            <span class="date-flat-label">Emirates ID expiry date</span>
                                                            <input type="date" class="date-flat" name="mgr_1_eid_expiry"/>
                                                        </div>
                                                    </div>
                                                    <div style="margin-bottom:16px">
                                                        <span class="question-label">Does the Manager have a Nominee?</span>
                                                        <div class="radio-group">
                                                            <label class="radio-label"><input type="radio" name="mgr_1_nominee_res" value="yes"/> Yes</label>
                                                            <label class="radio-label"><input type="radio" name="mgr_1_nominee_res" value="no"/> No</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="save-row">
                                        <button type="button" class="save-btn" onclick="saveMgr(1)">SAVE</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="spc-nav-buttons">
                <a t-att-href="'/spc/setup-new-company/apply/step6/' + service_type" class="spc-btn-previous">PREVIOUS</a>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
<![CDATA[
/* ---- Manager accordion ---- */
function toggleMgrAccordion(n) {
    var b = document.getElementById('mgr_body_' + n);
    var a = document.getElementById('mgr_arrow_' + n);
    b.classList.toggle('open');
    a.classList.toggle('open');
}

/* ---- Define manager type toggle ---- */
function toggleMgrDefine(n, val) {
    var sh  = document.getElementById('mgr_' + n + '_sh_section');
    var spc = document.getElementById('mgr_' + n + '_spc_sh_section');
    var an  = document.getElementById('mgr_' + n + '_add_new_section');
    [sh, spc, an].forEach(function(el) { if (el) el.classList.add('hidden'); });
    if (val === 'shareholder' && sh)  sh.classList.remove('hidden');
    if (val === 'spc_shareholder' && spc) spc.classList.remove('hidden');
    if (val === 'add_new' && an)  an.classList.remove('hidden');
}

/* ---- UAE resident toggle ---- */
function toggleMgrUaeResident(n, val) {
    var nr = document.getElementById('mgr_' + n + '_non_resident_section');
    var rs = document.getElementById('mgr_' + n + '_resident_section');
    if (val === 'yes') {
        if (nr) nr.classList.add('hidden');
        if (rs) rs.classList.remove('hidden');
    } else {
        if (nr) nr.classList.remove('hidden');
        if (rs) rs.classList.add('hidden');
    }
}

/* ---- Alternate nationality ---- */
function toggleMgrAltNat(n, val) {
    var f = document.getElementById('mgr_' + n + '_alt_nat_fields');
    if (f) val === 'yes' ? f.classList.remove('hidden') : f.classList.add('hidden');
}

/* ---- Secondary contact ---- */
function toggleMgrSecondary(n, val) {
    var f = document.getElementById('mgr_' + n + '_secondary_field');
    if (f) val === 'yes' ? f.classList.remove('hidden') : f.classList.add('hidden');
}

/* ---- Flag menu ---- */
function toggleMgrFlagMenu(n) {
    var m = document.getElementById('mgr_' + n + '_flag_menu');
    if (m) m.classList.toggle('hidden');
}
function setMgrFlag(n, flag, code) {
    var btn = document.getElementById('mgr_' + n + '_flag_btn');
    if (btn) btn.innerHTML = flag + ' ' + code + ' &#9660;';
    var m = document.getElementById('mgr_' + n + '_flag_menu');
    if (m) m.classList.add('hidden');
}
document.addEventListener('click', function(e) {
    document.querySelectorAll('[id$="_flag_menu"]').forEach(function(m) {
        if (!m.classList.contains('hidden') && !m.parentElement.contains(e.target)) m.classList.add('hidden');
    });
});

/* ---- Flat select helpers ---- */
function showFlatClear(clearId, sel) {
    var btn = document.getElementById(clearId);
    if (btn) sel.value ? btn.classList.remove('hidden') : btn.classList.add('hidden');
}
function clearFlatSelect(selId, clearId) {
    var s = document.getElementById(selId); if (s) s.value = '';
    var b = document.getElementById(clearId); if (b) b.classList.add('hidden');
}

/* ---- Address counter ---- */
function updateMgrCount(el, id) {
    var sp = document.getElementById(id);
    if (sp) sp.textContent = el.value.length + ' / 100';
}

/* ---- Save manager ---- */
function saveMgr(n) {
    var b = document.querySelector('#mgr_acc_' + n + ' .save-btn:last-of-type');
    if (b) { b.textContent = '&#10003; SAVED'; b.style.background = '#1abc9c'; }
}

/* ---- Delete manager ---- */
function deleteManager(n) {
    var a = document.getElementById('mgr_acc_' + n);
    if (a) a.remove();
}

/* ---- Dynamic manager list ---- */
function updateManagerList(count) {
    count = Math.min(Math.max(parseInt(count) || 1, 1), 10);
    var list = document.getElementById('managerList');
    var existing = list.querySelectorAll('.accordion').length;
    if (count > existing) {
        for (var i = existing + 1; i <= count; i++) {
            var div = document.createElement('div');
            div.className = 'accordion';
            div.id = 'mgr_acc_' + i;
            div.innerHTML = '<div class="accordion-header" onclick="toggleMgrAccordion(' + i + ')"><span>Manager ' + i + '</span><span class="accordion-arrow" id="mgr_arrow_' + i + '">&#9660;</span></div>' +
                '<div class="accordion-body" id="mgr_body_' + i + '">' +
                '<div class="manager-card">' +
                '<div class="delete-mgr-btn" onclick="deleteManager(' + i + ')">&#128465; Delete Manager</div>' +
                '<div class="sub-section"><span class="question-label">Define the manager details from one of the following selections</span>' +
                '<div class="radio-group" style="flex-wrap:wrap;gap:16px">' +
                '<label class="radio-label"><input type="radio" name="mgr_' + i + '_define" value="shareholder" onchange="toggleMgrDefine(' + i + ',\'shareholder\')"/> Shareholder of this entity</label>' +
                '<label class="radio-label"><input type="radio" name="mgr_' + i + '_define" value="spc_shareholder" onchange="toggleMgrDefine(' + i + ',\'spc_shareholder\')"/> Current shareholder of another entity in SPC FZ</label>' +
                '<label class="radio-label"><input type="radio" name="mgr_' + i + '_define" value="add_new" onchange="toggleMgrDefine(' + i + ',\'add_new\')"/> Add new</label>' +
                '</div></div>' +
                '<div class="info-link-box"><p>Please find instructional video on how to upload UID</p><a href="https://youtu.be/T536np8xm_w" target="_blank">https://youtu.be/T536np8xm_w</a></div>' +
                '</div>' +
                '<div class="save-row"><button type="button" class="save-btn" onclick="saveMgr(' + i + ')">SAVE</button></div>' +
                '</div>';
            list.appendChild(div);
        }
    } else if (count < existing) {
        for (var j = existing; j > count; j--) {
            var el = document.getElementById('mgr_acc_' + j);
            if (el) el.remove();
        }
    }
}
]]>
</script>
