<template id="phone_answering_payment" name="Phone Answering Payment">
<html><head><meta charset="utf-8"/><title>Payment | SPC Free Zone</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;display:flex;min-height:100vh}
.progress-sidebar{width:280px;background:#1a2340;color:white;padding:32px 24px;position:fixed;top:0;left:0;bottom:0;overflow-y:auto}
.ps-logo{font-size:18px;font-weight:700;margin-bottom:4px}
.ps-diamond{color:#1abc9c;font-size:22px}
.ps-subtitle{font-size:11px;opacity:.5;font-weight:400}
.progress-title{font-size:11px;font-weight:600;opacity:.7;margin:24px 0 16px;text-transform:uppercase;letter-spacing:1px}
.progress-step{display:flex;align-items:flex-start;gap:14px;padding:10px 0}
.ps-num{width:36px;height:36px;border-radius:50%;border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
.ps-num.active{background:#1abc9c;border-color:#1abc9c}
.ps-num.done{background:white;border-color:white;color:#1a2340}
.ps-info{display:flex;flex-direction:column;gap:2px;padding-top:4px}
.ps-label{font-size:13px;opacity:.6;font-weight:500}
.ps-label.active{opacity:1;font-weight:700;font-size:14px}
.ps-total{margin-top:32px;padding-top:20px;border-top:1px solid rgba(255,255,255,.15)}
.ps-total-lbl{font-size:11px;opacity:.6;text-transform:uppercase;letter-spacing:.5px}
.ps-total-val{font-size:22px;font-weight:700;margin-top:2px}
.form-main{margin-left:280px;padding:40px 56px;min-height:100vh;flex:1}
.form-title{font-size:32px;font-weight:700;color:#1abc9c;margin-bottom:36px}
.pay-card{background:white;border-radius:12px;padding:32px;max-width:560px;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.pay-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:20px}
.pay-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f3f4f6;font-size:14px}
.pay-row:last-of-type{border-bottom:none;font-weight:700;font-size:16px}
.pay-method-title{font-size:14px;font-weight:600;color:#1a2340;margin:20px 0 12px}
.pay-option{display:flex;align-items:center;gap:12px;padding:14px 16px;border:2px solid #e0e0e0;border-radius:8px;margin-bottom:10px;cursor:pointer}
.pay-option:hover{border-color:#1abc9c}
.submit-btn{width:100%;background:#e91e8c;color:white;border:none;border-radius:8px;padding:14px;font-size:15px;font-weight:700;cursor:pointer;margin-top:20px}
.btn-prev{background:white;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:14px 36px;font-size:14px;font-weight:700;text-decoration:none;display:inline-block;margin-top:16px}
</style>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head>
<body>
<div class="progress-sidebar">
  <div class="ps-logo"><span class="ps-diamond">&#9670;</span> K SPC</div>
  <div class="ps-subtitle">Free Zone</div>
  <div class="progress-title">Your progress</div>
  <div class="progress-step"><div class="ps-num done">&#10003;</div><div class="ps-info"><div class="ps-label">Phone answering details</div></div></div>
  <div class="progress-step"><div class="ps-num done">&#10003;</div><div class="ps-info"><div class="ps-label">Service details</div></div></div>
  <div class="progress-step"><div class="ps-num done">&#10003;</div><div class="ps-info"><div class="ps-label">Declaration</div></div></div>
  <div class="progress-step"><div class="ps-num done">&#10003;</div><div class="ps-info"><div class="ps-label">Review application</div></div></div>
  <div class="progress-step"><div class="ps-num active">5</div><div class="ps-info"><div class="ps-label active">Payment</div></div></div>
  <div class="ps-total">
    <div class="ps-total-lbl">Total AED</div>
    <div class="ps-total-val"><t t-esc="'%.2f' % (record.amount or 10.0)"/> &#9432;</div>
  </div>
</div>
<div class="form-main">
  <div class="form-title">New</div>
  <div class="pay-card">
    <div class="pay-title">Payment Summary</div>
    <div class="pay-row">
      <span style="color:#555">Phone Answering Service Fee</span>
      <span style="color:#1a2340;font-weight:600">AED <t t-esc="'%.2f' % (record.amount or 10.0)"/></span>
    </div>
    <div class="pay-row">
      <span>Total</span>
      <span>AED <t t-esc="'%.2f' % (record.amount or 10.0)"/></span>
    </div>
    <div class="pay-method-title">Select payment method</div>
    <label class="pay-option"><input type="radio" name="payment_method" value="card"/> <span style="font-size:14px">Credit / Debit Card</span></label>
    <label class="pay-option"><input type="radio" name="payment_method" value="transfer"/> <span style="font-size:14px">Online Bank Transfer</span></label>
    <button class="submit-btn">SUBMIT</button>
  </div>
  <a t-attf-href="/spc/concierge/phone-answering/review/#{record.id}" class="btn-prev">PREVIOUS</a>
</div>
</body></html>
</template>

