    document.getElementById('cl_decl_err').textContent='Please accept the declaration to continue.';
    document.getElementById('cl_decl_err').style.display='block';
    return;
  }
  var el=document.getElementById('cl_decl_err');if(el)el.style.display='none';
  document.querySelector('form').submit();
}
