<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<template id="cl_css" name="CL CSS">
<style>
.radio-row{display:flex;gap:16px;flex-wrap:wrap;margin-top:8px}
.radio-card{border:1.5px solid #e5e7eb;border-radius:8px;padding:12px 20px;cursor:pointer;font-size:13px;color:#374151;display:flex;align-items:center;gap:8px;transition:all .2s}
.radio-card.selected{border-color:#1abc9c;background:#f0fdf9;color:#1a2340;font-weight:600}
.flat-input{width:100%;padding:10px 0;border:none;border-bottom:1.5px solid #d1d5db;font-size:14px;color:#1a2340;outline:none;background:transparent;display:block;margin-bottom:16px}
.flat-input:focus{border-bottom-color:#1abc9c}
.flat-select{width:100%;padding:10px 0;border:none;border-bottom:1.5px solid #d1d5db;font-size:14px;color:#1a2340;outline:none;background:transparent;cursor:pointer}
.sel-row{position:relative;margin-bottom:20px}
.sel-clear{position:absolute;right:4px;top:50%;transform:translateY(-50%);width:18px;height:18px;background:#6b7280;border-radius:50%;color:#fff;border:none;cursor:pointer;font-size:11px}
.info-box{background:#fef3c7;border-left:3px solid #f59e0b;padding:12px 16px;border-radius:6px;font-size:12px;color:#92400e;margin-top:12px;display:flex;gap:8px}
.field-lbl{font-size:12px;color:#6b7280;font-weight:500;margin-top:2px}
.upload-area{border:2px solid #1abc9c;border-radius:8px;padding:20px;text-align:center;cursor:pointer;background:#fff;max-width:260px}
.upload-icon{font-size:22px;color:#1a6fa8;margin-bottom:6px}
.upload-text{font-size:13px;color:#1a6fa8;font-weight:500}
.upload-row{display:flex;gap:20px;flex-wrap:wrap;margin-top:12px}
.upload-item{display:flex;flex-direction:column;gap:6px}
.upload-item .field-label-top{font-size:13px;color:#555;font-weight:600}
</style>
</template>

<template id="cl_sidebar" name="CL Sidebar">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">YOUR PROGRESS</div>
    <t t-foreach="steps" t-as="step">
        <div class="progress-step" t-attf-class="progress-step #{step_index + 1 &lt; current_step and 'done' or (step_index + 1 == current_step and 'active' or '')}">
            <div class="step-num" t-attf-class="step-num">
                <t t-if="step_index + 1 &lt; current_step">&#10003;</t>
                <t t-else=""><t t-out="step_index + 1"/></t>
            </div>
            <div class="step-label" t-attf-class="step-label #{step_index + 1 == current_step and 'active' or ''}">
                <t t-out="step"/>
            </div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">360.00</div></div>
    <div class="sidebar-links">
        <a href="/spc/company-management/corporate-letters/save-later">SAVE &amp; EXIT</a>
        <a href="/spc/company-management/corporate-letters/cancel" style="color:#f87171">CANCEL APPLICATION</a>
    </div>
</div>
</template>

