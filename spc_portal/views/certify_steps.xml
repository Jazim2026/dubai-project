<template id="template_certify_step1" name="Certify Step1 Document">
<html>
<head><meta charset="utf-8"/><title>Certify</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f0f4f8;color:#1a2340}
.layout{display:flex;min-height:100vh}
.sidebar{width:280px;background:#0d1b3e;color:#fff;padding:28px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.sidebar-top{display:flex;align-items:center;gap:10px;margin-bottom:32px}
.logo-box{background:#1abc9c;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px}
.logo-name{font-size:16px;font-weight:700}
.logo-sub{font-size:11px;opacity:.6}
.progress-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;opacity:.4;margin-bottom:12px}
.progress-step{display:flex;align-items:center;gap:12px;margin-bottom:10px;opacity:.45;padding:6px 0}
.progress-step.active{opacity:1}
.progress-step.done{opacity:.75}
.step-circle{width:30px;height:30px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0}
.progress-step.active .step-circle{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-circle{background:#fff;color:#0d1b3e;border-color:#fff}
.step-text{font-size:13px;line-height:1.3}
.total-section{margin-top:auto;padding-top:20px;border-top:1px solid rgba(255,255,255,.1)}
.total-amount{font-size:22px;font-weight:700;color:#1abc9c}
.main{margin-left:280px;padding:40px 48px;min-height:100vh}
.page-title{font-size:28px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.sec-num{font-size:12px;color:#1abc9c;font-weight:700;margin-bottom:8px}
.sec-title{font-size:17px;font-weight:700;color:#1a2340;margin-bottom:16px}
.doc-select-wrap{position:relative;max-width:700px}
.doc-input{width:100%;padding:14px 44px 14px 16px;border:none;border-bottom:2px solid #ddd;font-size:14px;background:#f8f9fa;outline:none;cursor:pointer;color:#888}
.doc-input:focus{border-bottom-color:#1abc9c;background:#fff}
.doc-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:#333;color:#fff;border:none;border-radius:50%;width:24px;height:24px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center}
.doc-dropdown{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e0e0e0;border-radius:0 0 8px 8px;z-index:100;box-shadow:0 4px 12px rgba(0,0,0,.1)}
.doc-dropdown.open{display:block}
.doc-option{padding:14px 16px;font-size:14px;cursor:pointer;color:#333;border-bottom:1px solid #f0f0f0}
.doc-option:last-child{border-bottom:none}
.doc-option:hover{background:#f0fdf4;color:#1abc9c}
.doc-option.selected{color:#1abc9c;font-weight:600}
.selected-docs{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;max-width:700px}
.doc-tag{background:#1abc9c;color:#fff;border-radius:20px;padding:6px 14px;font-size:13px;display:flex;align-items:center;gap:8px}
.doc-tag-remove{background:none;border:none;color:#fff;cursor:pointer;font-size:16px;line-height:1;padding:0}
.remarks-textarea{width:100%;max-width:700px;padding:14px 16px;border:none;border-bottom:2px solid #ddd;font-size:14px;outline:none;background:#f8f9fa;resize:none;min-height:60px;display:block;margin-top:8px}
.remarks-textarea:focus{border-bottom-color:#1abc9c;background:#fff}
.nav-bar{display:flex;justify-content:flex-end;margin-top:40px}
.btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:14px 48px;font-size:15px;font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-top">
        <div class="logo-box">K</div>
        <div><div class="logo-name">SPC</div><div class="logo-sub">Free Zone</div></div>
    </div>
    <div class="progress-label">Your progress</div>
    <div class="progress-step active"><div class="step-circle">1</div><div class="step-text">Document</div></div>
    <div class="progress-step"><div class="step-circle">2</div><div class="step-text">Declaration</div></div>
    <div class="progress-step"><div class="step-circle">3</div><div class="step-text">Review application</div></div>
    <div class="progress-step"><div class="step-circle">4</div><div class="step-text">Payment</div></div>
    <div class="total-section">
        <div style="font-size:11px;opacity:.5">Total</div>
        <div style="font-size:11px;opacity:.5">AED</div>
        <div class="total-amount">10.00</div>
    </div>
</div>
<div class="main">
    <div class="page-title">Certify</div>
    <form method="post" action="/spc/company-management/apply/certify-step1/submit" id="certify_form">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <input type="hidden" name="document_names" id="doc_names_input"/>
        <div style="background:#fff;border-radius:14px;padding:28px 32px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:24px">
            <div class="sec-num">01</div>
            <div class="sec-title">Select the name of the document(s) to certify</div>
            <div class="doc-select-wrap">
                <input type="text" class="doc-input" placeholder="Document" readonly="readonly"
                    onclick="toggleDropdown()" id="doc_display"/>
                <button type="button" class="doc-clear" onclick="clearDocs()">&#215;</button>
                <div class="doc-dropdown" id="doc_dropdown">
                    <div class="doc-option" onclick="selectDoc('Certificate of Formation')">Certificate of Formation</div>
                    <div class="doc-option" onclick="selectDoc('Trade License')">Trade License</div>
                    <div class="doc-option" onclick="selectDoc('Share Register')">Share Register</div>
                    <div class="doc-option" onclick="selectDoc('Lease Agreement')">Lease Agreement</div>
                    <div class="doc-option" onclick="selectDoc('Memorandum of Association')">Memorandum of Association</div>
                    <div class="doc-option" onclick="selectDoc('Articles of Association')">Articles of Association</div>
                </div>
            </div>
            <div class="selected-docs" id="selected_docs"></div>
        </div>
        <div style="background:#fff;border-radius:14px;padding:28px 32px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:24px">
            <div class="sec-num">02</div>
            <div class="sec-title">Remarks</div>
            <textarea class="remarks-textarea" name="remarks" placeholder="Comments" rows="3"></textarea>
        </div>
        <div class="nav-bar">
            <button type="submit" class="btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
var selectedDocs = [];
function toggleDropdown(){
    var dd = document.getElementById('doc_dropdown');
    dd.classList.toggle('open');
}
function selectDoc(name){
    if(!selectedDocs.includes(name)){
        selectedDocs.push(name);
        renderTags();
    }
    document.getElementById('doc_dropdown').classList.remove('open');
}
function removeDoc(name){
    selectedDocs = selectedDocs.filter(function(d){return d !== name});
    renderTags();
}
function clearDocs(){
    selectedDocs = [];
    renderTags();
}
function renderTags(){
    var container = document.getElementById('selected_docs');
    var input = document.getElementById('doc_names_input');
    container.innerHTML = selectedDocs.map(function(d){
        return '<div class="doc-tag">' + d + '<button type="button" class="doc-tag-remove" onclick="removeDoc(\'' + d + '\')">&#215;</button></div>';
    }).join('');
    input.value = selectedDocs.join(', ');
    document.getElementById('doc_display').placeholder = selectedDocs.length ? selectedDocs.length + ' document(s) selected' : 'Document';
}
document.addEventListener('click', function(e){
    var wrap = document.querySelector('.doc-select-wrap');
    if(wrap &amp;&amp; !wrap.contains(e.target)){
        document.getElementById('doc_dropdown').classList.remove('open');
    }
});
</script>
</body>
</html>
</template>

