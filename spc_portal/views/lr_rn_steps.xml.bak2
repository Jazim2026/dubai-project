}
function dirCard(i){
    return '<div class="accordion"><div class="accordion-header" onclick="this.nextElementSibling.classList.toggle('open')">Director '+i+'</div><div class="accordion-body open"><div class="two-col"><div class="field-row"><label>First name</label><input class="field-input" type="text" name="dir_'+i+'_fn" placeholder=" "/></div><div class="field-row"><label>Last name</label><input class="field-input" type="text" name="dir_'+i+'_ln" placeholder=" "/></div></div><div class="field-row"><label>Nationality</label><input class="field-input" type="text" name="dir_'+i+'_nat" placeholder=" "/></div><div class="two-col"><div class="field-row"><label>Email</label><input class="field-input" type="email" name="dir_'+i+'_email" placeholder=" "/></div><div class="field-row"><label>Mobile</label><input class="field-input" type="tel" name="dir_'+i+'_mob" placeholder=" "/></div></div><div class="field-row"><label>Passport number</label><input class="field-input" type="text" name="dir_'+i+'_passport_no" placeholder=" "/></div><div class="upload-label">Passport copy</div><div class="upload-box" onclick="document.getElementById('dir_'+i+'_pf').click()"><input type="file" id="dir_'+i+'_pf" name="dir_'+i+'_pf" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/><div class="upload-icon">&#11014;</div><div class="upload-text">Upload passport</div></div></div></div>';
}
document.addEventListener('DOMContentLoaded', function(){ buildDirAccordions(); });
