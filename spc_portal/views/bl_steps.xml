<script>
function selectYN(group, val, el) {
    // Style cards
    var row = el.closest('.yn-row');
    row.querySelectorAll('.yn-card').forEach(function(c){ c.classList.remove('yn-active'); });
    el.classList.add('yn-active');
    // Check radio
    var radio = el.querySelector('input[type=radio]');
    if(radio){ radio.checked = true; }
    // EC specific logic
    if(group === 'ec') {
        var validitySection = document.getElementById('ec-validity-section');
        var numEl = document.getElementById('echannel-num');
        if(val === 'yes') {
            validitySection.style.display = 'block';
            if(numEl) numEl.textContent = '03';
        } else {
            validitySection.style.display = 'none';
            if(numEl) numEl.textContent = '02';
        }
    }
}
</script>
