<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_spc_otp" model="mail.template">
            <field name="name">SPC Portal: OTP Verification</field>
            <field name="model_id" ref="spc_portal.model_spc_otp"/>
            <field name="subject">Your OTP Code - SPC Free Zone</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <p>Your OTP code: <strong t-out="object.otp_code"/></p>
                <p>Valid for 10 minutes.</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>


