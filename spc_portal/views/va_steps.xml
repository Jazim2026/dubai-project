<!-- VA Steps sidebar CSS shared style -->
<template id="template_va_step1" name="VA Step1 IDN Details">
<html>
<head><meta charset="utf-8"/><title>Visa Allocation Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>
.num-grid{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.num-btn{width:52px;height:52px;border-radius:8px;border:2px solid #e0e0e0;background:#fff;font-size:16px;font-weight:600;cursor:pointer;transition:.2s;color:#333}
.num-btn.active{background:#1a2340;color:#fff;border-color:#1a2340}
.num-btn:hover{border-color:#1abc9c}
.radio-option{display:flex;align-items:center;gap:10px;padding:8px 0;font-size:14px;cursor:pointer}
.radio-option input[type=radio]{width:18px;height:18px;accent-color:#1abc9c}
.flat-input{width:100%;max-width:600px;padding:12px 16px;border:none;border-bottom:2px solid #ddd;font-size:14px;background:#fff;outline:none;display:block}
.flat-input:focus{border-bottom-color:#1abc9c}
.pay-option{display:flex;align-items:center;gap:12px;padding:14px 0;font-size:14px;border-bottom:1px solid #f0f0f0;cursor:pointer}
.pay-option:last-child{border-bottom:none}
.pay-option input[type=radio]{width:18px;height:18px;accent-color:#1abc9c}
</style>

</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <div class="progress-step active"><div class="step-num">1</div><div class="step-label">IDN details</div></div>
    <div class="progress-step"><div class="step-num">2</div><div class="step-label">Amendment information</div></div>
    <div class="progress-step"><div class="step-num">3</div><div class="step-label">Company information</div></div>
    <div class="progress-step"><div class="step-num">4</div><div class="step-label">Office facility</div></div>
    <div class="progress-step"><div class="step-num">5</div><div class="step-label">Visa allocation</div></div>
    <div class="progress-step"><div class="step-num">6</div><div class="step-label">Declaration</div></div>
    <div class="progress-step"><div class="step-num">7</div><div class="step-label">Review application</div></div>
    <div class="progress-step"><div class="step-num">8</div><div class="step-label">Payment</div></div>
    <div class="total-box">Total AED
        <div class="total-label">Total</div>
        Total AED
<div class="amount">10.00</div>
    </div>
</div>
<div class="main">
    <div class="form-title">Visa Allocation Amendment</div>
    <form method="post" action="/spc/company-management/apply/va-step1/submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section"><div class="sec-body">
            <div class="sec-num">01</div>
            <div class="sec-title">Select license number</div>
            <div style="display:flex;gap:0;margin-bottom:16px;max-width:500px">
                <button type="button" id="btn_select" onclick="switchMode('select')"
                    style="flex:1;padding:10px;border:1px solid #1abc9c;background:#1abc9c;color:#fff;font-size:13px;font-weight:600;cursor:pointer;border-radius:6px 0 0 6px">
                    Select from list
                </button>
                <button type="button" id="btn_manual" onclick="switchMode('manual')"
                    style="flex:1;padding:10px;border:1px solid #ddd;background:#fff;color:#555;font-size:13px;font-weight:600;cursor:pointer;border-radius:0 6px 6px 0">
                    Enter manually
                </button>
            </div>
            <div id="mode_select">
                <select name="company_id" class="flat-select" style="max-width:500px;width:100%;padding:12px 16px;border:none;border-bottom:2px solid #ddd;font-size:14px;outline:none;background:#fff">
                    <option value="">Company</option>
                    <t t-foreach="companies" t-as="c">
                        <option t-att-value="c.id"><t t-esc="c.name"/></option>
                    </t>
                </select>
                <div style="background:#e8f8f5;border:1px solid #1abc9c;border-radius:8px;padding:12px 16px;margin-top:12px;font-size:13px;color:#555;max-width:500px">
                    &#9432; Making a selection here will auto-fill the fields with information from the initial application whenever available. Please verify and update the data as needed.
                </div>
            </div>
            <div id="mode_manual" style="display:none">
                <input type="text" name="company_name_manual" placeholder="Enter company name"
                    style="max-width:500px;width:100%;padding:12px 16px;border:none;border-bottom:2px solid #1abc9c;font-size:14px;outline:none;display:block"/>
            </div>
            <div class="info-box">
                <div class="info-icon">&#9432;</div>
                <div class="info-text">If your Company license is about to expire. Please do an early license renewal to avoid paying for the visa allocation again at the time of license renewal/ duplicate charges.</div>
            </div>
        </div>
        </div>
        <div class="spc-nav-buttons">
            <a href="/spc/company-management" class="spc-btn-prev">BACK</a>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>//<![CDATA[
function switchMode(mode){
    var sel = document.getElementById('mode_select');
    var man = document.getElementById('mode_manual');
    var btnSel = document.getElementById('btn_select');
    var btnMan = document.getElementById('btn_manual');
    if(mode === 'select'){
        sel.style.display = 'block'; man.style.display = 'none';
        btnSel.style.background='#1abc9c'; btnSel.style.color='#fff'; btnSel.style.borderColor='#1abc9c';
        btnMan.style.background='#fff'; btnMan.style.color='#555'; btnMan.style.borderColor='#ddd';
    } else {
        sel.style.display = 'none'; man.style.display = 'block';
        btnMan.style.background='#1abc9c'; btnMan.style.color='#fff'; btnMan.style.borderColor='#1abc9c';
        btnSel.style.background='#fff'; btnSel.style.color='#555'; btnSel.style.borderColor='#ddd';
    }
}
//]]>
</script>
</body>
</html>
</template>

