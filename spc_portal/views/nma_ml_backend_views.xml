<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="view_spc_nma_media_license_tree" model="ir.ui.view">
        <field name="name">spc.nma.media.license.tree</field>
        <field name="model">spc.nma.media.license</field>
        <field name="arch" type="xml">
            <tree string="NMA Media License"
                  decoration-info="state=='draft'"
                  decoration-success="state=='approved'"
                  decoration-muted="state=='rejected'">
                <field name="name"/>
                <field name="license_type"/>
                <field name="company_name"/>
                <field name="partner_id"/>
                <field name="submission_date"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'"
                       decoration-primary="state=='under_review'"
                       decoration-success="state=='approved'"
                       decoration-danger="state=='rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_spc_nma_media_license_form" model="ir.ui.view">
        <field name="name">spc.nma.media.license.form</field>
        <field name="model">spc.nma.media.license</field>
        <field name="arch" type="xml">
            <form string="NMA Media License">
                <header>
                    <button name="action_approve_documents" string="Approve Documents" type="object"
                            invisible="state not in ['submitted','under_review']" class="btn-primary"/>
                    <button name="action_approve_payment" string="Payment Approval" type="object"
                            invisible="state != 'documents_approved'" class="btn-primary"/>
                    <button name="action_approve_complaints" string="Complaints" type="object"
                            invisible="state != 'payment_approved'" class="btn-primary"/>
                    <button name="action_under_process" string="Under Process" type="object"
                            invisible="state != 'complaints_approved'" class="btn-primary"/>
                    <button name="action_completed" string="Completed Application" type="object"
                            invisible="state != 'under_process'" class="btn-success"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="license_type"/>
                            <field name="partner_id"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="total_amount"/>
                        </group>
                        <group string="Status">
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Application Details">
                            <group>
                                <group string="Company">
                                    <field name="company_name"/>
                                </group>
                                <group string="Manager">
                                    <field name="manager_name"/>
                                    <field name="manager_first_name"/>
                                    <field name="manager_last_name"/>
                                    <field name="manager_dob"/>
                                </group>
                            </group>
                            <group string="Remarks">
                                <field name="step1_remarks" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Media License Activities">
                            <group>
                                <group>
                                    <field name="num_activities"/>
                                </group>
                            </group>
                            <group string="Activities">
                                <group>
                                    <field name="activity_1"/>
                                    <field name="activity_2"/>
                                    <field name="activity_3"/>
                                    <field name="activity_4"/>
                                    <field name="activity_5"/>
                                </group>
                            </group>
                            <group string="Business Plan">
                                <field name="business_plan" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Shareholder Details">
                            <group>
                                <group>
                                    <field name="shareholder_name"/>
                                    <field name="shareholder_uae_resident"/>
                                </group>
                            </group>
                            <separator string="Documents"/>
                            <group>
                                <group string="MRO Requisition Form">
                                    <field name="doc_mro_form" widget="binary" filename="doc_mro_form_name"/>
                                    <field name="doc_mro_form_name" readonly="1"/>
                                </group>
                                <group string="Photo">
                                    <field name="doc_photo" widget="binary" filename="doc_photo_name"/>
                                    <field name="doc_photo_name" readonly="1"/>
                                </group>
                                <group string="Emirates ID">
                                    <field name="doc_emirates_id" widget="binary" filename="doc_emirates_id_name"/>
                                    <field name="doc_emirates_id_name" readonly="1"/>
                                </group>
                                <group string="Power of Attorney">
                                    <field name="doc_power_of_attorney" widget="binary" filename="doc_power_of_attorney_name"/>
                                    <field name="doc_power_of_attorney_name" readonly="1"/>
                                </group>
                                <group string="Request Form">
                                    <field name="doc_request_form" widget="binary" filename="doc_request_form_name"/>
                                    <field name="doc_request_form_name" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Declaration and Remarks">
                            <group>
                                <group>
                                    <field name="declaration_accepted"/>
                                </group>
                            </group>
                            <group string="Additional Remarks">
                                <field name="additional_remarks" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spc_nma_media_license_search" model="ir.ui.view">
        <field name="name">spc.nma.media.license.search</field>
        <field name="model">spc.nma.media.license</field>
        <field name="arch" type="xml">
            <search string="NMA Media License">
                <field name="name" string="Reference"/>
                <field name="company_name"/>
                <field name="partner_id"/>
                <filter string="New" name="type_new" domain="[('license_type','=','new')]"/>
                <filter string="Renewal" name="type_renewal" domain="[('license_type','=','renewal')]"/>
                <filter string="Amend" name="type_amend" domain="[('license_type','=','amend')]"/>
                <filter string="Cancellation" name="type_cancel" domain="[('license_type','=','cancellation')]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="state_approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="License Type" name="group_type" context="{'group_by':'license_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spc_nma_media_license" model="ir.actions.act_window">
        <field name="name">NMA Media License</field>
        <field name="res_model">spc.nma.media.license</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No NMA Media License applications yet</p>
        </field>
    </record>

    <!-- Filtered actions by license type -->
    <record id="action_spc_nma_ml_new" model="ir.actions.act_window">
        <field name="name">NMA Media License - New</field>
        <field name="res_model">spc.nma.media.license</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('license_type','=','new')]</field>
        <field name="context">{'default_license_type': 'new'}</field>
    </record>
    <record id="action_spc_nma_ml_renewal" model="ir.actions.act_window">
        <field name="name">NMA Media License - Renewal</field>
        <field name="res_model">spc.nma.media.license</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('license_type','=','renewal')]</field>
        <field name="context">{'default_license_type': 'renewal'}</field>
    </record>
    <record id="action_spc_nma_ml_amend" model="ir.actions.act_window">
        <field name="name">NMA Media License - Amend</field>
        <field name="res_model">spc.nma.media.license</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('license_type','=','amend')]</field>
        <field name="context">{'default_license_type': 'amend'}</field>
    </record>
    <record id="action_spc_nma_ml_cancel" model="ir.actions.act_window">
        <field name="name">NMA Media License - Cancellation</field>
        <field name="res_model">spc.nma.media.license</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('license_type','=','cancellation')]</field>
        <field name="context">{'default_license_type': 'cancellation'}</field>
    </record>

    <!-- Under Applications menu (same as PA) -->
    <menuitem id="menu_spc_nma_media_license"
              name="NMA Media License"
              parent="menu_spc_applications"
              action="action_spc_nma_media_license"
              sequence="40"/>

    <!-- Under Company Management menu -->
    <menuitem id="menu_spc_nma_ml_cm_parent"
              name="NMA Media License"
              parent="menu_spc_company_management"
              sequence="70"/>
    <menuitem id="menu_spc_nma_ml_cm_new"
              name="NMA Media License New"
              parent="menu_spc_nma_ml_cm_parent"
              action="action_spc_nma_ml_new"
              sequence="10"/>
    <menuitem id="menu_spc_nma_ml_cm_renewal"
              name="NMA Media License Renewal"
              parent="menu_spc_nma_ml_cm_parent"
              action="action_spc_nma_ml_renewal"
              sequence="20"/>
    <menuitem id="menu_spc_nma_ml_cm_amend"
              name="NMA Media License Amend"
              parent="menu_spc_nma_ml_cm_parent"
              action="action_spc_nma_ml_amend"
              sequence="30"/>
    <menuitem id="menu_spc_nma_ml_cm_cancel"
              name="NMA Media License Cancellation"
              parent="menu_spc_nma_ml_cm_parent"
              action="action_spc_nma_ml_cancel"
              sequence="40"/>

</data>
</odoo>
