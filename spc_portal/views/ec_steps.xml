<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-top">
        <div class="logo-box">K</div>
        <div><div class="logo-name">SPC</div><div class="logo-sub">Free Zone</div></div>
    </div>
    <div class="progress-label">Your progress</div>
    <t t-foreach="steps" t-as="s">
        <t t-set="idx" t-value="s_index + 1"/>
        <div t-attf-class="progress-step #{idx == current_step and 'active' or idx &lt; current_step and 'done' or ''}">
            <div class="step-num" style="width:30px;height:30px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0">
                <t t-if="idx &lt; current_step">&#10003;</t><t t-else=""><t t-esc="idx"/></t>
            </div>
            <div class="step-text"><t t-esc="s"/></div>
        </div>
    </t>
    <div class="total-section">
        <div style="font-size:11px;opacity:.5">Total AED</div>
        <div class="total-amount">650.00</div>
    </div>
</div>
<div class="main">
    <div class="page-title"><t t-esc="page_title"/></div>
    <form method="post" t-att-action="form_action">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="form-card">
            <div class="sec-num">01</div>
            <div class="sec-title">Declaration:</div>
            <p class="desc-text">By clicking below, I hereby agree and acknowledge my responsibility to remain in compliance, at all times, with all applicable undertakings and declarations, as may be required by SPC. I further reaffirm my acceptance of <a href="#" style="color:#1abc9c">SPC Terms and Conditions</a> and the laws of the United Arab Emirates.</p>
            <p class="desc-text">Neither SPC nor its affiliates shall assume liability for any actual or purported failure to comply with applicable laws and regulations, whether by the company's ultimate beneficial owner(s), manager(s), agents or otherwise.</p>
            <div style="font-size:14px;font-weight:600;margin-bottom:10px">Acknowledgement</div>
            <div class="ack-wrap">
                <input type="checkbox" name="declaration" id="decl_check" required="required"/>
                <label for="decl_check" style="font-weight:600">I have read and agree to the SPC Terms and Conditions.</label>
            </div>
        </div>
        <div class="nav-bar">
            <a href="#" onclick="history.back();return false;" class="btn-prev">PREVIOUS</a>
            <button type="button" class="btn-next" onclick="ecDeclValidate()">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function ecDeclValidate(){
  var cb=document.querySelector('[name="declaration"]');
  if(!cb||!cb.checked){
    if(!document.getElementById("ec_decl_err")){var e=document.createElement("div");e.id="ec_decl_err";e.style.cssText="color:red;font-size:12px;margin-top:8px";cb.parentElement.insertAdjacentElement("afterend",e);}
    document.getElementById("ec_decl_err").textContent="Please accept the declaration to continue.";
    document.getElementById("ec_decl_err").style.display="block";
    return;
  }
  var el=document.getElementById("ec_decl_err");if(el)el.style.display="none";
  document.querySelector("form").submit();
}
</script>
</body>
</html>
</template>

