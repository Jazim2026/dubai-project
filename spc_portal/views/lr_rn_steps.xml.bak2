<!-- RA Visa Allocation -->
<template id="template_ra_visa" name="RA Visa Allocation">
<html><head><meta charset="utf-8"/><title>Visa Allocation | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num"><t t-if="snum &lt; current_step">&#10003;</t><t t-else=""><t t-esc="snum"/></t></div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" t-att-action="form_submit_url">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Visa allocation upgrade / downgrade</div>
                <div class="sec-sub" style="font-size:13px;color:#888;margin-bottom:16px">Select the number of visas required</div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px" id="visaGrid">
                    <t t-foreach="range(1, 11)" t-as="n">
                        <button type="button" t-attf-class="num-btn #{n == 1 and 'active' or ''}" t-att-onclick="'selectVisa(' + str(n) + ',this)'"><t t-esc="n"/></button>
                    </t>
                </div>
                <input type="hidden" name="visa_count" id="visa_count_val" value="1"/>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function selectVisa(n,btn){
    document.querySelectorAll('.num-btn').forEach(function(b){b.classList.remove('active')});
    btn.classList.add('active');
    document.getElementById('visa_count_val').value=n;
}
</script>
</body></html>
</template>

<!-- RA Facility Type -->
<template id="template_ra_facility" name="RA Facility Type">
<html><head><meta charset="utf-8"/><title>Facility Type | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num"><t t-if="snum &lt; current_step">&#10003;</t><t t-else=""><t t-esc="snum"/></t></div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" t-att-action="form_submit_url">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Select facility type</div>
                <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:16px">
                    <label class="fac-card selected" onclick="selectFac(this)">
                        <input type="radio" name="facility_type" value="flexi_desk" checked="checked" style="display:none"/>
                        <div class="fac-card-title">Flexi Desk</div>
                        <div class="fac-card-sub">Shared workspace</div>
                    </label>
                    <label class="fac-card" onclick="selectFac(this)">
                        <input type="radio" name="facility_type" value="executive_flexi" style="display:none"/>
                        <div class="fac-card-title">Executive Flexi Desk</div>
                        <div class="fac-card-sub">Premium shared workspace</div>
                    </label>
                    <label class="fac-card" onclick="selectFac(this)">
                        <input type="radio" name="facility_type" value="private_office" style="display:none"/>
                        <div class="fac-card-title">Private Office</div>
                        <div class="fac-card-sub">Dedicated private space</div>
                    </label>
                    <label class="fac-card" onclick="selectFac(this)">
                        <input type="radio" name="facility_type" value="virtual_office" style="display:none"/>
                        <div class="fac-card-title">Virtual Office</div>
                        <div class="fac-card-sub">Remote business address</div>
                    </label>
                </div>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function selectFac(el){
    document.querySelectorAll('.fac-card').forEach(function(c){c.classList.remove('selected')});
    el.classList.add('selected');
    el.querySelector('input[type=radio]').checked=true;
}
</script>
</body></html>
</template>

</data>
</odoo>
