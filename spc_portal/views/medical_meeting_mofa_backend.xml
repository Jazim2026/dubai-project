                            <group><field name="declaration_accepted"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spc_mofa_action" model="ir.actions.act_window">
        <field name="name">MOFA Attestation</field>
        <field name="res_model">spc.mofa</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_spc_mofa" name="MOFA Attestation" action="spc_mofa_action" parent="menu_spc_concierge_top" sequence="40"/>


