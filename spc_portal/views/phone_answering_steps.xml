    <div class="review-row"><div class="review-lbl">CONTACT PHONE</div><div class="review-val"><t t-esc="(record.contact_phone_code or '') + ' ' + (record.contact_phone or '-')"/></div></div>
    <div class="review-row"><div class="review-lbl">COUNTRY</div><div class="review-val"><t t-esc="record.country or '-'"/></div></div>
  </div>
  <div class="review-card">
    <div class="review-header">
      <div class="review-sec-title">Service Details</div>
      <a t-attf-href="/spc/concierge/phone-answering/step2/#{record.id}" class="edit-btn">&#9998; EDIT</a>
    </div>
    <div class="review-row"><div class="review-lbl">MONTHS REQUIRED</div><div class="review-val"><t t-esc="record.months_required or '-'"/></div></div>
    <div class="review-row"><div class="review-lbl">WORKING DAYS</div><div class="review-val"><t t-esc="record.working_days or '-'"/></div></div>
    <div class="review-row"><div class="review-lbl">WORKING HOURS</div><div class="review-val"><t t-esc="(record.working_hours_from or '') + ' - ' + (record.working_hours_to or '')"/></div></div>
    <div class="review-row"><div class="review-lbl">COMPANY WEBSITE</div><div class="review-val"><t t-esc="record.company_website or '-'"/></div></div>
  </div>
  <div class="review-card">
    <div class="review-header"><div class="review-sec-title">Declaration</div></div>
    <div class="review-row"><div class="review-lbl">TERMS AGREED</div><div class="review-val"><t t-esc="'Yes' if record.declaration_accepted else 'No'"/></div></div>
  </div>
  <div class="nav-btns">
    <a t-attf-href="/spc/concierge/phone-answering/declaration/#{record.id}" class="btn-prev">PREVIOUS</a>
    <a t-attf-href="/spc/concierge/phone-answering/payment/#{record.id}" class="btn-next">NEXT</a>
  </div>
</div>
</body></html>
</template>

