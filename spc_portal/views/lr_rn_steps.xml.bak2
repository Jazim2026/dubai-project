<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- Common styles -->
<template id="template_company_mgmt_service_detail" name="Company Mgmt Service Detail">
<html>
<head><meta charset="utf-8"/><title>Service Detail</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>

.package-options{display:flex;flex-direction:column;gap:10px;margin-top:12px}
.pkg-label{display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;padding:10px 14px;border:1px solid #e5e7eb;border-radius:8px}
.pkg-label:hover{border-color:#1abc9c;background:#f0fdf4}
.pkg-label input{accent-color:#1abc9c;width:16px;height:16px}
.spc-btn-previous{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
.method-option{display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;padding:8px 0}
.method-option input{accent-color:#1abc9c;width:16px;height:16px}
.submit-btn{background:#1abc9c;color:#fff;border:none;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer;margin-top:16px}
.review-title{font-size:14px;font-weight:700;color:#1a2340;margin-bottom:12px}
.review-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#9ca3af;font-weight:600;min-width:220px}

.row-expand-btn{background:none;border:1px solid #ddd;border-radius:4px;padding:2px 8px;cursor:pointer;font-size:14px;color:#1a3c6e;margin-left:8px}
.sub-items{display:none;padding:8px 0 8px 24px}
.sub-items.open{display:block}
.sub-item-label{font-size:12px;color:#888;margin-bottom:6px}
.sub-activity{display:flex;align-items:flex-start;gap:8px;font-size:13px;padding:4px 0;cursor:pointer}
.sub-activity input{width:14px;height:14px;margin-top:2px;accent-color:#1abc9c}
.division-body{display:none;padding:12px 16px;border-top:1px solid #e5e7eb}
.division-body.open{display:block}
.radio-row{display:flex;gap:16px;flex-wrap:wrap;margin-top:8px}
.radio-card{border:1.5px solid #e5e7eb;border-radius:8px;padding:12px 20px;cursor:pointer;font-size:13px;color:#374151;display:flex;align-items:center;gap:8px;transition:all .2s}
.radio-card.selected{border-color:#1abc9c;background:#f0fdf9;color:#1a2340;font-weight:600}
.legal-options{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:12px}
.legal-card{border:2px solid #eee;border-radius:12px;padding:20px;text-align:center;cursor:pointer;transition:.2s}
.legal-card:hover,.legal-card.selected{border-color:#1abc9c;background:#f0fdf4}
.legal-card-title{font-size:14px;font-weight:600;margin-top:8px}
.legal-card-sub{font-size:12px;color:#888}
.field-select{width:100%;padding:10px 14px;border:1px solid #ddd;border-radius:8px;font-size:14px;background:#fff;margin-bottom:12px}
.field-select-box{position:relative;margin-bottom:12px}
.info-box{background:#fef3c7;border-left:3px solid #f59e0b;padding:12px 16px;border-radius:6px;font-size:12px;color:#92400e;margin-top:12px}
.info-list{padding-left:16px;font-size:12px;color:#92400e;margin-top:6px}
.info-text{font-size:12px;color:#92400e}
.facility-options{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:12px}
.facility-title{font-size:14px;font-weight:600}
.facility-sub{font-size:12px;color:#888}
.facility-label{cursor:pointer;border:2px solid #eee;border-radius:12px;padding:16px;transition:.2s}
.facility-label:hover,.facility-label.selected{border-color:#1abc9c;background:#f0fdf4}
.divisions-wrap{display:flex;flex-direction:column;gap:12px;margin-top:12px}
.division-item{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden}
.division-header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;cursor:pointer;background:#fafafa}
.division-body{padding:12px 16px;border-top:1px solid #e5e7eb;display:none}
.edit-link{color:#1abc9c;font-size:13px;text-decoration:none}
.checkbox-label{display:flex;align-items:flex-start;gap:8px;font-size:13px;cursor:pointer;margin-bottom:8px}
.num-grid{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.num-btn{width:52px;height:52px;border-radius:8px;border:2px solid #e0e0e0;background:#fff;font-size:16px;font-weight:600;cursor:pointer;transition:.2s;color:#333}
.num-btn.active{background:#1a2340;color:#fff;border-color:#1a2340}
.num-btn:hover{border-color:#1abc9c}
.banner-placeholder{height:120px;background:linear-gradient(135deg,#1a2340,#2d6a9f);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:700;margin-bottom:20px}
.btn-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:8px}
.dashboard-btn{background:#1a2340;color:#fff;border:none;border-radius:8px;padding:10px 20px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block}
.empty-state{text-align:center;padding:40px 20px}
.empty-icon{font-size:48px;margin-bottom:12px}
.empty-text{font-size:16px;font-weight:600;color:#1a2340;margin-bottom:6px}
.empty-sub{font-size:13px;color:#888}
.empty-tab-msg{font-size:13px;color:#888;padding:12px 0}
.desc-section{margin-bottom:20px}
.desc-title{font-size:14px;font-weight:700;color:#1a2340;margin-bottom:6px}
.desc-text{font-size:13px;color:#555;line-height:1.7}
.div-arrow{font-size:12px;color:#aaa}
.breadcrumb{font-size:12px;color:#888;margin-bottom:16px}
.edit-btn{color:#1abc9c;background:none;border:none;cursor:pointer;font-size:13px;text-decoration:underline}
.toggle-bar{display:flex;gap:0;margin-bottom:16px;max-width:400px}
.toggle-btn{flex:1;padding:10px 16px;border:1px solid #ddd;background:#fff;font-size:13px;font-weight:600;cursor:pointer;color:#555}
.toggle-btn:first-child{border-radius:8px 0 0 8px}
.toggle-btn:last-child{border-radius:0 8px 8px 0}
.toggle-btn.active{background:#1a2340;color:#fff;border-color:#1a2340}
.toggle-btn.inactive{background:#fff;color:#555;border-color:#ddd}
.upload-area{border:2px dashed #1abc9c;border-radius:10px;padding:24px 16px;text-align:center;cursor:pointer;background:#fff;max-width:220px;margin-bottom:12px}
.upload-area input[type=file]{display:none}
.upload-icon{font-size:28px;color:#1abc9c;margin-bottom:6px}
.upload-label{font-size:13px;color:#1abc9c;font-weight:600}
.ack-box{background:#f8f9fa;border-radius:10px;padding:16px;margin-top:12px}
.info-list{padding-left:18px;font-size:12px;color:#555;line-height:2;margin-top:8px}
.info-list li{margin-bottom:4px}
.resolution-notes{background:#fff0f5;border:1px solid #ffb3cc;border-radius:8px;padding:12px 16px;margin-top:12px;font-size:13px;color:#555}

</style>

</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
</div>
<div class="main">
<a href="/spc/company-management" class="back-link">&#8592; BACK TO COMPANY MANAGEMENT</a>
<div class="page-header">
    <div class="page-title"><t t-esc="service.get('name', '')"/></div>
    <t t-if="service_type == 'license_reissue'">
        <a href="/spc/company-management/apply/lr-step1/license_reissue" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'renewal'">
        <a href="/spc/company-management/apply/rn-step1/renewal" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'renewal_amendment'">
        <a href="/spc/company-management/apply/ra-step1/renewal_amendment" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'amendment'">
        <a href="/spc/company-management/apply/amd-step1/amendment" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'visa_allocation_amendment'">
        <a href="/spc/company-management/apply/va-step1/visa_allocation_amendment" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'certify'">
        <a href="/spc/company-management/apply/certify-step1/certify" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'ec_new'">
        <a href="/spc/company-management/apply/ec-new-step1/ec_new" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'ec_renewal'">
        <a href="/spc/company-management/apply/ec-renewal-company/ec_renewal" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'ec_amendment'">
        <a href="/spc/company-management/apply/ec-amd-company/ec_amendment" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
    <t t-elif="service_type == 'ec_cancellation'">
        <a href="/spc/company-management/apply/ec-cancel-company/ec_cancellation" class="start-btn" style="background:#1a2340;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block">START PROCESS</a>
    </t>
</div>
<div class="hero-banner" t-att-style="service.get('banner_style', 'background:linear-gradient(135deg,#1a2340,#2d6a4f);')">
    <t t-if="service.get('banner_html')">
        <t t-out="service.get('banner_html', '')"/>
    </t>
    <t t-else="">
        <t t-esc="service.get('description', '')"/>
    </t>
</div>
<div class="detail-card">
<div class="desc-section">
    <h4 style="font-weight:700;margin-bottom:8px">Description</h4>
    <t t-if="service.get('desc_html')">
        <t t-out="service.get('desc_html', '')"/>
    </t>
    <t t-elif="service_type == 'license_reissue'">
        <div class="desc-text">License Reissue allows existing companies to reissue their trade license. This process requires IDN details, legal type selection, and business activity confirmation.</div>
    </t>
    <t t-elif="service_type == 'visa_allocation_amendment'">
        <div class="desc-text">
            <p>The Visa allocation amendment process changes the current visa allocation of count of employees it can sponsor residency visa for.</p>
            <br/><strong>Timeline</strong><p style="margin-top:4px">1-2 days</p>
            <br/><strong>Price Per Visa</strong><p style="margin-top:4px">AED 1,600</p>
        </div>
    </t>
    <t t-elif="service_type == 'certify'">
        <t t-if="service.get('desc_html')">
            <t t-out="service.get('desc_html', '')"/>
        </t>
    </t>
    <t t-elif="service_type in ['ec_new','ec_renewal','ec_amendment','ec_cancellation']">
        <t t-if="service.get('desc_html')">
            <t t-out="service.get('desc_html', '')"/>
        </t>
    </t>
    <t t-elif="service_type in ['ec_new','ec_renewal','ec_amendment','ec_cancellation']">
        <t t-if="service.get('desc_html')">
            <t t-out="service.get('desc_html', '')"/>
        </t>
    </t>
    <t t-elif="service_type == 'renewal'">
        <div class="desc-text">
            <p>Upon the expiry of a valid Trade License, a company wishing to continue running its business is required to renew their Trade License.</p>
            <br/><strong>Requirements</strong>
            <ol style="margin-left:20px;margin-top:8px">
                <li>Renewal Form</li><li>Authorized Signatory Form (if applicable)</li>
                <li>Authorization Form (if applicable)</li><li>Pre-Approval (if applicable)</li>
                <li>Passport Copies of all Managers (if expired)</li>
                <li>UAE visa copy or UAE entry stamp copy Managers (if applicable)</li>
                <li>Payment</li>
            </ol>
            <br/><strong>Timeline</strong><p style="margin-top:4px">1 to 2 business days</p>
            <br/><strong>Fees</strong><p style="margin-top:4px">As per package</p>
        </div>
    </t>

</div>
</div>
</div>
</div>
</body>
</html>
</template>

<!-- LR Step 1: IDN Details -->
<template id="template_lr_step1" name="LR Step1 IDN Details">
<html>
<head><meta charset="utf-8"/><title>IDN Details | License Reissue</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>

</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step active"><div class="step-num">1</div><div class="step-label">IDN details</div></div>
        <div class="progress-step"><div class="step-num">2</div><div class="step-label">Legal type</div></div>
        <div class="progress-step"><div class="step-num">3</div><div class="step-label">Business activities</div></div>
        <div class="progress-step"><div class="step-num">4</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">5</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">0.00</div></div>
        <div class="sidebar-links">
            <a href="#">SAVE &amp; CONTINUE LATER</a>
            <a href="#">CANCEL APPLICATION</a>
        </div>
    </div>
    <div class="main">
        <div class="form-title">License Reissue</div>
        <form action="/spc/company-management/apply/lr-step1/submit" method="post" id="lrStep1Form">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" value="license_reissue"/>
            <div class="spc-section">
                <div class="sec-row">
                    <div class="sec-num">01</div>
                    <div class="sec-body">
                        <select class="field-select" name="idn_company_id" id="idnSelect" onchange="updateIdnText(this)">
                            <option value="">IDN number</option>
                            <t t-foreach="companies" t-as="company">
                                <option t-att-value="company['id']" t-att-data-name="company['name']"><t t-esc="company['name']"/></option>
                            </t>
                        </select>
                        <input type="text" class="field-input" name="idn_number" id="idnText" placeholder="Or enter IDN number manually"/>
                    </div>
                </div>
            </div>
            <div class="spc-nav-buttons">
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
<script>
function updateIdnText(sel) {
    var opt = sel.options[sel.selectedIndex];
    if (opt.value) {
        document.getElementById('idnText').value = opt.getAttribute('data-name') || opt.value;
    }
}
</script>
</body>
</html>
</template>

<!-- LR Step 2: Legal Type -->
<template id="template_lr_step2" name="LR Step2 Legal Type">
<html>
<head><meta charset="utf-8"/><title>Legal Type | License Reissue</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;color:#333}
.layout{display:flex;min-height:100vh}
.sidebar{width:260px;background:#1a2340;color:#fff;padding:32px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto}
.sidebar-logo{font-size:18px;font-weight:700;margin-bottom:8px}
.sidebar-logo span{display:block;font-size:11px;font-weight:400;opacity:.6}
.progress-title{font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:16px;margin-top:24px}
.progress-step{display:flex;align-items:center;gap:10px;margin-bottom:12px;opacity:.5}
.progress-step.active{opacity:1}.progress-step.done{opacity:.8}
.step-num{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.progress-step.active .step-num{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-num{background:#fff;color:#1a2340;border-color:#fff}
.step-label{font-size:13px}
.total-box{margin-top:24px;font-size:12px;opacity:.7}
.total-box .amount{font-size:20px;font-weight:700;opacity:1;color:#fff}
.main{margin-left:260px;padding:40px 48px;min-height:100vh}
.form-title{font-size:26px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.spc-section{background:#fff;border-radius:12px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:24px}
.sec-title{font-size:15px;font-weight:700;color:#1a2340;margin-bottom:16px}
.legal-options{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:12px}
.legal-card{border:2px solid #eee;border-radius:12px;padding:20px;cursor:pointer;transition:.2s}
.legal-card:hover,.legal-card.selected{border-color:#1abc9c;background:#f0fdf4}
.legal-card input[type=radio]{display:none}
.legal-card-title{font-size:14px;font-weight:600;margin-bottom:4px}
.legal-card-sub{font-size:12px;color:#888}
.package-options{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.pkg-label{display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;padding:10px 14px;border:1px solid #e5e7eb;border-radius:8px}
.pkg-label:hover{border-color:#1abc9c;background:#f0fdf4}
.pkg-label input{accent-color:#1abc9c;width:16px;height:16px}
.info-box{background:#fef3c7;border-left:3px solid #f59e0b;padding:12px 16px;border-radius:6px;font-size:12px;color:#92400e;margin-top:12px}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:32px}
.spc-btn-previous{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
.spc-btn-next{background:#1abc9c;color:#fff;border:none;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">IDN details</div></div>
        <div class="progress-step active"><div class="step-num">2</div><div class="step-label">Legal type</div></div>
        <div class="progress-step"><div class="step-num">3</div><div class="step-label">Business activities</div></div>
        <div class="progress-step"><div class="step-num">4</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">5</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">0.00</div></div>
    </div>
    <div class="main">
        <div class="form-title">License Reissue</div>
        <form action="/spc/company-management/apply/lr-step2/submit" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" value="license_reissue"/>
            <div class="spc-section">
                <div class="sec-title">01 Select the legal type</div>
                <div class="legal-options">
                    <label class="legal-card selected" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="fze" checked="checked" style="display:none"/>
                        <div class="legal-card-title">Free Zone Establishment</div>
                        <div class="legal-card-sub">1 Shareholder (Limited Liability Company)</div>
                    </label>
                    <label class="legal-card" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="fzc"/>
                        <div class="legal-card-title">Free Zone Company</div>
                        <div class="legal-card-sub">Multiple shareholders (Limited Liability Company)</div>
                    </label>
                    <label class="legal-card" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="branch"/>
                        <div class="legal-card-title">Branch</div>
                    </label>
                </div>
            </div>
            <div class="spc-section">
                <div class="sec-title">02 Select package type</div>
                <div class="package-options">
                    <label class="pkg-label"><input type="radio" name="package_type" value="Standard" checked="checked"/> Standard</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Publishing"/> Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="E-Publishing"/> E-Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - Publishing"/> Instant License - Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - E-Publishing"/> Instant License - E-Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="SIBF 2024 SIBF Clients only"/> SIBF 2024 SIBF Clients only</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - Standard"/> Instant License - Standard</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Publishing (Old package)"/> Publishing (Old package)</label>
                </div>
                <div class="info-box">For more details on our business setup packages, click <a href="#">here</a></div>
            </div>
            <div class="spc-nav-buttons">
                <button type="button" class="spc-btn-previous" onclick="window.history.back()">PREVIOUS</button>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
<script>
function selectCard(el) {
    document.querySelectorAll('.legal-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    el.querySelector('input[type=radio]').checked = true;
}
</script>
</body>
</html>
</template>

<!-- LR Step 4: Review -->
<template id="template_lr_step4" name="LR Step4 Review">
<html>
<head><meta charset="utf-8"/><title>Review | License Reissue</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>

</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">IDN details</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Legal type</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Business activities</div></div>
        <div class="progress-step active"><div class="step-num">4</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">5</div><div class="step-label">Payment</div></div>
    </div>
    <div class="main">
        <div class="form-title">License Reissue</div>
        <div class="review-card">
            <div class="review-title">IDN Details</div>
            <div class="review-row"><span class="review-label">IDN Number</span><span class="review-val"><t t-esc="step1.get('idn_number', '-')"/></span></div>
        </div>
        <div class="review-card">
            <div class="review-title">Legal Type</div>
            <div class="review-row"><span class="review-label">Legal Type</span><span class="review-val"><t t-esc="step2.get('legal_type', '-')"/></span></div>
            <div class="review-row"><span class="review-label">Package Type</span><span class="review-val"><t t-esc="step2.get('package_type', '-')"/></span></div>
        </div>
        <div class="review-card">
            <div class="review-title">Business Activities</div>
            <t t-if="step3.get('activity_names')">
                <t t-foreach="step3.get('activity_names', [])" t-as="act">
                    <div class="review-row"><span class="review-val"><t t-esc="act"/></span></div>
                </t>
            </t>
            <t t-else=""><div class="review-row"><span class="review-val">-</span></div></t>
        </div>
        <form action="/spc/company-management/apply/lr-step4/submit" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" value="license_reissue"/>
            <div class="spc-nav-buttons">
                <button type="button" class="spc-btn-previous" onclick="window.history.back()">PREVIOUS</button>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
</template>

