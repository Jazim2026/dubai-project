<!-- NR Step 2: Company Name -->
<template id="template_nr_step2" name="NR Step2 Company Name">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Company Name | SPC Free Zone</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>

.sidebar{width:280px;background:#1a3c6e;color:white;padding:32px 24px;position:fixed;top:0;left:0;bottom:0;overflow-y:auto}
.progress-logo{font-size:20px;font-weight:700;margin-bottom:4px}
.ps-diamond{color:#1abc9c}
.ps-subtitle{font-size:12px;opacity:.6;margin-bottom:32px}
.progress-step-num{width:36px;height:36px;border-radius:50%;border:2px solid rgba(255,255,255,.3) !important;background:transparent !important;color:white !important;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;position:relative}
.progress-step-num.active::after{content:'';position:absolute;width:44px;height:44px;border-radius:50%;border:2px solid rgba(26,188,156,.4);top:-4px;left:-4px}
.progress-step-num.active{background:#1abc9c;border-color:#1abc9c}
.progress-step-num.done{background:white;border-color:white;color:#1a2340}
.progress-step-label{font-size:13px;opacity:.6;font-weight:500;padding-top:4px}
.progress-step-label.active{opacity:1;font-weight:700;font-size:14px}
.progress-total{margin-top:32px;padding-top:24px;border-top:1px solid rgba(255,255,255,.15)}
.progress-total-label{font-size:11px;opacity:.6;margin-bottom:4px}
.progress-total-val{font-size:22px;font-weight:700}
.progress-save{display:block;color:rgba(255,255,255,.6);font-size:12px;text-decoration:none;margin-top:12px;background:none;border:none;cursor:pointer;padding:0;text-align:left}
.ps-link:hover{color:white}
.progress-step{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.progress-title{font-size:11px;opacity:.6;text-transform:uppercase;letter-spacing:1px;margin-bottom:20px}
.declaration-box{background:#f8f9fa;border-radius:10px;padding:20px;font-size:13px;color:#374151;line-height:1.8;margin-bottom:16px}
.note-box{background:#fff8e1;border-left:3px solid #f59e0b;padding:12px 16px;border-radius:6px;margin-top:12px}
.note-icon{font-size:16px}
.note-info{font-size:12px;color:#92400e}
.fee-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f3f4f6;font-size:14px}
.fee-label{color:#555}
.fee-value{font-weight:600;color:#1a2340}
.payment-card{background:#fff;border-radius:12px;padding:24px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:16px}
.payment-title{font-size:15px;font-weight:700;color:#1a2340;margin-bottom:16px}
.pay-methods{display:flex;flex-direction:column;gap:4px}
.pay-method-title{font-size:13px;font-weight:600;color:#1a2340;margin-bottom:8px}
.pay-option{display:flex;align-items:center;gap:10px;padding:10px 0;font-size:14px;border-bottom:1px solid #f0f0f0;cursor:pointer}
.pay-option:last-child{border-bottom:none}
.pay-option-label{font-size:14px;color:#374151}
.hero{background:linear-gradient(135deg,#1a2340,#2d6a9f);border-radius:12px;padding:28px;color:#fff;margin-bottom:24px}
.hero-badge{background:#1abc9c;color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:4px;margin-bottom:10px;display:inline-block}
.hero-title{font-size:22px;font-weight:700}
.back-link{color:#1abc9c;font-size:13px;text-decoration:none;display:inline-block;margin-bottom:16px}
.page-title{font-size:22px;font-weight:700;color:#1a2340;margin-bottom:20px}
.content{max-width:700px}
.header{margin-bottom:24px}
.divider{height:1px;background:#e5e7eb;margin:16px 0}
.nr-service-detail{font-size:13px;color:#555;line-height:1.8}
</style>
    
</head>
<body>
<div style="display:flex;min-height:100vh">
    <div class="sidebar">
        <div class="progress-logo"><span class="ps-diamond">&#9670;</span> K SPC</div>
        <div class="ps-subtitle">Free Zone</div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step"><div class="progress-step-num done">&#10003;</div><div class="progress-step-label">Business activities</div></div>
        <div class="progress-step"><div class="progress-step-num active">2</div><div class="progress-step-label">Company name</div></div>
        <div class="progress-step"><div class="progress-step-num">3</div><div class="progress-step-label">Declaration</div></div>
        <div class="progress-step"><div class="progress-step-num">4</div><div class="progress-step-label">Review application</div></div>
        <div class="progress-step"><div class="progress-step-num">5</div><div class="progress-step-label">Payment</div></div>
        <div class="progress-total"><div class="progress-total-label">Total AED</div><div class="progress-total-val">510.00 &#9432;</div></div>
        <a href="/spc/setup-new-company" class="progress-save">SAVE &amp; EXIT</a>
        <button class="progress-save" style="color:#f87171">CANCEL APPLICATION</button>
    </div>
    <div class="main">
        <div class="form-title">Name Reservation - New</div>
        <form action="/spc/setup-new-company/apply/nr-step2/submit" method="post" id="nrStep2Form">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" t-att-value="service_type"/>

            <!-- Name Reserved? -->
            <div class="section-block">
                <div class="sec-num">01</div>
                <div class="sec-body">
                    <div class="sec-title">Has a company name been reserved?</div>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="name_reserved" value="yes" onchange="toggleReserved('yes')"/> Yes</label>
                        <label class="radio-label"><input type="radio" name="name_reserved" value="no" checked="checked" onchange="toggleReserved('no')"/> No</label>
                    </div>
                    <div id="reserved_section" style="display:none;margin-top:16px">
                        <input type="text" class="field-input" name="reserved_name" placeholder="Reserved name"/>
                    </div>
                </div>
            </div>

            <!-- Proposed Names -->
            <div class="spc-section" id="proposed_section">
                <div class="sec-num">02</div>
                <div class="sec-body">
                    <div class="sec-title">Enter the proposed company name(s) in order of preference</div>
                    <input type="text" class="field-input" name="name_preference_1" placeholder="First preference"/>
                    <input type="text" class="field-input" name="name_preference_2" placeholder="Second preference"/>
                    <input type="text" class="field-input" name="name_preference_3" placeholder="Third preference"/>
                    <div class="note-box">
                        <p><strong>Please note:</strong></p>
                        <p>1. Company Names will appear as entered (same letter case) at the time of application.</p>
                        <p style="color:#c0392b;margin-top:10px;"><strong>The following words cannot be used as company names:</strong></p>
                        <div class="note-info">
                            <span class="note-icon">&#9432;</span>
                            <div>
                                <p>1. Sharjah, Dubai, Abu Dhabi, RAK, Ras Al Khaimah, Ajman, Fujairah, Umm Al Quwain, UAE, United Arab Emirates, Limited, LTD, Financial, CAT, Elite, Vehicles &amp; Hotels, Islam, Islamic, Bomb, Import, Export, Manufacturing, Shipping, Forwarding, Oil, Gas and Refinery.</p>
                                <p>2. Any animal names cannot be used.</p>
                                <p>3. Any words related to any religion cannot be used.</p>
                                <p>4. Any names indicating direct product such as food, beverages, Cars and Auto cannot be used.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Arabic Translation -->
            <div class="section-block">
                <div class="sec-num">03</div>
                <div class="sec-body">
                    <div class="sec-title">Select the method of translating the company name into Arabic</div>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="direct"/> Direct translation</label>
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="phonetic"/> Phonetic sound</label>
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="own"/> I will provide my own translations</label>
                    </div>
                </div>
            </div>

            <!-- Applicant Details -->
            <div style="background:#fff;border-radius:12px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:24px">
                <div style="font-size:16px;font-weight:700;color:#1a2340;margin-bottom:16px">02 &#160; Applicant's details</div>
                <input type="text" class="field-input" name="applicant_first_name" placeholder="Applicant first name"/>
                <input type="text" class="field-input" name="applicant_last_name" placeholder="Applicant last name"/>
                <input type="text" class="field-input" name="applicant_arabic_name" placeholder="الاسم الكامل بالعربي" dir="rtl" lang="ar" style="font-family:Arial,sans-serif;text-align:right;"/>
                <div style="margin-bottom:16px">
                    <div style="font-size:13px;font-weight:600;color:#374151;margin-bottom:8px">Applicant's passport copy</div>
                    <label style="border:2px dashed #1abc9c;border-radius:8px;padding:20px;text-align:center;cursor:pointer;display:inline-block;min-width:200px">
                        <input type="file" name="applicant_passport" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                        <div style="font-size:22px;color:#1a6fa8">&#11014;</div>
                        <div style="font-size:13px;color:#1a6fa8;font-weight:500">Applicant's passport copy</div>
                    </label>
                </div>
                <div style="font-size:13px;font-weight:600;color:#374151;margin-bottom:8px">03 &#160; Select the method of translating the company name into Arabic</div>
                <div style="display:flex;gap:24px;flex-wrap:wrap;margin-bottom:16px">
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer"><input type="radio" name="arabic_translation_method" value="direct"/> Direct translation</label>
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer"><input type="radio" name="arabic_translation_method" value="phonetic"/> Phonetic sound</label>
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer"><input type="radio" name="arabic_translation_method" value="own"/> I will provide my own translations</label>
                </div>
                <div style="font-size:13px;font-weight:600;color:#374151;margin-bottom:8px">04 &#160; Enter number of shareholders that will be associated with the company</div>
                <input type="number" class="field-input" name="nr_shareholder_count" value="1" min="1" style="max-width:300px"/>
            </div>

            <div class="spc-nav-buttons">
                <a t-att-href="'/spc/setup-new-company/apply/' + service_type" class="spc-btn-previous">PREVIOUS</a>
                <button type="button" class="spc-btn-next" onclick="nrStep2Validate()">NEXT</button>
            </div>
        </form>
    </div>
<script>//<![CDATA[
function nrStep2Validate() {
    var valid = true;
    function showErr(id, msg) {
        var el = document.getElementById(id);
        if (!el) {
            el = document.createElement('div');
            el.id = id;
            el.style.cssText = 'color:#ef4444;font-size:12px;margin-top:4px;';
        }
        el.textContent = msg;
        el.style.display = 'block';
        return el;
    }
    function hideErr(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    }
    function insertErr(field, id) {
        if (field && !document.getElementById(id)) {
            var el = document.createElement('div');
            el.id = id;
            el.style.cssText = 'color:#ef4444;font-size:12px;margin-top:4px;';
            field.insertAdjacentElement('afterend', el);
        }
    }

    // Name preference 1 (required, min 3, max 50)
    var nameReserved = document.querySelector('[name="name_reserved"]:checked');
    if (!nameReserved || nameReserved.value === 'no') {
        var p1 = document.querySelector('[name="name_preference_1"]');
        insertErr(p1, 'nr_p1_err');
        if (!p1 || !p1.value.trim()) {
            showErr('nr_p1_err', 'First preference is required.');
            valid = false;
        } else if (p1.value.trim().length < 3) {
            showErr('nr_p1_err', 'Minimum 3 characters required.');
            valid = false;
        } else if (p1.value.trim().length > 50) {
            showErr('nr_p1_err', 'Maximum 50 characters allowed.');
            valid = false;
        } else { hideErr('nr_p1_err'); }

        // Name preference 2 (optional but if filled, min 3 max 50)
        var p2 = document.querySelector('[name="name_preference_2"]');
        insertErr(p2, 'nr_p2_err');
        if (p2 && p2.value.trim() && p2.value.trim().length < 3) {
            showErr('nr_p2_err', 'Minimum 3 characters required.');
            valid = false;
        } else if (p2 && p2.value.trim().length > 50) {
            showErr('nr_p2_err', 'Maximum 50 characters allowed.');
            valid = false;
        } else { hideErr('nr_p2_err'); }

        // Name preference 3 (optional but if filled, min 3 max 50)
        var p3 = document.querySelector('[name="name_preference_3"]');
        insertErr(p3, 'nr_p3_err');
        if (p3 && p3.value.trim() && p3.value.trim().length < 3) {
            showErr('nr_p3_err', 'Minimum 3 characters required.');
            valid = false;
        } else if (p3 && p3.value.trim().length > 50) {
            showErr('nr_p3_err', 'Maximum 50 characters allowed.');
            valid = false;
        } else { hideErr('nr_p3_err'); }
    }

    // Applicant first name (min 3, max 50)
    var fn = document.querySelector('[name="applicant_first_name"]');
    insertErr(fn, 'nr_fn_err');
    if (!fn || !fn.value.trim()) {
        showErr('nr_fn_err', 'Applicant name is required.');
        valid = false;
    } else if (fn.value.trim().length < 3) {
        showErr('nr_fn_err', 'Minimum 3 characters required.');
        valid = false;
    } else if (fn.value.trim().length > 50) {
        showErr('nr_fn_err', 'Maximum 50 characters allowed.');
        valid = false;
    } else { hideErr('nr_fn_err'); }

    // Applicant last name (min 3, max 50)
    var ln = document.querySelector('[name="applicant_last_name"]');
    insertErr(ln, 'nr_ln_err');
    if (!ln || !ln.value.trim()) {
        showErr('nr_ln_err', 'Applicant last name is required.');
        valid = false;
    } else if (ln.value.trim().length < 3) {
        showErr('nr_ln_err', 'Minimum 3 characters required.');
        valid = false;
    } else if (ln.value.trim().length > 50) {
        showErr('nr_ln_err', 'Maximum 50 characters allowed.');
        valid = false;
    } else { hideErr('nr_ln_err'); }

    // Passport upload validation
    var passport = document.querySelector('[name="applicant_passport"]');
    insertErr(passport ? passport.closest('label') : null, 'nr_passport_err');
    if (!passport || !passport.files || passport.files.length === 0) {
        showErr('nr_passport_err', 'Applicant passport copy is required.');
        valid = false;
    } else {
        var allowed = ['pdf','jpg','jpeg','png'];
        var fname = passport.files[0].name.toLowerCase();
        var ext = fname.split('.').pop();
        if (!allowed.includes(ext)) {
            showErr('nr_passport_err', 'Only PDF, JPG, JPEG, PNG allowed.');
            valid = false;
        } else { hideErr('nr_passport_err'); }
    }

    if (valid) document.getElementById('nrStep2Form').submit();
}
]]></script>
</div>
<script>//<![CDATA[
function toggleReserved(val) {
    document.getElementById('reserved_section').style.display = val === 'yes' ? 'block' : 'none';
    document.getElementById('proposed_section').style.display = val === 'yes' ? 'none' : 'flex';
}
//]]>
</script>
</body>
</html>
</template>

