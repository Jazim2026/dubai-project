                    3 Years
                </label>
            </div>
        </div>
    </div>

    <!-- E-Channel -->
    <div class="spc-section">
        <div class="sec-row">
            <div class="sec-num" id="echannel-num">
                <t t-out="'03' if bl_data.get('establishment_card')=='yes' else '02'"/>
            </div>
            <div class="sec-body">
                <div class="sec-title">E-Channel</div>
                <div class="sec-sub">Do you want to apply E-channel with the company formation?</div>
                <div class="yn-row">
                    <div t-attf-class="yn-card #{'yn-active' if bl_data.get('e_channel')=='yes' else ''}"
