        </div>
        <form action="/spc/facility-management/final-submit" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="spc-nav-buttons">
                <a href="/spc/facility-management/step3" class="spc-btn-prev">PREVIOUS</a>
                <button type="submit" class="spc-btn-next">SUBMIT APPLICATION</button>
            </div>
        </form>
    </div>
</div>
</body></html>
</template>

