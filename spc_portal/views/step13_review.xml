<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<template id="template_setup_company_step13" name="SPC Setup Company Step13">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Review Application | SPC Free Zone</title>
    <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;color:#333}
.layout{display:flex;min-height:100vh}
.sidebar{width:260px;background:#1a2340;color:#fff;padding:32px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto}
.sidebar-logo{font-size:22px;font-weight:700;margin-bottom:32px}
.sidebar-logo span{display:block;font-size:12px;font-weight:400;opacity:.6}
.progress-title{font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:16px}
.progress-step{display:flex;align-items:center;gap:10px;margin-bottom:12px;opacity:.5}
.progress-step.active{opacity:1}
.progress-step.done{opacity:.8}
.step-num{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.progress-step.active .step-num{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-num{background:#fff;color:#1a2340;border-color:#fff}
.step-label{font-size:13px}
.main{margin-left:260px;padding:40px 48px;min-height:100vh}
.form-title{font-size:26px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.review-section{background:#fff;border-radius:12px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:20px}
.review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.review-sec-num{font-size:13px;color:#aaa;font-weight:600}
.review-sec-title{font-size:16px;font-weight:700;color:#1a2340}
.edit-btn{display:flex;align-items:center;gap:6px;color:#1a2340;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer}
.edit-icon{font-size:14px}
.review-row{display:flex;gap:40px;padding:10px 0;border-bottom:1px solid #f0f0f0}
.review-row:last-child{border-bottom:none}
.review-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#aaa;font-weight:600;min-width:260px}
.review-value{font-size:14px;color:#1a2340;font-weight:500}
.accordion-review{border:1px solid #e0e0e0;border-radius:8px;margin-bottom:10px;overflow:hidden}
.accordion-review-header{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:#fafafa;font-weight:600;font-size:14px;cursor:pointer}
.accordion-review-body{display:none;padding:16px 18px;background:#fff}
.accordion-review-body.open{display:block}
.share-table{width:100%;border-collapse:collapse;margin-top:12px}
.share-table th{font-size:11px;text-transform:uppercase;color:#aaa;font-weight:600;text-align:left;padding:8px 12px;border-bottom:2px solid #e0e0e0}
.share-table td{font-size:14px;color:#333;padding:10px 12px;border-bottom:1px solid #f0f0f0}
.share-table tr:last-child td{border-bottom:none;font-weight:700;color:#1a2340}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:16px}
.spc-btn-previous{border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:14px;font-weight:700;color:#1a2340;text-decoration:none}
.spc-btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:12px 48px;font-size:15px;font-weight:700;cursor:pointer}
    </style>
</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">K SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Legal type</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Business activities</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Company</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Facility</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Visa allocation</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Shareholder(s) information and Capital Structure</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Manager(s) information</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Director(s) information</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">UBO information</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Nature of business</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Corporate bank account</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Supporting document</div></div>
        <div class="progress-step active"><div class="step-num">13</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">14</div><div class="step-label">Payment</div></div>
    </div>

    <div class="main">
        <div class="form-title">Company New</div>
        <form t-att-action="form_submit_url if form_submit_url else '/spc/setup-new-company/apply/step13/submit'" method="post" id="step13Form">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" t-att-value="service_type"/>

            <!-- 01: Legal type -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">01</div>
                        <div class="review-sec-title">Legal type</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">LEGAL TYPE</div>
                    <div class="review-value"><t t-esc="step1.get('legal_type', 'Free Zone Establishment')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">PACKAGE TYPE</div>
                    <div class="review-value"><t t-esc="step1.get('package_type', 'Standard')"/></div>
                </div>
            </div>

            <!-- 02: Business activities -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">02</div>
                        <div class="review-sec-title">Business activities</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step2/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">SELECTED ACTIVITIES</div>
                    <div class="review-value"><t t-esc="step1.get('selected_activities', 'N/A')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">LIST OF PRODUCTS/SERVICES FOR TRADING</div>
                    <div class="review-value">N/A</div>
                </div>
            </div>

            <!-- 03: Company -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">03</div>
                        <div class="review-sec-title">Company</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step3/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">NUMBER OF YEARS</div>
                    <div class="review-value"><t t-esc="step3.get('license_years', '-')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">IS THERE A RESERVED COMPANY NAME?</div>
                    <div class="review-value"><t t-esc="'Yes' if step3.get('name_reserved') == 'yes' else 'No'"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">FIRST PREFERENCE</div>
                    <div class="review-value"><t t-esc="step3.get('name_preference_1', '-')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">SECOND PREFERENCE</div>
                    <div class="review-value"><t t-esc="step3.get('name_preference_2', '-')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">THIRD PREFERENCE</div>
                    <div class="review-value"><t t-esc="step3.get('name_preference_3', '-')"/></div>
                </div>
                <div class="review-row">
                    <div class="review-label">COMPANY NAME TRANSLATION</div>
                    <div class="review-value"><t t-esc="step3.get('arabic_translation', '-')"/></div>
                </div>
            </div>

            <!-- 04: Facility -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">04</div>
                        <div class="review-sec-title">Facility</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step4/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">WHAT TYPE OF FACILITY WILL THE COMPANY REQUIRE?</div>
                    <div class="review-value"><t t-esc="step4.get('facility_type', '-')"/></div>
                </div>
            </div>

            <!-- 05: Visa allocation -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">05</div>
                        <div class="review-sec-title">Visa allocation</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step5/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">NUMBER OF VISA ALLOCATIONS</div>
                    <div class="review-value"><t t-esc="step5.get('visa_count', '0')"/></div>
                </div>
            </div>

            <!-- 06: Shareholder -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">06</div>
                        <div class="review-sec-title">Shareholder(s) information and Capital Structure</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step6/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">NUMBER OF SHAREHOLDERS</div>
                    <div class="review-value"><t t-esc="step6.get('shareholder_count', '1')"/></div>
                </div>
                <!-- Shareholder 1 accordion -->
                <div class="accordion-review">
                    <div class="accordion-review-header" onclick="this.nextElementSibling.classList.toggle('open')">
                        Shareholder 1 <span>&#9660;</span>
                    </div>
                    <div class="accordion-review-body">
                        <div class="review-row">
                            <div class="review-label">IS THE SHAREHOLDER AN EXISTING SPC USER?</div>
                            <div class="review-value"><t t-esc="'Yes' if step6.get('sh_1_spc_user') == 'yes' else 'No'"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">SELECT SHAREHOLDER TYPE</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_type', 'Individual').title()"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">UPLOAD COPY OF PASSPORT</div>
                            <div class="review-value"></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">UPLOAD SPECIAL PAGE OF PASSPORT</div>
                            <div class="review-value"></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">SHAREHOLDER PASSPORT</div>
                            <div class="review-value"><b>Passport details</b></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">PASSPORT NUMBER</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_passport_no', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">FIRST NAME</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_first_name', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">LAST NAME</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_last_name', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">NATIONALITY</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_nationality', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DO YOU HAVE AN ALTERNATE NATIONALITY?</div>
                            <div class="review-value"><t t-esc="'Yes' if step6.get('sh_1_alt_nat') == 'yes' else 'No'"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DATE OF BIRTH</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_dob', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">PLACE OF BIRTH</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_pob', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">COUNTRY OF BIRTH</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_cob', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DATE OF ISSUE</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_doi', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DATE OF EXPIRY</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_doe', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">OTHER DETAILS</div>
                            <div class="review-value"><b>Other details</b></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">MOBILE NUMBER</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_mobile', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DO YOU HAVE SECONDARY CONTACT NUMBER?</div>
                            <div class="review-value"><t t-esc="'Yes' if step6.get('sh_1_secondary') == 'yes' else 'No'"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">E-MAIL ID</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_email_id', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">CURRENT ADDRESS</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_address', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">CITY</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_city', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">COUNTRY</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_country', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">SHAREHOLDER JOINING DATE</div>
                            <div class="review-value"><t t-esc="step6.get('sh_1_joining_date', '-')"/></div>
                        </div>
                        <div class="review-row">
                            <div class="review-label">DO YOU HAVE A VALID UAE RESIDENCE VISA?</div>
                            <div class="review-value"><t t-esc="'Yes' if step6.get('sh_1_uae_visa') == 'yes' else 'No'"/></div>
                        </div>
                        <t t-if="step6.get('sh_1_uae_visa') == 'yes'">
                            <div class="review-row">
                                <div class="review-label">UPLOAD UAE RESIDENT VISA</div>
                                <div class="review-value"></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">UPLOAD EMIRATES ID</div>
                                <div class="review-value"></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">RESIDENT VISA NUMBER</div>
                                <div class="review-value"><t t-esc="step6.get('sh_1_visa_no', '-')"/></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">EMIRATES ID NUMBER</div>
                                <div class="review-value"><t t-esc="step6.get('sh_1_eid_no', '-')"/></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">UNIFIED NUMBER (UID)</div>
                                <div class="review-value"><t t-esc="step6.get('sh_1_uid', '-')"/></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">UID GUIDELINE</div>
                                <div class="review-value">Please find instructional video on how to upload UID<br/><a href="https://youtu.be/T536np8xm_w" style="color:#1abc9c">https://youtu.be/T536np8xm_w</a></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">EMIRATES ID ISSUE DATE</div>
                                <div class="review-value"><t t-esc="step6.get('sh_1_eid_issue', '-')"/></div>
                            </div>
                            <div class="review-row">
                                <div class="review-label">EMIRATES ID EXPIRY DATE</div>
                                <div class="review-value"><t t-esc="step6.get('sh_1_eid_expiry', '-')"/></div>
                            </div>
                        </t>
                        <div class="review-row">
                            <div class="review-label">DOES THE SHAREHOLDER HAVE A NOMINEE?</div>
                            <div class="review-value"><t t-esc="'Yes' if step6.get('sh_1_nominee_ind') == 'yes' else 'No'"/></div>
                        </div>
                    </div>
                </div>
                <!-- Share distribution -->
                <div style="margin-top:20px">
                    <div style="font-size:15px;font-weight:700;color:#1a2340;margin-bottom:12px">Share distribution</div>
                    <table class="share-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>FULL NAME</th>
                                <th>NO OF SHARES ALLOCATED</th>
                                <th>VALUE PER SHARE</th>
                                <th>TOTAL VALUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td><b><t t-esc="(step6.get('sh_1_first_name','') + ' ' + step6.get('sh_1_last_name','')).strip() or '-'"/></b></td>
                                <td><t t-esc="step6.get('sh_1_shares', '-')"/></td>
                                <td>AED <t t-esc="step6.get('sh_1_value_per_share', '-')"/></td>
                                <td>AED <t t-esc="step6.get('sh_1_total_value', '-')"/></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td><b>TOTAL NO OF SHARES ISSUED</b></td>
                                <td><t t-esc="step6.get('sh_1_shares', '-')"/> / <t t-esc="step6.get('sh_1_shares', '-')"/></td>
                                <td></td>
                                <td>AED <t t-esc="step6.get('sh_1_total_value', '-')"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="review-row" style="margin-top:12px">
                        <div class="review-label">NUMBER OF SHARE</div>
                        <div class="review-value"><t t-esc="step6.get('sh_1_shares', '-')"/></div>
                    </div>
                    <div class="review-row">
                        <div class="review-label">VALUE PER SHARE</div>
                        <div class="review-value">AED <t t-esc="step6.get('sh_1_value_per_share', '-')"/></div>
                    </div>
                    <div class="review-row">
                        <div class="review-label">TOTAL CAPITAL</div>
                        <div class="review-value">AED <t t-esc="step6.get('sh_1_total_value', '-')"/></div>
                    </div>
                </div>
            </div>

            <!-- 07: Manager -->
            <div class="review-section">
                <div class="review-header">
                    <div>
                        <div class="review-sec-num">07</div>
                        <div class="review-sec-title">Manager(s) information</div>
                    </div>
                    <a t-att-href="'/spc/setup-new-company/apply/step7/' + service_type" class="edit-btn">&#9998; EDIT</a>
                </div>
                <div class="review-row">
                    <div class="review-label">NUMBER OF MANAGERS</div>
                    <div class="review-value"><t t-esc="step7.get('manager_count', '1')"/></div>
                </div>
                <div class="accordion-review">
                    <div class="accordion-review-header" onclick="this.nextElementSibling.classList.toggle('open')">
                        Manager 1 <span>&#9660;</span>
                    </div>
                    <div class="accordion-review-body">
                        <div class="review-row">
                            <div class="review-label">DEFINE THE MANAGER DETAILS FROM ONE OF THE FOLLOWING SELECTIONS</div>
                            <div class="review-value"><t t-esc="step7.get('mgr_1_email', '-')"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="spc-nav-buttons">
                <a t-att-href="'/spc/setup-new-company/apply/step12/' + service_type" class="spc-btn-previous">PREVIOUS</a>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
</template>
</data>
</odoo>
