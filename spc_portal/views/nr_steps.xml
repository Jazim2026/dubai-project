<!-- NR Step 4: Review -->
<template id="template_nr_step4" name="NR Step4 Review">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Review Application | SPC Free Zone</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
