<!-- EC Renewal/Amendment: Company Step -->
<template id="template_ec_company_step" name="EC Company Step">
<html>
<head><meta charset="utf-8"/><title>Establishment Card</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f0f4f8;color:#1a2340}
.layout{display:flex;min-height:100vh}
.sidebar{width:280px;background:#0d1b3e;color:#fff;padding:28px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.sidebar-top{display:flex;align-items:center;gap:10px;margin-bottom:32px}
.logo-box{background:#1abc9c;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px}
.logo-name{font-size:16px;font-weight:700}.logo-sub{font-size:11px;opacity:.6}
.progress-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;opacity:.4;margin-bottom:12px}
.progress-step{display:flex;align-items:center;gap:12px;margin-bottom:10px;opacity:.45;padding:6px 0}
.progress-step.active{opacity:1}.progress-step.done{opacity:.75}
.step-circle{width:30px;height:30px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0}
.progress-step.active .step-circle{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-circle{background:#fff;color:#0d1b3e;border-color:#fff}
.step-text{font-size:13px;line-height:1.3}
.total-section{margin-top:auto;padding-top:20px;border-top:1px solid rgba(255,255,255,.1)}
.total-amount{font-size:22px;font-weight:700;color:#1abc9c}
.main{margin-left:280px;padding:40px 48px;min-height:100vh}
.page-title{font-size:28px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.form-card{background:#fff;border-radius:14px;padding:28px 32px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:20px}
.sec-num{font-size:12px;color:#1abc9c;font-weight:700;margin-bottom:6px}
.sec-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:14px}
.toggle-btns{display:flex;max-width:400px;margin-bottom:16px}
.toggle-btn{flex:1;padding:10px;border:1px solid #1abc9c;background:#1abc9c;color:#fff;font-size:13px;font-weight:600;cursor:pointer}
.toggle-btn:first-child{border-radius:6px 0 0 6px}
.toggle-btn:last-child{border-radius:0 6px 6px 0}
.toggle-btn.inactive{background:#fff;color:#555;border-color:#ddd}
.flat-select{width:100%;max-width:500px;padding:12px 16px;border:none;border-bottom:2px solid #ddd;font-size:14px;background:#fff;outline:none}
.flat-input{width:100%;max-width:500px;padding:12px 16px;border:none;border-bottom:2px solid #1abc9c;font-size:14px;background:#fff;outline:none;display:block}
.info-box{background:#e8f8f5;border:1px solid #1abc9c;border-radius:8px;padding:12px 16px;margin-top:12px;font-size:13px;color:#555;max-width:500px}
.nav-bar{display:flex;justify-content:flex-end;margin-top:32px}
.btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:14px 48px;font-size:15px;font-weight:700;cursor:pointer}
</style>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-top">
        <div class="logo-box">K</div>
        <div><div class="logo-name">SPC</div><div class="logo-sub">Free Zone</div></div>
    </div>
    <div class="progress-label">Your progress</div>
    <t t-foreach="steps" t-as="s">
        <t t-set="idx" t-value="s_index + 1"/>
        <div t-attf-class="progress-step #{idx == current_step and 'active' or idx &lt; current_step and 'done' or ''}">
            <div class="step-circle"><t t-if="idx &lt; current_step">&#10003;</t><t t-else=""><t t-esc="idx"/></t></div>
            <div class="step-text"><t t-esc="s"/></div>
        </div>
    </t>
    <div class="total-section">
        <div style="font-size:11px;opacity:.5">Total AED</div>
        <div class="total-amount">650.00</div>
    </div>
</div>
<div class="main">
    <div class="page-title"><t t-esc="page_title"/></div>
    <form method="post" t-att-action="form_action">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="form-card">
            <div class="sec-num">01</div>
            <div class="sec-title">Select company</div>
            <div class="toggle-btns">
                <button type="button" id="btn_select" onclick="switchMode('select')" class="toggle-btn">Select from list</button>
                <button type="button" id="btn_manual" onclick="switchMode('manual')" class="toggle-btn inactive">Enter manually</button>
            </div>
            <div id="mode_select">
                <select name="company_id" class="flat-select">
                    <option value="">Company</option>
                    <t t-foreach="companies" t-as="c">
                        <option t-att-value="c.id"><t t-esc="c.name"/></option>
                    </t>
                </select>
                <div class="info-box">&#9432; Making a selection here will auto-fill the fields with information from the initial application whenever available. Please verify and update the data as needed.</div>
            </div>
            <div id="mode_manual" style="display:none">
                <input type="text" name="company_name_manual" class="flat-input" placeholder="Enter company name"/>
            </div>
        </div>
        <div class="nav-bar">
            <button type="button" class="btn-next" onclick="ecCompanyValidate()">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function switchMode(mode){
    var sel = document.getElementById('mode_select');
    var man = document.getElementById('mode_manual');
    var btnSel = document.getElementById('btn_select');
    var btnMan = document.getElementById('btn_manual');
    if(mode==='select'){
        sel.style.display='block';man.style.display='none';
        btnSel.className='toggle-btn';btnMan.className='toggle-btn inactive';
    }else{
        sel.style.display='none';man.style.display='block';
        btnMan.className='toggle-btn';btnSel.className='toggle-btn inactive';
    }
}
function inRange(v,mn,mx){return v.length===Math.min(Math.max(v.length,mn),mx);}
function ecCompanyValidate(){
  var valid=true;
  function showErr(id,msg){var el=document.getElementById(id);if(!el){el=document.createElement("div");el.id=id;el.style.cssText="color:red;font-size:12px;margin-top:4px";}el.textContent=msg;el.style.display="block";}
  function hideErr(id){var el=document.getElementById(id);if(el)el.style.display="none";}
  var man=document.getElementById('mode_manual');
  if(man){if(man.style.display!=='none'){
    var cn=document.querySelector('[name="company_name_manual"]');
    if(cn){if(!inRange(cn.value.trim(),3,100)){showErr("ec_cn_err","Company name must be 3-100 characters.");valid=false;}else hideErr("ec_cn_err");}
  }}
  if(valid)document.querySelector("form").submit();
}
</script>
</body>
</html>
</template>

