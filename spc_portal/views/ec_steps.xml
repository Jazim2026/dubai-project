.total-amount{font-size:22px;font-weight:700;color:#1abc9c}
.main{margin-left:280px;padding:40px 48px;min-height:100vh}
.page-title{font-size:28px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.form-card{background:#fff;border-radius:14px;padding:28px 32px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:20px}
.sec-num{font-size:12px;color:#1abc9c;font-weight:700;margin-bottom:6px}
.sec-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:14px}
.desc-text{font-size:13px;color:#555;line-height:1.8;margin-bottom:12px}
.ack-wrap{display:flex;align-items:flex-start;gap:12px;font-size:14px;margin-top:8px}
.ack-wrap input{width:18px;height:18px;margin-top:2px;accent-color:#1abc9c;flex-shrink:0}
.nav-bar{display:flex;justify-content:space-between;margin-top:32px}
.btn-prev{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 32px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
.btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:12px 48px;font-size:14px;font-weight:700;cursor:pointer}
