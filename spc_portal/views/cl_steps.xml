<template id="template_cl_step1" name="CL Step1">
<html><head><meta charset="utf-8"/><title>Corporate Letters</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<t t-call="spc_portal.cl_css"/>
</head><body>
<div class="layout">
<t t-call="spc_portal.cl_sidebar"/>
<div class="main">
<div class="form-title">Corporate Letters</div>
<form method="post" action="/spc/company-management/corporate-letters/step1/submit" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
    <div class="spc-section">
        <div class="sec-num">01</div>
        <div class="sec-body">
            <div class="sec-title">Select type of corporate letter</div>
            <div class="sel-row">
                <select class="flat-select" name="company_name">
                    <option value="">Select company</option>
                    <t t-foreach="companies" t-as="comp">
                        <option t-att-value="comp" t-att-selected="cl_data.get('company_name')==comp and 'selected' or False"><t t-out="comp"/></option>
                    </t>
                </select>
            </div>
            <div class="sel-row">
                <select class="flat-select" name="letter_type" id="letterType" onchange="handleLetterType(this.value)">
                    <option value="">Corporate letter type</option>
                    <option value="noc">No objection certificate</option>
                    <option value="other">Other</option>
                    <option value="incumbency">Certificate of Incumbency</option>
                    <option value="good_standing">Certificate of Good Standing</option>
                </select>
                <button type="button" class="sel-clear" onclick="document.getElementById('letterType').value='';handleLetterType('')">&#215;</button>
            </div>
            <div id="otherNameField" style="display:none">
                <input class="flat-input" type="text" name="other_letter_name" placeholder="Enter the name of the corporate letter"/>
            </div>
            <div>
                <input class="flat-input" type="date" name="license_expiry_date" t-att-value="cl_data.get('license_expiry_date','')"/>
                <div class="field-lbl">License Expiry Date</div>
            </div>
            <div class="info-box">
                <span>i</span>
                <span>As per SPC rules, ancillary services are frozen 30 days before license expiry. Renew your license to apply for corporate services.</span>
            </div>
        </div>
    </div>

    <div id="nocSection" style="display:none">
        <div class="spc-section" id="nocTypeSection">
            <div class="sec-num">02</div>
            <div class="sec-body">
                <div class="sec-title">Select the type of NOC</div>
                <div class="sel-row" style="margin-top:12px">
                    <select class="flat-select" name="noc_type" id="nocType" onchange="handleNocType(this.value)">
                        <option value="">NOC type</option>
                        <option value="police_report">NOC to file police report for lost documents</option>
                        <option value="establish_ded">NOC to establish a company (DED)</option>
                        <option value="register_vehicle">NOC to register a vehicle</option>
                        <option value="transfer_vehicle">NOC to transfer a vehicle registration</option>
                    </select>
                    <button type="button" class="sel-clear" onclick="document.getElementById('nocType').value='';handleNocType('')">&#215;</button>
                </div>
            </div>
        </div>

        <div id="policeSection" class="spc-section" style="display:none">
            <div class="sec-num">03</div>
            <div class="sec-body">
                <div class="sec-title">Police station details</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px">
                    <input class="flat-input" type="text" name="police_station_name" placeholder="Police station name"/>
                    <div class="sel-row" style="margin-bottom:0">
                        <select class="flat-select" name="police_emirate">
                            <option value="">Emirate</option>
                            <option>Dubai</option><option>Abu Dhabi</option><option>Sharjah</option>
                            <option>Ajman</option><option>Fujairah</option><option>Ras Al Khaimah</option><option>Umm Al Quwain</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div id="dedSection" class="spc-section" style="display:none">
            <div class="sec-num">03</div>
            <div class="sec-body">
                <div class="sec-title">Established company/office location details</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px">
                    <div class="sel-row" style="margin-bottom:0">
                        <select class="flat-select" name="ded_emirate">
                            <option value="">Emirate</option>
                            <option>Dubai</option><option>Abu Dhabi</option><option>Sharjah</option>
                            <option>Ajman</option><option>Fujairah</option><option>Ras Al Khaimah</option><option>Umm Al Quwain</option>
                        </select>
                    </div>
                    <input class="flat-input" type="text" name="ded_office_location" placeholder="Office location (manual)"/>
                </div>
            </div>
        </div>

        <div id="vehicleSection" class="spc-section" style="display:none">
            <div class="sec-num">03</div>
            <div class="sec-body">
                <div class="sec-title">Vehicle details</div>
                <div class="radio-row" id="vTypeRow">
                    <label class="radio-card" onclick="selectVType('lmv',this)">
                        <input type="radio" name="vehicle_type" value="lmv" style="display:none"/>Light motor vehicle (LMV)
                    </label>
                    <label class="radio-card" onclick="selectVType('hmv',this)">
                        <input type="radio" name="vehicle_type" value="hmv" style="display:none"/>Heavy motor vehicle (HMV)
                    </label>
                    <label class="radio-card" onclick="selectVType('other',this)">
                        <input type="radio" name="vehicle_type" value="other" style="display:none"/>Other
                    </label>
                </div>
                <div id="vFields" style="display:none;margin-top:16px">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                        <input class="flat-input" type="text" name="vehicle_chassis" placeholder="Chassis number"/>
                        <input class="flat-input" type="text" name="vehicle_engine" placeholder="Engine number"/>
                        <input class="flat-input" type="text" name="vehicle_model_year" placeholder="Model year"/>
                        <div class="sel-row" style="margin-bottom:0"><select class="flat-select" name="vehicle_color">
                            <option value="">Vehicle color</option>
                            <option>White</option><option>Black</option><option>Blue</option>
                            <option>Red</option><option>Silver</option><option>Grey</option><option>Other</option>
                        </select></div>
                        <div class="sel-row" style="margin-bottom:0"><select class="flat-select" name="vehicle_country_origin">
                            <option value="">Country of origin</option>
                            <t t-foreach="countries" t-as="c"><option t-att-value="c.id"><t t-out="c.name"/></option></t>
                        </select></div>
                        <div id="vNameField" style="display:none">
                            <input class="flat-input" type="text" name="vehicle_name" placeholder="Vehicle name"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="transferSection" class="spc-section" style="display:none">
            <div class="sec-num">03</div>
            <div class="sec-body">
                <div class="sec-title">Vehicle details</div>
                <div class="radio-row" id="tVTypeRow">
                    <label class="radio-card" onclick="selectTVType('lmv',this)">
                        <input type="radio" name="transfer_vehicle_type" value="lmv" style="display:none"/>Light motor vehicle (LMV)
                    </label>
                    <label class="radio-card" onclick="selectTVType('hmv',this)">
                        <input type="radio" name="transfer_vehicle_type" value="hmv" style="display:none"/>Heavy motor vehicle (HMV)
                    </label>
                    <label class="radio-card" onclick="selectTVType('other',this)">
                        <input type="radio" name="transfer_vehicle_type" value="other" style="display:none"/>Other
                    </label>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
                    <div class="sel-row" style="margin-bottom:0">
                        <select class="flat-select" name="vehicle_authority_select">
                            <option value="">Authority</option>
                            <option>RTA</option><option>Police</option><option>Other</option>
                        </select>
                    </div>
                    <input class="flat-input" type="text" name="vehicle_authority" placeholder="Authority (manual)"/>
                </div>
                <div id="tLmvFields" style="display:none;margin-top:16px">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                        <input class="flat-input" type="text" name="transfer_chassis" placeholder="Chassis number"/>
                        <input class="flat-input" type="text" name="transfer_engine" placeholder="Engine number"/>
                        <div class="sel-row" style="margin-bottom:0"><select class="flat-select" name="transfer_color">
                            <option value="">Vehicle color</option>
                            <option>White</option><option>Black</option><option>Blue</option>
                            <option>Red</option><option>Silver</option><option>Grey</option>
                        </select></div>
                        <div class="sel-row" style="margin-bottom:0"><select class="flat-select" name="transfer_country_origin">
                            <option value="">Country of origin</option>
                            <t t-foreach="countries" t-as="c"><option t-att-value="c.id"><t t-out="c.name"/></option></t>
                        </select></div>
                        <input class="flat-input" type="text" name="transfer_make_model" placeholder="Vehicle make and model"/>
                    </div>
                    <div class="upload-row" style="margin-top:16px">
                        <div class="upload-item">
                            <span class="field-label-top">Upload online car registration copy</span>
                            <div class="upload-area" onclick="document.getElementById('regFile').click()">
                                <input type="file" id="regFile" name="vehicle_reg_copy" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                                <div class="upload-icon">&#11014;</div>
                                <div class="upload-text">Upload online car registration</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="spc-section" id="nocRemarks">
            <div class="sec-num" id="remarksNum">03</div>
            <div class="sec-body">
                <div class="sec-title">Remarks</div>
                <textarea class="flat-input" name="remarks" rows="3" placeholder="Comments" style="resize:none;padding-top:10px"></textarea>
            </div>
        </div>
    </div>

    <div id="generalRemarks" class="spc-section" style="display:none">
        <div class="sec-num">02</div>
        <div class="sec-body">
            <div class="sec-title">Remarks</div>
            <textarea class="flat-input" name="general_remarks" rows="3" placeholder="Comments" style="resize:none;padding-top:10px"></textarea>
        </div>
    </div>

    <div class="spc-nav-buttons">
        <a href="/spc/company-management" class="spc-btn-prev">PREVIOUS</a>
        <button type="button" class="spc-btn-next" onclick="clStep1Validate()">NEXT</button>
    </div>
</form>
</div>
</div>
<script>//<![CDATA[
function clStep1Validate(){
  var valid=true;
  function showErr(id,msg){var el=document.getElementById(id);if(!el){el=document.createElement('div');el.id=id;el.style.cssText='color:red;font-size:12px;margin-top:4px';}el.textContent=msg;el.style.display='block';}
  function hideErr(id){var el=document.getElementById(id);if(el)el.style.display='none';}
  function addErrAfter(el,id){if(el&&!document.getElementById(id)){var e=document.createElement('div');e.id=id;e.style.cssText='color:red;font-size:12px;margin-top:4px';el.parentElement.appendChild(e);}}

  // Company name
  var co=document.querySelector('[name="company_name"]');addErrAfter(co,'cl_co_err');
  if(!co||!co.value){showErr('cl_co_err','Please select a company.');valid=false;}else hideErr('cl_co_err');

  // License expiry date
  var ld=document.querySelector('[name="license_expiry_date"]');addErrAfter(ld,'cl_ld_err');
  if(!ld||!ld.value){showErr('cl_ld_err','Please select the license expiry date.');valid=false;}else hideErr('cl_ld_err');

  // Letter type
  var lt=document.querySelector('[name="letter_type"]');addErrAfter(lt,'cl_lt_err');
  if(!lt||!lt.value){showErr('cl_lt_err','Please select a corporate letter type.');valid=false;}else hideErr('cl_lt_err');

  if(lt&&lt.value){
    // NOC validations
    if(lt.value==='noc'){
      var nt=document.getElementById('nocType');addErrAfter(nt,'cl_nt_err');
      if(!nt||!nt.value){showErr('cl_nt_err','Please select the type of NOC.');valid=false;}else{
        hideErr('cl_nt_err');
        // Police section
        if(nt.value==='police_report'){
          var ps=document.querySelector('[name="police_station_name"]');addErrAfter(ps,'cl_ps_err');
          if(!ps||!ps.value.trim()){showErr('cl_ps_err','Please enter police station name.');valid=false;}else hideErr('cl_ps_err');
          var pe=document.querySelector('[name="police_emirate"]');addErrAfter(pe,'cl_pe_err');
          if(!pe||!pe.value){showErr('cl_pe_err','Please select emirate.');valid=false;}else hideErr('cl_pe_err');
        }
        // DED section
        if(nt.value==='establish_ded'){
          var de=document.querySelector('[name="ded_emirate"]');addErrAfter(de,'cl_de_err');
          if(!de||!de.value){showErr('cl_de_err','Please select emirate.');valid=false;}else hideErr('cl_de_err');
          var dl=document.querySelector('[name="ded_office_location"]');addErrAfter(dl,'cl_dl_err');
          if(!dl||!dl.value.trim()){showErr('cl_dl_err','Please enter office location.');valid=false;}else hideErr('cl_dl_err');
        }
        // Vehicle register
        if(nt.value==='register_vehicle'){
          var vt=document.querySelector('[name="vehicle_type"]:checked');
          if(!vt){if(!document.getElementById('cl_vt_err')){var e=document.createElement('div');e.id='cl_vt_err';e.style.cssText='color:red;font-size:12px;margin-top:4px';document.getElementById('vTypeRow').insertAdjacentElement('afterend',e);}showErr('cl_vt_err','Please select vehicle type.');valid=false;}else{hideErr('cl_vt_err');
            var ve=document.querySelector('[name="vehicle_engine"]');addErrAfter(ve,'cl_ve_err');
            if(!ve||!ve.value.trim()){showErr('cl_ve_err','Please enter engine number.');valid=false;}else hideErr('cl_ve_err');
            var vy=document.querySelector('[name="vehicle_model_year"]');addErrAfter(vy,'cl_vy_err');
            if(!vy||!vy.value.trim()){showErr('cl_vy_err','Please enter model year.');valid=false;}else hideErr('cl_vy_err');
          }
        }
        // Vehicle transfer
        if(nt.value==='transfer_vehicle'){
          var tvt=document.querySelector('[name="transfer_vehicle_type"]:checked');
          if(!tvt){if(!document.getElementById('cl_tvt_err')){var e=document.createElement('div');e.id='cl_tvt_err';e.style.cssText='color:red;font-size:12px;margin-top:4px';document.getElementById('tVTypeRow').insertAdjacentElement('afterend',e);}showErr('cl_tvt_err','Please select vehicle type.');valid=false;}else{hideErr('cl_tvt_err');
            if(tvt.value==='lmv'){
              var tc=document.querySelector('[name="transfer_chassis"]');addErrAfter(tc,'cl_tc_err');
              if(!tc||!tc.value.trim()){showErr('cl_tc_err','Please enter chassis number.');valid=false;}else hideErr('cl_tc_err');
              var ten=document.querySelector('[name="transfer_engine"]');addErrAfter(ten,'cl_ten_err');
              if(!ten||!ten.value.trim()){showErr('cl_ten_err','Please enter engine number.');valid=false;}else hideErr('cl_ten_err');
              var tmy=document.querySelector('[name="vehicle_model_year"]');
              var rf=document.getElementById('regFile');
              if(!rf||!rf.files||rf.files.length===0){if(!document.getElementById('cl_rf_err')){var e=document.createElement('div');e.id='cl_rf_err';e.style.cssText='color:red;font-size:12px;margin-top:4px';rf.parentElement.insertAdjacentElement('afterend',e);}showErr('cl_rf_err','Please upload car registration copy.');valid=false;}else hideErr('cl_rf_err');
            }
          }
        }
      }
    }
  }
  if(valid)document.querySelector('form').submit();
}

function handleLetterType(v){
    document.getElementById("otherNameField").style.display=v==="other"?"":"none";
    document.getElementById("nocSection").style.display=v?"":"none";
    document.getElementById("nocRemarks").style.display=v?"":"none";
    document.getElementById("generalRemarks").style.display="none";
}
function handleNocType(v){
    ["policeSection","dedSection","vehicleSection","transferSection"].forEach(function(id){
        document.getElementById(id).style.display="none";
    });
    if(v==="police_report") document.getElementById("policeSection").style.display="";
    else if(v==="establish_ded") document.getElementById("dedSection").style.display="";
    else if(v==="register_vehicle") document.getElementById("vehicleSection").style.display="";
    else if(v==="transfer_vehicle") document.getElementById("transferSection").style.display="";
    document.getElementById("remarksNum").textContent=v?"04":"03";
}
function selectVType(t,el){
    document.querySelectorAll("#vTypeRow .radio-card").forEach(function(c){c.classList.remove("selected");});
    el.classList.add("selected");
    el.querySelector("input").checked=true;
    document.getElementById("vFields").style.display=t?"":"none";
    document.getElementById("vNameField").style.display=t==="lmv"?"":"none";
}
function selectTVType(t,el){
    document.querySelectorAll("#tVTypeRow .radio-card").forEach(function(c){c.classList.remove("selected");});
    el.classList.add("selected");
    el.querySelector("input").checked=true;
    document.getElementById("tLmvFields").style.display=t==="lmv"?"":"none";
}
//]]>
</script>
</body></html>
</template>

<template id="template_cl_step2" name="CL Step2 Declaration">
