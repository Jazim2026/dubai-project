.payment-card{background:#fff;border-radius:12px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.06);max-width:600px}
.payment-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:20px}
.fee-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f0f0;font-size:14px}
.fee-row:last-child{border-bottom:none;font-weight:700;font-size:16px;color:#1a2340}
.fee-label{color:#555}
.fee-value{color:#1a2340;font-weight:600}
.pay-methods{margin-top:24px}
.pay-method-title{font-size:14px;font-weight:600;color:#1a2340;margin-bottom:12px}
.pay-option{display:flex;align-items:center;gap:12px;padding:14px 16px;border:2px solid #e0e0e0;border-radius:8px;margin-bottom:10px;cursor:pointer}
.pay-option:hover{border-color:#1abc9c}
.pay-option input{accent-color:#1a2340}
.pay-option-label{font-size:14px;color:#333}
.submit-btn{width:100%;background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:14px;font-size:15px;font-weight:700;cursor:pointer;margin-top:20px}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:24px}
.spc-btn-previous{border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:14px;font-weight:700;color:#1a2340;text-decoration:none}
    </style>
</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">K SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Business activities</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Company name</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Declaration</div></div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Review application</div></div>
        <div class="progress-step active"><div class="step-num">5</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">510.00 &#9432;</div></div>
        <div class="sidebar-links">
            <a href="#">SAVE &amp; CONTINUE LATER</a>
            <a href="#">CANCEL APPLICATION</a>
        </div>
    </div>
    <div class="main">
        <div class="form-title">Name Reservation - New</div>
        <form action="#" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" t-att-value="service_type"/>
            <div class="payment-card">
                <div class="payment-title">Payment Summary</div>
                <div class="fee-row">
                    <span class="fee-label">Name Reservation Fee</span>
                    <span class="fee-value">AED 500.00</span>
                </div>
                <div class="fee-row">
                    <span class="fee-label">Processing Fee</span>
                    <span class="fee-value">AED 10.00</span>
                </div>
                <div class="fee-row">
                    <span class="fee-label">Total</span>
                    <span class="fee-value">AED 510.00</span>
                </div>
                <div class="pay-methods">
                    <div class="pay-method-title">Select payment method</div>
                    <label class="pay-option">
                        <input type="radio" name="payment_method" value="card"/> 
                        <span class="pay-option-label">Credit / Debit Card</span>
                    </label>
                    <label class="pay-option">
                        <input type="radio" name="payment_method" value="online_transfer"/>
                        <span class="pay-option-label">Online Bank Transfer</span>
                    </label>
                </div>
                <button type="submit" class="submit-btn">SUBMIT</button>
            </div>
            <div class="spc-nav-buttons">
                <a t-att-href="'/spc/setup-new-company/apply/nr-step4/' + service_type" class="spc-btn-previous">PREVIOUS</a>
            </div>
        </form>
    </div>
</div>
</body>
</html>
</template>

</data>
</odoo>
