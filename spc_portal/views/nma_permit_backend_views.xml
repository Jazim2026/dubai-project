<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="view_spc_nma_permit_tree" model="ir.ui.view">
        <field name="name">spc.nma.permit.tree</field>
        <field name="model">spc.nma.permit</field>
        <field name="arch" type="xml">
            <tree string="NMA Permit"
                  decoration-info="state=='draft'"
                  decoration-success="state=='approved'"
                  decoration-muted="state=='rejected'">
                <field name="name"/>
                <field name="permit_type"/>
                <field name="publication_type"/>
                <field name="partner_id"/>
                <field name="submission_date"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'"
                       decoration-success="state=='approved'"
                       decoration-danger="state=='rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_spc_nma_permit_form" model="ir.ui.view">
        <field name="name">spc.nma.permit.form</field>
        <field name="model">spc.nma.permit</field>
        <field name="arch" type="xml">
            <form string="NMA Permit">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="partner_id"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="total_amount"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permit Details">
                            <group>
                                <group string="Permit Type">
                                    <field name="permit_type"/>
                                </group>
                            </group>

                            <!-- Printing Permit -->
                            <group string="Printing Permit - Publication">
                                <group>
                                    <field name="publication_type"/>
                                    <field name="book_title"/>
                                    <field name="author_name"/>
                                    <field name="language"/>
                                    <field name="article_type"/>
                                    <field name="issue_number"/>
                                    <field name="publish_method"/>
                                    <field name="cover_type"/>
                                    <field name="subject_category"/>
                                    <field name="subject_subcategory"/>
                                    <field name="publication_title"/>
                                </group>
                            </group>

                            <!-- Trading Permit -->
                            <group string="Trading Permit">
                                <group>
                                    <field name="trade_format"/>
                                    <field name="print_year"/>
                                    <field name="distributor_agency"/>
                                    <field name="national_depository_number"/>
                                    <field name="isbn"/>
                                    <field name="version_number"/>
                                    <field name="how_obtained"/>
                                </group>
                            </group>

                            <!-- Regulatory Permit -->
                            <group string="Regulatory Entry Permit">
                                <group>
                                    <field name="material_type"/>
                                    <field name="number_of_title"/>
                                    <field name="reg_title"/>
                                </group>
                            </group>

                            <!-- Text Permit -->
                            <group string="Text Permit">
                                <group>
                                    <field name="text_publication_type"/>
                                </group>
                            </group>

                            <group string="Remarks">
                                <field name="step1_remarks" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <group>
                                <group string="Undertaking Letter">
                                    <field name="doc_undertaking" widget="binary" filename="doc_undertaking_name"/>
                                    <field name="doc_undertaking_name" readonly="1"/>
                                </group>
                                <group string="Soft Copy Sample of Media">
                                    <field name="doc_soft_copy" widget="binary" filename="doc_soft_copy_name"/>
                                    <field name="doc_soft_copy_name" readonly="1"/>
                                </group>
                                <group string="Copy of Media License">
                                    <field name="doc_media_license" widget="binary" filename="doc_media_license_name"/>
                                    <field name="doc_media_license_name" readonly="1"/>
                                </group>
                                <group string="Copy of Book PDF">
                                    <field name="doc_copy_book" widget="binary" filename="doc_copy_book_name"/>
                                    <field name="doc_copy_book_name" readonly="1"/>
                                </group>
                                <group string="Declaration Document">
                                    <field name="doc_declaration" widget="binary" filename="doc_declaration_name"/>
                                    <field name="doc_declaration_name" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Declaration">
                            <group>
                                <field name="declaration_accepted"/>
                            </group>
                            <group string="Additional Remarks">
                                <field name="additional_remarks" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spc_nma_permit_search" model="ir.ui.view">
        <field name="name">spc.nma.permit.search</field>
        <field name="model">spc.nma.permit</field>
        <field name="arch" type="xml">
            <search string="NMA Permit">
                <field name="name" string="Reference"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Permit Type" name="grp_permit" context="{'group_by':'permit_type'}"/>
                    <filter string="Status" name="grp_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_spc_nma_permit" model="ir.actions.act_window">
        <field name="name">NMA Permit</field>
        <field name="res_model">spc.nma.permit</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No NMA Permit applications yet</p>
        </field>
    </record>

    <!-- Under Applications menu -->
    <menuitem id="menu_spc_nma_permit_app"
              name="NMA Permit"
              parent="menu_spc_applications"
              action="action_spc_nma_permit"
              sequence="50"/>

    <!-- Under Company Management menu -->
    <menuitem id="menu_spc_nma_permit_cm_parent"
              name="NMA Permit"
              parent="menu_spc_company_management"
              sequence="80"/>
    <menuitem id="menu_spc_nma_permit_cm_child"
              name="NMA Permit"
              parent="menu_spc_nma_permit_cm_parent"
              action="action_spc_nma_permit"
              sequence="10"/>

</data>
</odoo>
