<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MEDICAL TREE -->
    <record id="spc_medical_tree" model="ir.ui.view">
        <field name="name">spc.medical.tree</field>
        <field name="model">spc.medical</field>
        <field name="arch" type="xml">
            <tree string="Medical">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="medical_type"/>
                <field name="visa_type"/>
                <field name="service_type"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- MEDICAL FORM -->
    <record id="spc_medical_form" model="ir.ui.view">
        <field name="name">spc.medical.form</field>
        <field name="model">spc.medical</field>
        <field name="arch" type="xml">
            <form string="Medical">
                <header>
                    <button name="action_send_notification" string="Send Notification" type="object" class="btn-secondary"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_in_review" string="In Review" type="object" invisible="state != 'submitted'"/>
                    <button name="action_approve_documents" string="Approve Documents" type="object"
                            invisible="state not in ['submitted','under_review']" class="btn-primary"/>
                    <button name="action_approve_payment" string="Payment Approval" type="object"
                            invisible="state != 'documents_approved'" class="btn-primary"/>
                    <button name="action_approve_complaints" string="Complaints" type="object"
                            invisible="state != 'payment_approved'" class="btn-primary"/>
                    <button name="action_under_process" string="Under Process" type="object"
                            invisible="state != 'complaints_approved'" class="btn-primary"/>
                    <button name="action_completed" string="Completed Application" type="object"
                            invisible="state != 'under_process'" class="btn-success"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'in_review'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state not in ['submitted','in_review']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Application">
                            <field name="partner_id"/>
                            <field name="medical_type"/>
                            <field name="visa_type"/>
                            <field name="service_type"/>
                            <field name="amount"/>
                            <field name="payment_status"/>
                        </group>
                        <group string="Applicant">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="mother_name"/>
                            <field name="email"/>
                            <field name="mobile"/>
                            <field name="dob"/>
                            <field name="marital_status"/>
                            <field name="religion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="doc_passport_ids" widget="many2many_binary"/>
                                <field name="doc_special_ids" widget="many2many_binary"/>
                                <field name="doc_entry_visa_ids" widget="many2many_binary"/>
                                <field name="doc_photo_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Declaration">
                            <group><field name="declaration_accepted"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spc_medical_action" model="ir.actions.act_window">
        <field name="name">Medical</field>
        <field name="res_model">spc.medical</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_spc_medical_top" name="Medical" parent="menu_spc_concierge_top" sequence="30"/>
    <record id="spc_medical_new_action" model="ir.actions.act_window">
        <field name="name">Medical - New Residency</field>
        <field name="res_model">spc.medical</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('medical_type','=','new_residency')]</field>
        <field name="context">{'default_medical_type': 'new_residency'}</field>
    </record>
    <record id="spc_medical_renewal_action" model="ir.actions.act_window">
        <field name="name">Medical - Renewal</field>
        <field name="res_model">spc.medical</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('medical_type','=','renewal')]</field>
        <field name="context">{'default_medical_type': 'renewal'}</field>
    </record>
    <menuitem id="menu_spc_medical_new" name="New Residency" action="spc_medical_new_action" parent="menu_spc_medical_top" sequence="1"/>
    <menuitem id="menu_spc_medical_renewal" name="Renewal" action="spc_medical_renewal_action" parent="menu_spc_medical_top" sequence="2"/>

    <!-- MEETING ROOM TREE -->
    <record id="spc_meeting_room_tree" model="ir.ui.view">
        <field name="name">spc.meeting.room.tree</field>
        <field name="model">spc.meeting.room</field>
        <field name="arch" type="xml">
            <tree string="Meeting Room Booking">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="booking_date"/>
                <field name="meeting_duration"/>
                <field name="amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- MEETING ROOM FORM -->
    <record id="spc_meeting_room_form" model="ir.ui.view">
        <field name="name">spc.meeting.room.form</field>
        <field name="model">spc.meeting.room</field>
        <field name="arch" type="xml">
            <form string="Meeting Room Booking">
                <header>
                    <button name="action_send_notification" string="Send Notification" type="object" class="btn-secondary"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="state not in ['draft','submitted']"/>
                    <button name="action_approve_documents" string="Approve Documents" type="object"
                            invisible="state not in ['submitted','under_review']" class="btn-primary"/>
                    <button name="action_approve_payment" string="Payment Approval" type="object"
                            invisible="state != 'documents_approved'" class="btn-primary"/>
                    <button name="action_approve_complaints" string="Complaints" type="object"
                            invisible="state != 'payment_approved'" class="btn-primary"/>
                    <button name="action_under_process" string="Under Process" type="object"
                            invisible="state != 'complaints_approved'" class="btn-primary"/>
                    <button name="action_completed" string="Completed Application" type="object"
                            invisible="state != 'under_process'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed,documents_approved,payment_approved,under_process,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="booking_date"/>
                            <field name="booking_start_time"/>
                            <field name="meeting_duration"/>
                            <field name="amount"/>
                            <field name="payment_status"/>
                        </group>
                        <group>
                            <field name="comments"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spc_meeting_room_action" model="ir.actions.act_window">
        <field name="name">Meeting Room Booking</field>
        <field name="res_model">spc.meeting.room</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_spc_meeting_room" name="Meeting Room Booking" action="spc_meeting_room_action" parent="menu_spc_concierge_top" sequence="35"/>

    <!-- MOFA TREE -->
