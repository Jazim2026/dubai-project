<!-- EC New: Application Details Step -->
<template id="template_ec_new_step1" name="EC New Step1">
<html>
<head><meta charset="utf-8"/><title>Establishment Card - New</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f0f4f8;color:#1a2340}
.layout{display:flex;min-height:100vh}
.sidebar{width:280px;background:#0d1b3e;color:#fff;padding:28px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.sidebar-top{display:flex;align-items:center;gap:10px;margin-bottom:32px}
.logo-box{background:#1abc9c;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px}
.logo-name{font-size:16px;font-weight:700}.logo-sub{font-size:11px;opacity:.6}
.progress-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;opacity:.4;margin-bottom:12px}
.progress-step{display:flex;align-items:center;gap:12px;margin-bottom:10px;opacity:.45;padding:6px 0}
.progress-step.active{opacity:1}.progress-step.done{opacity:.75}
.step-circle{width:30px;height:30px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0}
.progress-step.active .step-circle{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-circle{background:#fff;color:#0d1b3e;border-color:#fff}
.step-text{font-size:13px;line-height:1.3}
.total-section{margin-top:auto;padding-top:20px;border-top:1px solid rgba(255,255,255,.1)}
.total-amount{font-size:22px;font-weight:700;color:#1abc9c}
.main{margin-left:280px;padding:40px 48px;min-height:100vh}
.page-title{font-size:28px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.form-card{background:#fff;border-radius:14px;padding:28px 32px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:20px}
.sec-num{font-size:12px;color:#1abc9c;font-weight:700;margin-bottom:6px}
.sec-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:14px}
.radio-row{display:flex;align-items:center;gap:20px;font-size:14px}
.radio-row label{display:flex;align-items:center;gap:8px;cursor:pointer;color:#1abc9c;font-weight:500}
.radio-row input[type=radio]{width:18px;height:18px;accent-color:#1abc9c}
.validity-opts{display:flex;flex-direction:column;gap:10px;margin-top:4px}
.validity-opt{display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;color:#1abc9c}
.validity-opt input[type=radio]{width:18px;height:18px;accent-color:#1abc9c}
.nav-bar{display:flex;justify-content:flex-end;margin-top:32px}
.btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:14px 48px;font-size:15px;font-weight:700;cursor:pointer}
.btn-prev{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 32px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block;margin-right:auto}
</style>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-top">
        <div class="logo-box">K</div>
        <div><div class="logo-name">SPC</div><div class="logo-sub">Free Zone</div></div>
    </div>
    <div class="progress-label">Your progress</div>
    <div class="progress-step active"><div class="step-circle">1</div><div class="step-text">Application details</div></div>
    <div class="progress-step"><div class="step-circle">2</div><div class="step-text">Declaration</div></div>
    <div class="progress-step"><div class="step-circle">3</div><div class="step-text">Review application</div></div>
    <div class="progress-step"><div class="step-circle">4</div><div class="step-text">Payment</div></div>
    <div class="total-section">
        <div style="font-size:11px;opacity:.5">Total</div>
        <div style="font-size:11px;opacity:.5">AED</div>
        <div class="total-amount">650.00</div>
    </div>
</div>
<div class="main">
    <div class="page-title">New</div>
    <form method="post" action="/spc/company-management/apply/ec-new-step1/submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="form-card">
            <div class="sec-num">01</div>
            <div class="sec-title">Confirm Immigration card application</div>
            <div style="font-size:13px;color:#888;margin-bottom:10px">Do you want to proceed with Establishment card?</div>
            <div class="radio-row">
                <label><input type="radio" name="confirm_establishment_card" value="yes" checked="checked" onchange="toggleValidity(this)"/> Yes</label>
                <label style="color:#333"><input type="radio" name="confirm_establishment_card" value="no" onchange="toggleValidity(this)"/> No</label>
            </div>
        </div>
        <div class="form-card" id="validity_section">
            <div class="sec-num">02</div>
            <div class="sec-title">Select Immigration Card (Establishment Card) validity period</div>
            <div class="validity-opts">
                <label class="validity-opt"><input type="radio" name="establishment_card_validity" value="2_years" checked="checked"/> 2 years</label>
                <label class="validity-opt" style="color:#333"><input type="radio" name="establishment_card_validity" value="1_year"/> 1 year</label>
            </div>
        </div>
        <div class="form-card">
            <div class="sec-num">03</div>
            <div class="sec-title">Confirm E-channel application</div>
            <div style="font-size:13px;color:#888;margin-bottom:10px">Do you want to proceed with E-channel?</div>
            <div class="radio-row">
                <label><input type="radio" name="confirm_echannel" value="yes" onchange="toggleEchannelValidity(this)"/> Yes</label>
                <label style="color:#333"><input type="radio" name="confirm_echannel" value="no" checked="checked" onchange="toggleEchannelValidity(this)"/> No</label>
            </div>
        </div>
        <div class="form-card" id="echannel_validity_section" style="display:none">
            <div class="sec-num">04</div>
            <div class="sec-title">Select E-channel validity period</div>
            <div style="font-size:13px;color:#888;margin-bottom:10px">E-channel Validity</div>
            <div class="validity-opts">
                <label class="validity-opt" style="color:#333"><input type="radio" name="echannel_validity" value="1_year"/> 1 Year</label>
                <label class="validity-opt" style="color:#333"><input type="radio" name="echannel_validity" value="2_years"/> 2 Years</label>
            </div>
        </div>
        <div class="nav-bar">
            <button type="button" class="btn-next" onclick="ecStep1Validate()">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function toggleValidity(radio){
    var sec = document.getElementById('validity_section');
    if(sec) sec.style.display = radio.value === 'yes' ? 'block' : 'none';
}
function toggleEchannelValidity(radio){
    var sec = document.getElementById('echannel_validity_section');
    if(sec) sec.style.display = radio.value === 'yes' ? 'block' : 'none';
}
function ecStep1Validate(){
    var ec=document.querySelector('input[name="confirm_establishment_card"]:checked');
    if(!ec){
        if(!document.getElementById("ec_ec_err")){var e=document.createElement("div");e.id="ec_ec_err";e.style.cssText="color:red;font-size:12px;margin-top:4px";document.querySelector('input[name="confirm_establishment_card"]').parentElement.insertAdjacentElement("afterend",e);}
        document.getElementById("ec_ec_err").textContent="Please select an option.";
        return;
    }
    document.querySelector("form").submit();
}
</script>
</body>
</html>
</template>

<!-- EC Shared Declaration -->
<template id="template_ec_declaration" name="EC Declaration">
