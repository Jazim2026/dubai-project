<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<template id="template_certify_step1" name="Certify Step1 Document">
<html><head><meta charset="utf-8"/><title>Certify</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>
.doc-select-wrap{position:relative;max-width:700px}
.doc-input{width:100%;padding:10px 0;border:none;border-bottom:1.5px solid #d1d5db;font-size:14px;background:transparent;outline:none;cursor:pointer;color:#888}
.doc-input:focus{border-bottom-color:#1abc9c}
.doc-clear{position:absolute;right:4px;top:50%;transform:translateY(-50%);background:#6b7280;color:#fff;border:none;border-radius:50%;width:22px;height:22px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center}
.doc-dropdown{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e0e0e0;border-radius:0 0 8px 8px;z-index:100;box-shadow:0 4px 12px rgba(0,0,0,.1)}
.doc-dropdown.open{display:block}
.doc-option{padding:14px 16px;font-size:14px;cursor:pointer;color:#333;border-bottom:1px solid #f0f0f0}
.doc-option:last-child{border-bottom:none}
.doc-option:hover{background:#f0fdf4;color:#1abc9c}
.selected-docs{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;max-width:700px}
.doc-tag{background:#1abc9c;color:#fff;border-radius:20px;padding:6px 14px;font-size:13px;display:flex;align-items:center;gap:8px}
.doc-tag-remove{background:none;border:none;color:#fff;cursor:pointer;font-size:16px;line-height:1;padding:0}
</style>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <div class="progress-step active"><div class="step-num">1</div><div class="step-label">Document</div></div>
    <div class="progress-step"><div class="step-num">2</div><div class="step-label">Declaration</div></div>
    <div class="progress-step"><div class="step-num">3</div><div class="step-label">Review application</div></div>
    <div class="progress-step"><div class="step-num">4</div><div class="step-label">Payment</div></div>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Certify</div>
    <form method="post" action="/spc/company-management/apply/certify-step1/submit" id="certify_form">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <input type="hidden" name="document_names" id="doc_names_input"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Select the name of the document(s) to certify</div>
                <div class="doc-select-wrap">
                    <input type="text" class="doc-input" placeholder="Document" readonly="readonly" onclick="toggleDropdown()" id="doc_display"/>
                    <button type="button" class="doc-clear" onclick="clearDocs()">&#215;</button>
                    <div class="doc-dropdown" id="doc_dropdown">
                        <div class="doc-option" onclick="selectDoc('Certificate of Formation')">Certificate of Formation</div>
                        <div class="doc-option" onclick="selectDoc('Trade License')">Trade License</div>
                        <div class="doc-option" onclick="selectDoc('Share Register')">Share Register</div>
                        <div class="doc-option" onclick="selectDoc('Lease Agreement')">Lease Agreement</div>
                        <div class="doc-option" onclick="selectDoc('Memorandum of Association')">Memorandum of Association</div>
                        <div class="doc-option" onclick="selectDoc('Articles of Association')">Articles of Association</div>
                    </div>
                </div>
                <div class="selected-docs" id="selected_docs"></div>
            </div>
        </div>
        <div class="spc-section">
            <div class="sec-num">02</div>
            <div class="sec-body">
                <div class="sec-title">Remarks</div>
                <textarea class="field-input" name="remarks" placeholder="Comments" rows="3" style="resize:none;min-height:70px"></textarea>
            </div>
        </div>
        <div class="spc-nav-buttons" style="justify-content:flex-end">
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
var selectedDocs = [];
function toggleDropdown(){
    var dd = document.getElementById('doc_dropdown');
    dd.classList.toggle('open');
}
function selectDoc(name){
    if(!selectedDocs.includes(name)){ selectedDocs.push(name); renderTags(); }
    document.getElementById('doc_dropdown').classList.remove('open');
}
function removeDoc(name){
    selectedDocs = selectedDocs.filter(function(d){return d !== name});
    renderTags();
}
function clearDocs(){ selectedDocs = []; renderTags(); }
function renderTags(){
    var container = document.getElementById('selected_docs');
    var input = document.getElementById('doc_names_input');
    container.innerHTML = selectedDocs.map(function(d){
        return '<div class="doc-tag">' + d + '<button type="button" class="doc-tag-remove" onclick="removeDoc(\'' + d + '\')">&#215;</button></div>';
    }).join('');
    input.value = selectedDocs.join(', ');
    document.getElementById('doc_display').placeholder = selectedDocs.length ? selectedDocs.length + ' document(s) selected' : 'Document';
}
document.addEventListener('click', function(e){
    var wrap = document.querySelector('.doc-select-wrap');
    if(wrap &amp;&amp; !wrap.contains(e.target)){
        document.getElementById('doc_dropdown').classList.remove('open');
    }
});
</script>
</body></html>
</template>

<template id="template_certify_step2" name="Certify Step2 Declaration">
<html><head><meta charset="utf-8"/><title>Certify - Declaration</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Document</div></div>
    <div class="progress-step active"><div class="step-num">2</div><div class="step-label">Declaration</div></div>
    <div class="progress-step"><div class="step-num">3</div><div class="step-label">Review application</div></div>
    <div class="progress-step"><div class="step-num">4</div><div class="step-label">Payment</div></div>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Certify</div>
    <form method="post" action="/spc/company-management/apply/certify-step2/submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Declaration:</div>
                <div class="decl-box">
                    <p style="margin-bottom:14px">By clicking below, I hereby agree and acknowledge my responsibility to remain in compliance, at all times, with all applicable undertakings and declarations, as may be required by SPC. I further reaffirm my acceptance of <a href="#" style="color:#1abc9c">SPC Terms and Conditions</a> and the laws of the United Arab Emirates.</p>
                    <p>Neither SPC nor its affiliates shall assume liability for any actual or purported failure to comply with applicable laws and regulations, whether by the company's ultimate beneficial owner(s), manager(s), agents or otherwise.</p>
                </div>
                <p style="font-size:14px;font-weight:600;margin-bottom:12px;margin-top:16px">Acknowledgement</p>
                <label class="ack-row">
                    <input type="checkbox" name="declaration" id="decl_check" required="required" style="width:16px;height:16px"/>
                    I have read and agree to the SPC Terms and Conditions.
                </label>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <a href="#" onclick="history.back();return false;" class="spc-btn-prev">PREVIOUS</a>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
</body></html>
</template>

<template id="template_certify_review" name="Certify Review">
<html><head><meta charset="utf-8"/><title>Certify - Review</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Document</div></div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Declaration</div></div>
    <div class="progress-step active"><div class="step-num">3</div><div class="step-label">Review application</div></div>
    <div class="progress-step"><div class="step-num">4</div><div class="step-label">Payment</div></div>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Review Application</div>
    <div class="review-card">
        <div class="review-header"><div class="review-sec-title">Documents</div></div>
        <div class="review-row"><div class="review-lbl">DOCUMENTS TO CERTIFY</div><div class="review-val"><t t-esc="step1.get('document_names', '-')"/></div></div>
        <div class="review-row"><div class="review-lbl">REMARKS</div><div class="review-val"><t t-esc="step1.get('remarks', '-')"/></div></div>
    </div>
    <form method="post" action="/spc/company-management/apply/certify-payment/submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-nav-buttons">
            <a href="#" onclick="history.back();return false;" class="spc-btn-prev">PREVIOUS</a>
            <button type="submit" class="spc-btn-next">PROCEED TO PAYMENT</button>
        </div>
    </form>
</div>
</div>
</body></html>
</template>

<template id="template_certify_payment" name="Certify Payment">
<html><head><meta charset="utf-8"/><title>Certify - Payment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Document</div></div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Declaration</div></div>
    <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Review application</div></div>
    <div class="progress-step active"><div class="step-num">4</div><div class="step-label">Payment</div></div>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Payment</div>
    <form method="post" action="/spc/company-management/apply/certify-final-submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Select Payment Method</div>
                <label class="ack-row" style="margin-bottom:12px"><input type="radio" name="payment_method" value="cash" checked="checked" style="width:16px;height:16px"/> Cash</label>
                <label class="ack-row" style="margin-bottom:12px"><input type="radio" name="payment_method" value="bank_transfer" style="width:16px;height:16px"/> Bank Transfer</label>
                <label class="ack-row" style="margin-bottom:12px"><input type="radio" name="payment_method" value="credit_card" style="width:16px;height:16px"/> Credit / Debit Card</label>
                <label class="ack-row" style="margin-bottom:12px"><input type="radio" name="payment_method" value="online" style="width:16px;height:16px"/> Online Payment</label>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <a href="#" onclick="history.back();return false;" class="spc-btn-prev">PREVIOUS</a>
            <button type="submit" class="spc-btn-next">SUBMIT APPLICATION</button>
        </div>
    </form>
</div>
</div>
</body></html>
</template>

</data>
