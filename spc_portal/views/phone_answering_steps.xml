<script>//<![CDATA[
function paValidateStep1() {
  var valid = true;
  function showErr(id, msg) {
    var el = document.getElementById(id);
    if (el) { el.textContent = msg; el.style.display = 'block'; }
  }
  function hideErr(id) {
    var el = document.getElementById(id);
    if (el) el.style.display = 'none';
  }

  // Company Name - min 10, max 50
  var company = document.querySelector('[name="company_brand_name"]');
  var cv = company ? company.value.trim() : '';
  if (cv.length < 10 || cv.length > 50) { showErr('company_err', 'Company name must be 10-50 characters.'); valid = false; } else hideErr('company_err');

  // First Name - min 2, max 50
  var fn = document.querySelector('[name="contact_first_name"]');
  var fnv = fn ? fn.value.trim() : '';
  if (fnv.length < 2 || fnv.length > 50 || !/^[A-Za-z ]+$/.test(fnv)) { showErr('fn_err', 'First name must be 2-50 characters (letters only).'); valid = false; } else hideErr('fn_err');

  // Last Name - min 2, max 50
  var ln = document.querySelector('[name="contact_last_name"]');
  var lnv = ln ? ln.value.trim() : '';
  if (lnv.length < 2 || lnv.length > 50 || !/^[A-Za-z ]+$/.test(lnv)) { showErr('ln_err', 'Last name must be 2-50 characters (letters only).'); valid = false; } else hideErr('ln_err');

  // Phone - exactly 15 digits
  var ph = document.querySelector('[name="contact_phone"]');
  var phv = ph ? ph.value.trim() : '';
  if (phv.length < 10 || phv.length > 15 || !/^[0-9]+$/.test(phv)) { showErr('ph_err', 'Phone number must be 10-15 digits.'); valid = false; } else hideErr('ph_err');

  // Preferred Greeting - min 10, max 1000
  var greet = document.querySelector('[name="preferred_greeting"]');
  var gv = greet ? greet.value.trim() : '';
  if (gv.length < 10 || gv.length > 1000) { showErr('greet_err', 'Preferred greeting must be 10-1000 characters.'); valid = false; } else hideErr('greet_err');

  // Call Instructions - min 5, max 500
  var call = document.querySelector('[name="call_instructions"]');
  var callv = call ? call.value.trim() : '';
  if (callv.length < 5 || callv.length > 500) { showErr('call_err', 'Call instructions must be 5-500 characters.'); valid = false; } else hideErr('call_err');

  // Address Line 1 - min 15, max 100
  var addr1 = document.querySelector('[name="address_line1"]');
  var a1v = addr1 ? addr1.value.trim() : '';
  if (a1v.length < 15 || a1v.length > 100) { showErr('addr1_err', 'Address line 1 must be 15-100 characters.'); valid = false; } else hideErr('addr1_err');

  // Address Line 2 - min 15, max 100
  var addr2 = document.querySelector('[name="address_line2"]');
  var a2v = addr2 ? addr2.value.trim() : '';
  if (a2v.length < 15 || a2v.length > 100) { showErr('addr2_err', 'Address line 2 must be 15-100 characters.'); valid = false; } else hideErr('addr2_err');

  // City - min 3, max 50
  var city = document.querySelector('[name="city"]');
  var cityv = city ? city.value.trim() : '';
  if (cityv.length < 3 || cityv.length > 50) { showErr('city_err', 'City must be 3-50 characters.'); valid = false; } else hideErr('city_err');

  // Email
  var em = document.querySelector('[name="contact_email"]');
  var emv = em ? em.value.trim() : '';
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emv)) { showErr('email_err', 'Please enter a valid email address.'); valid = false; } else hideErr('email_err');

  // Country - required
  var country = document.querySelector('[name="country"]');
  var countryv = country ? country.value.trim() : '';
  if (!countryv) { showErr('country_err', 'Please select a country.'); valid = false; } else hideErr('country_err');

  if (valid) document.querySelector('form').submit();
}

