                    <button name="action_approve_documents" string="Approve Documents" type="object" class="btn-primary" invisible="state not in ['submitted','in_review']"/>
                    <button name="action_approve_payment" string="Payment Approval" type="object" class="btn-primary" invisible="state != 'documents_approved'"/>
                    <button name="action_approve_complaints" string="Complaints" type="object" class="btn-primary" invisible="state != 'payment_approved'"/>
                    <button name="action_under_process" string="Under Process" type="object" class="btn-primary" invisible="state != 'complaints_approved'"/>
                    <button name="action_completed" string="Completed Application" type="object" class="btn-success" invisible="state != 'under_process'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'in_review'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state not in ['submitted','in_review']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Document Types">
                            <field name="doc_type_individual"/>
                            <field name="doc_type_commercial"/>
                            <field name="doc_type_invoice"/>
                            <field name="origin_country_id"/>
                        </group>
                        <group string="Counts">
                            <field name="individual_doc_count"/>
                            <field name="commercial_doc_count"/>
                            <field name="invoice_doc_count"/>
