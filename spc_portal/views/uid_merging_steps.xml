<script>//<![CDATA[
var PHONE_CODES=[
  {c:'+971',n:'AE +971'},{c:'+91',n:'IN +91'},{c:'+1',n:'US +1'},
  {c:'+44',n:'GB +44'},{c:'+92',n:'PK +92'},{c:'+880',n:'BD +880'},
  {c:'+63',n:'PH +63'},{c:'+966',n:'SA +966'},{c:'+974',n:'QA +974'},
  {c:'+965',n:'KW +965'},{c:'+973',n:'BH +973'},{c:'+968',n:'OM +968'},
  {c:'+962',n:'JO +962'},{c:'+20',n:'EG +20'},{c:'+90',n:'TR +90'},
  {c:'+86',n:'CN +86'},{c:'+81',n:'JP +81'},{c:'+60',n:'MY +60'},
  {c:'+65',n:'SG +65'},{c:'+94',n:'LK +94'},{c:'+977',n:'NP +977'},
  {c:'+61',n:'AU +61'},{c:'+27',n:'ZA +27'},{c:'+234',n:'NG +234'}
];
function onEmployeeChange(val){
  document.getElementById('manualEmployee').style.display = val==='manual'?'block':'none';
}
(function(){
  var sel=document.getElementById('phoneCodeSel');
  if(!sel) return;
  PHONE_CODES.forEach(function(cc){
    var o=document.createElement('option');
    o.value=cc.c; o.textContent=cc.n;
    if(cc.c==='+971') o.selected=true;
    sel.appendChild(o);
  });
})();
function uidStep1Validate(){
  var valid=true;
  function addErr(f,id,msg){
    if(!document.getElementById(id)){var e=document.createElement("div");e.id=id;e.style.cssText="color:red;font-size:12px;margin-top:4px";f.insertAdjacentElement("afterend",e);}
    if(msg){document.getElementById(id).textContent=msg;document.getElementById(id).style.display="block";}
    else{var el=document.getElementById(id);if(el)el.style.display="none";}
  }
  var fn=document.getElementsByName('first_name')[0];
  if(!fn||fn.value.trim().length<2){addErr(fn,"uid_fn_err","First name is required.");valid=false;}else addErr(fn,"uid_fn_err","");
  var ln=document.getElementsByName('last_name')[0];
  if(!ln||ln.value.trim().length<2){addErr(ln,"uid_ln_err","Last name is required.");valid=false;}else addErr(ln,"uid_ln_err","");
  var em=document.getElementsByName('email')[0];
  var emRe=/^[^@]+@[^@]+[.][^@]+$/;
  if(!em||!emRe.test(em.value.trim())){addErr(em,"uid_em_err","Please enter a valid email.");valid=false;}else addErr(em,"uid_em_err","");
  var dob=document.getElementsByName('date_of_birth')[0];
  if(!dob||!dob.value){addErr(dob,"uid_dob_err","Please select date of birth.");valid=false;}else addErr(dob,"uid_dob_err","");
  var pf=document.getElementById('passportFile');
  if(!pf||pf.files.length===0){addErr(pf,"uid_pf_err","Please upload passport copy.");valid=false;}else addErr(pf,"uid_pf_err","");
  if(valid) document.querySelector("form").submit();
}

//
//]]>
</script>
