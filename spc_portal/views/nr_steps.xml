<!-- NR Step 2: Company Name -->
<template id="template_nr_step2" name="NR Step2 Company Name">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Company Name | SPC Free Zone</title>
    <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;color:#333}
.layout{display:flex;min-height:100vh}
.sidebar{width:260px;background:#1a2340;color:#fff;padding:32px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto}
.sidebar-logo{font-size:22px;font-weight:700;margin-bottom:32px}
.sidebar-logo span{display:block;font-size:12px;font-weight:400;opacity:.6}
.progress-title{font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:16px}
.progress-step{display:flex;align-items:center;gap:10px;margin-bottom:12px;opacity:.5}
.progress-step.active{opacity:1}
.progress-step.done{opacity:.8}
.step-num{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.progress-step.active .step-num{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-num{background:#fff;color:#1a2340;border-color:#fff}
.step-label{font-size:13px}
.total-box{margin-top:24px;font-size:12px;opacity:.7}
.total-box .amount{font-size:20px;font-weight:700;opacity:1;color:#fff}
.sidebar-links{margin-top:24px}
.sidebar-links a{display:block;color:#fff;font-size:12px;text-decoration:underline;margin-bottom:8px;opacity:.8}
.main{margin-left:260px;padding:40px 48px;min-height:100vh}
.form-title{font-size:26px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.spc-section{background:#fff;border-radius:12px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:24px;display:flex;gap:24px}
.sec-num{font-size:13px;color:#aaa;font-weight:600;min-width:24px}
.sec-body{flex:1}
.sec-title{font-size:16px;font-weight:700;color:#1a2340;margin-bottom:6px}
.sec-sub{font-size:13px;color:#888;margin-bottom:16px}
.field-input{width:100%;max-width:500px;padding:10px 0;border:none;border-bottom:1px solid #ccc;background:transparent;font-size:14px;color:#333;outline:none;display:block;margin-bottom:16px}
.field-input:focus{border-bottom-color:#1abc9c}
.radio-group{display:flex;gap:20px;flex-wrap:wrap;margin-top:8px}
.radio-label{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer}
.radio-label input{accent-color:#1a2340}
.note-box{background:#fff8f0;border:1px solid #f0d9b5;border-radius:8px;padding:16px;margin-top:16px;font-size:13px;line-height:1.6;max-width:600px}
.note-info{display:flex;gap:10px;margin-top:8px}
.note-icon{color:#c8a951;font-size:18px;flex-shrink:0}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:16px}
.spc-btn-previous{border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:14px;font-weight:700;color:#1a2340;text-decoration:none}
.spc-btn-next{background:#e91e8c;color:#fff;border:none;border-radius:8px;padding:12px 48px;font-size:15px;font-weight:700;cursor:pointer}
    </style>
</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">K SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Business activities</div></div>
        <div class="progress-step active"><div class="step-num">2</div><div class="step-label">Company name</div></div>
        <div class="progress-step"><div class="step-num">3</div><div class="step-label">Declaration</div></div>
        <div class="progress-step"><div class="step-num">4</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">5</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">510.00 &#9432;</div></div>
        <div class="sidebar-links">
            <a href="#">SAVE &amp; CONTINUE LATER</a>
            <a href="#">CANCEL APPLICATION</a>
        </div>
    </div>
    <div class="main">
        <div class="form-title">Name Reservation - New</div>
        <form action="/spc/setup-new-company/apply/nr-step2/submit" method="post" id="nrStep2Form">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" t-att-value="service_type"/>

            <!-- Name Reserved? -->
            <div class="spc-section">
                <div class="sec-num">01</div>
                <div class="sec-body">
                    <div class="sec-title">Has a company name been reserved?</div>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="name_reserved" value="yes" onchange="toggleReserved('yes')"/> Yes</label>
                        <label class="radio-label"><input type="radio" name="name_reserved" value="no" checked="checked" onchange="toggleReserved('no')"/> No</label>
                    </div>
                    <div id="reserved_section" style="display:none;margin-top:16px">
                        <input type="text" class="field-input" name="reserved_name" placeholder="Reserved name"/>
                    </div>
                </div>
            </div>

            <!-- Proposed Names -->
            <div class="spc-section" id="proposed_section">
                <div class="sec-num">02</div>
                <div class="sec-body">
                    <div class="sec-title">Enter the proposed company name(s) in order of preference</div>
                    <input type="text" class="field-input" name="name_preference_1" placeholder="First preference"/>
                    <input type="text" class="field-input" name="name_preference_2" placeholder="Second preference"/>
                    <input type="text" class="field-input" name="name_preference_3" placeholder="Third preference"/>
                    <div class="note-box">
                        <p><strong>Please note:</strong></p>
                        <p>1. Company Names will appear as entered (same letter case) at the time of application.</p>
                        <p style="color:#c0392b;margin-top:10px;"><strong>The following words cannot be used as company names:</strong></p>
                        <div class="note-info">
                            <span class="note-icon">&#9432;</span>
                            <div>
                                <p>1. Sharjah, Dubai, Abu Dhabi, RAK, Ras Al Khaimah, Ajman, Fujairah, Umm Al Quwain, UAE, United Arab Emirates, Limited, LTD, Financial, CAT, Elite, Vehicles &amp; Hotels, Islam, Islamic, Bomb, Import, Export, Manufacturing, Shipping, Forwarding, Oil, Gas and Refinery.</p>
                                <p>2. Any animal names cannot be used.</p>
                                <p>3. Any words related to any religion cannot be used.</p>
                                <p>4. Any names indicating direct product such as food, beverages, Cars and Auto cannot be used.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Arabic Translation -->
            <div class="spc-section">
                <div class="sec-num">03</div>
                <div class="sec-body">
                    <div class="sec-title">Select the method of translating the company name into Arabic</div>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="direct"/> Direct translation</label>
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="phonetic"/> Phonetic sound</label>
                        <label class="radio-label"><input type="radio" name="arabic_translation" value="own"/> I will provide my own translations</label>
                    </div>
                </div>
            </div>

            <div class="spc-nav-buttons">
                <a t-att-href="'/spc/setup-new-company/apply/' + service_type" class="spc-btn-previous">PREVIOUS</a>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
<script>
<![CDATA[
function toggleReserved(val) {
    document.getElementById('reserved_section').style.display = val === 'yes' ? 'block' : 'none';
    document.getElementById('proposed_section').style.display = val === 'yes' ? 'none' : 'flex';
}
]]>
</script>
</body>
</html>
</template>

