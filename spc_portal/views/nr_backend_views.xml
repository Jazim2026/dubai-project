<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_spc_name_reservation_tree" model="ir.ui.view">
        <field name="name">spc.name.reservation.tree</field>
        <field name="model">spc.name.reservation</field>
        <field name="arch" type="xml">
            <tree string="Name Reservations">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="name_preference_1"/>
                <field name="name_preference_2"/>
                <field name="fee"/>
                <field name="payment_status"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_spc_name_reservation_form" model="ir.ui.view">
        <field name="name">spc.name.reservation.form</field>
        <field name="model">spc.name.reservation</field>
        <field name="arch" type="xml">
            <form string="Name Reservation">
                <header>
                    <button name="action_under_review" string="Mark Under Review" type="object"
                            invisible="state not in ['submitted']" class="btn-secondary"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state not in ['submitted','under_review']" class="btn-primary"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ['submitted','under_review']" class="btn-danger"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference"/></h1>
                    </div>
                    <group>
                        <group string="Customer Info">
                            <field name="customer_id"/>
                            <field name="fee"/>
                            <field name="payment_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business Activities">
                            <field name="business_activity_ids" widget="many2many_tags"/>
                            <field name="activity_names"/>
                        </page>
                        <page string="Company Name">
                            <group>
                                <field name="name_reserved"/>
                                <field name="reserved_name" invisible="name_reserved != 'yes'"/>
                                <field name="name_preference_1"/>
                                <field name="name_preference_2"/>
                                <field name="name_preference_3"/>
                                <field name="translation_method"/>
                            </group>
                        </page>
                        <page string="Declaration">
                            <group>
                                <field name="declaration_accepted"/>
                                <field name="declarant_name"/>
                                <field name="declaration_date"/>
                            </group>
                        </page>
                        <page string="Admin Notes">
                            <field name="admin_notes"/>
                            <field name="rejection_reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spc_name_reservation" model="ir.actions.act_window">
        <field name="name">Name Reservations</field>
        <field name="res_model">spc.name.reservation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_spc_name_reservation"
              name="Name Reservation"
              parent="menu_spc_applications"
              action="action_spc_name_reservation"
              sequence="20"/>

    <menuitem id="menu_spc_nr_cm_parent"
              name="Name Reservation"
              parent="menu_spc_company_management"
              sequence="50"/>
    <menuitem id="menu_spc_nr_cm_child"
              name="Name Reservation"
              parent="menu_spc_nr_cm_parent"
              action="action_spc_name_reservation"
              sequence="10"/>
</odoo>
