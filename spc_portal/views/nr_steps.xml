</head>
<body>
<div style="display:flex;min-height:100vh">
    <div class="sidebar">
        <div class="progress-logo"><span class="ps-diamond">&#9670;</span> K SPC</div>
        <div class="ps-subtitle">Free Zone</div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step"><div class="progress-step-num done">&#10003;</div><div class="progress-step-label">Business activities</div></div>
