        <button class="progress-save" style="color:#f87171">CANCEL APPLICATION</button>
    </div>
    <div class="main">
        <div class="form-title">Name Reservation - New</div>
        <form action="/spc/setup-new-company/apply/nr-step3/submit" method="post">
