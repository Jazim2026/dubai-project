<template id="template_rn_step3" name="SPC Setup Company Step 2 - Business Activities">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Business Activities | SPC Free Zone</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;color:#333}
.layout{display:flex;min-height:100vh}
.sidebar{width:260px;background:#1a2340;color:#fff;padding:32px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto}
.sidebar-logo{font-size:18px;font-weight:700;margin-bottom:8px}
.sidebar-logo span{display:block;font-size:11px;font-weight:400;opacity:.6}
.progress-title{font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:16px;margin-top:24px}
.progress-step{display:flex;align-items:center;gap:10px;margin-bottom:12px;opacity:.5}
.progress-step.active{opacity:1}.progress-step.done{opacity:.8}
.step-num{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.progress-step.active .step-num{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-num{background:#fff;color:#1a2340;border-color:#fff}
.progress-step-num{width:28px;height:28px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;color:#fff}
.progress-step-num.active{background:#1abc9c;border-color:#1abc9c}
.progress-step-num.done{background:#fff;color:#1a2340}
.progress-step-label{font-size:13px;color:#fff;opacity:.6}
.progress-step-label.active{opacity:1}
.step-label{font-size:13px}
.total-box{margin-top:24px;font-size:12px;opacity:.7}
.total-box .amount{font-size:20px;font-weight:700;opacity:1;color:#fff}
.main{margin-left:260px;padding:40px 48px;min-height:100vh}
.form-title{font-size:26px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.step-title{font-size:15px;font-weight:700;color:#1a2340;margin-bottom:8px}
.step-sub{font-size:13px;color:#888;margin-bottom:16px}
.search-wrap{position:relative;margin-bottom:16px;max-width:500px}
.search-bar{width:100%;padding:10px 40px 10px 16px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none}
.search-bar:focus{border-color:#1abc9c}
.search-icon{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#aaa}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tab{padding:6px 14px;border:1px solid #ddd;border-radius:20px;background:#fff;font-size:12px;cursor:pointer;color:#555}
.tab.active{background:#1a2340;color:#fff;border-color:#1a2340}
.divisions-wrap{max-width:800px;margin-bottom:24px}
.division-item{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;margin-bottom:8px}
.division-header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;cursor:pointer;background:#fafafa;font-size:14px;font-weight:600;color:#1a2340}
.division-body{display:none;padding:12px 16px;border-top:1px solid #e5e7eb}
.division-body.open{display:block}
.div-arrow{font-size:12px;color:#aaa}
.row-item{display:flex;align-items:flex-start;gap:8px;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:13px}
.row-item-left{display:flex;align-items:flex-start;gap:8px;flex:1}
.row-item input[type=checkbox]{width:15px;height:15px;margin-top:2px;accent-color:#1abc9c;flex-shrink:0}
.row-expand-btn{background:none;border:1px solid #ddd;border-radius:4px;padding:2px 8px;cursor:pointer;font-size:14px;color:#1a3c6e;margin-left:8px}
.sub-items{display:none;padding:8px 0 8px 24px}
.sub-items.open{display:block}
.sub-item-label{font-size:12px;color:#888;margin-bottom:6px}
.sub-activity{display:flex;align-items:flex-start;gap:8px;font-size:13px;padding:4px 0;cursor:pointer}
.sub-activity input{width:14px;height:14px;margin-top:2px;accent-color:#1abc9c}
.empty-state{text-align:center;padding:40px 20px}
.empty-icon{font-size:48px;margin-bottom:12px}
.empty-text{font-size:16px;font-weight:600;color:#1a2340;margin-bottom:6px}
.empty-sub{font-size:13px;color:#888}
.sidebar-links{margin-top:16px}
.sidebar-links a,.sidebar-links span{display:block;color:rgba(255,255,255,.6);font-size:11px;margin-bottom:6px}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:32px;gap:16px}
.spc-btn-prev{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
.spc-btn-next{background:#1abc9c;color:#fff;border:none;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div style="padding-top:16px;border-top:1px solid rgba(255,255,255,.15)">
        <div class="progress-title">Your progress</div>
        <t t-foreach="steps" t-as="step">
            <div class="progress-step">
                <t t-if="step_index + 1 == current_step">
                    <div class="progress-step-num active"><t t-esc="step_index + 1"/></div>
                    <div class="progress-step-label active"><t t-esc="step"/></div>
                </t>
                <t t-elif="step_index + 1 &lt; current_step">
                    <div class="progress-step-num done">&#10003;</div>
                    <div class="progress-step-label"><t t-esc="step"/></div>
                </t>
                <t t-else="">
                    <div class="progress-step-num"><t t-esc="step_index + 1"/></div>
                    <div class="progress-step-label"><t t-esc="step"/></div>
                </t>
            </div>
        </t>
    </div>
    <div class="total-box">
        <div style="font-size:11px;opacity:.6;margin-bottom:2px">Total</div>
        <div style="font-size:11px;opacity:.6">AED</div>
        <div style="font-size:20px;font-weight:700"><t t-esc="'%.2f' % (fee or 0)"/> <span style="font-size:14px">&#9432;</span></div>
    </div>
    <a href="/spc/setup-new-company" style="color:white;font-size:11px;text-decoration:underline;display:block;margin-top:14px;opacity:.8">SAVE &amp; CONTINUE LATER</a>
</div>

<div class="main">
    <t t-if="form_submit_url">
        <input type="hidden" id="custom_submit_url" t-att-value="form_submit_url"/>
    </t>
    <t t-if="form_submit_url">
        <input type="hidden" id="custom_submit_url" t-att-value="form_submit_url"/>
    </t>
    <div class="form-title">Renewal only</div>
    <div class="step-label">01</div>
    <div class="step-title">Select business activity(s)</div>
    <div class="step-sub">What business activity(s) will the company practice?</div>

    <div class="search-wrap">
        <input type="text" class="search-bar" id="activitySearch" placeholder="Search by keyword" oninput="filterActivities(this.value)"/>
        <span class="search-icon">&#128269;</span>
    </div>

    <div class="tabs" id="tabsRow">
        <button class="tab active" onclick="filterByTab('',this)">All</button>
        <button class="tab" onclick="filterByTab('publishing_media',this)">Publishing and Media</button>
        <button class="tab" onclick="filterByTab('wholesale_retail',this)">Wholesale and Retail</button>
        <button class="tab" onclick="filterByTab('services_consultancy',this)">Services and Consultancy</button>
        <button class="tab" onclick="filterByTab('electronic_publishing',this)">Electronic Publishing</button>
        <button class="tab" onclick="filterByTab('real_publishing',this)">Real Publishing</button>
    </div>

    <div class="divisions-wrap" id="divisionsWrap">
        <div class="empty-tab-msg" id="emptyTabMsg">Select a category tab to view activities.</div>

        <t t-foreach="categories" t-as="cat">
            <t t-set="cat_data" t-value="activities_data.get(cat[0], {})"/>
            <t t-foreach="cat_data.get('divisions', {}).items()" t-as="div_item">
                <t t-set="div_name" t-value="div_item[0]"/>
                <t t-set="div_acts" t-value="div_item[1]"/>
                <div class="division-item" t-att-data-cat="cat[0]" style="display:none">
                    <div class="division-header" onclick="toggleDivision(this)">
                        <span><t t-esc="div_name"/></span>
                        <span class="div-arrow">&#8964;</span>
                    </div>
                    <div class="division-body">
                        <t t-foreach="div_acts" t-as="act">
                            <!-- Check if this is a parent code (no dot) or child (has dot) -->
                            <t t-if="'.' not in act['code']">
                                <!-- Parent row - heading style or expandable -->
                                <t t-set="child_prefix" t-value="act['code'] + '.'"/>
                                <t t-set="has_children" t-value="any(child_prefix in a['code'] for a in div_acts)"/>
                                <div class="row-item" t-att-data-parent="act['code']">
                                    <div class="row-item-left">
                                        <input type="checkbox" t-att-value="act['name']" t-att-id="'cb_' + act['code']" onchange="updateSelected(this)"/>
                                        <label t-att-for="'cb_' + act['code']" style="cursor:pointer;font-weight:600"><t t-esc="act['name']"/></label>
                                    </div>
                                    <t t-if="has_children">
                                        <button type="button" class="row-expand-btn" t-attf-onclick="toggleSub('#{act['code']}', this)" title="Expand">+</button>
                                    </t>
                                </div>
                                <t t-if="has_children">
                                    <div class="sub-items" t-att-id="'sub_' + act['code']">
                                        <div class="sub-item-label">This class includes:</div>
                                        <t t-foreach="div_acts" t-as="child">
                                            <t t-if="child['code'].startswith(child_prefix)">
                                                <label class="sub-activity">
                                                    <input type="checkbox" t-att-value="child['name']" onchange="updateSelected(this)"/>
                                                    <span><t t-esc="child['name']"/></span>
                                                </label>
                                            </t>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </div>

    <div class="step-label" style="margin-top:40px">02</div>
    <div class="step-title" style="margin-bottom:16px">List of business activity(s) selected</div>
    <div id="emptyState" class="empty-state">
        <div class="empty-icon">&#127881;</div>
        <div class="empty-text">Woohoo!</div>
        <div class="empty-sub">No Activity selected yet.</div>
    </div>
    <div id="selectedList" style="display:none;background:white;border-radius:8px;border:1px solid #e5e7eb;overflow:hidden;margin-bottom:20px"></div>

    <div class="sidebar-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS</a>
        <span>&#169; SPC 2026</span>
    </div>
</div>
</div>
<div class="main">
<div class="spc-nav-buttons">
    <button class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
    <button class="spc-btn-next" onclick="validateStep2()">NEXT</button>
</div>
</div>

<script>
var selectedActivities = [];

function toggleDivision(header) {
    var body = header.nextElementSibling;
    var arrow = header.querySelector('.div-arrow');
    var isOpen = body.classList.contains('open');
    body.classList.toggle('open', !isOpen);
    arrow.innerHTML = isOpen ? '&#8964;' : '&#8963;';
}

function toggleSub(code, btn) {
    var sub = document.getElementById('sub_' + code);
    if (!sub) return;
    var isOpen = sub.classList.contains('open');
    sub.classList.toggle('open', !isOpen);
    btn.textContent = isOpen ? '+' : '-';
    btn.style.color = isOpen ? '#1a3c6e' : '#e91e8c';
}

function updateSelected(cb) {
    var val = cb.value;
    if (cb.checked) {
        if (!selectedActivities.includes(val)) selectedActivities.push(val);
    } else {
        selectedActivities = selectedActivities.filter(function(a){ return a !== val; });
    }
    renderSelected();
}

function renderSelected() {
    var empty = document.getElementById('emptyState');
    var list = document.getElementById('selectedList');
    if (selectedActivities.length === 0) {
        empty.style.display = 'block';
        list.style.display = 'none';
    } else {
        empty.style.display = 'none';
        list.style.display = 'block';
        list.innerHTML = selectedActivities.map(function(a) {
            return '<div style="padding:12px 20px;border-bottom:1px solid #f3f4f6;display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#374151">' +
                '<span>' + a + '</span>' +
                '<button onclick="removeActivity(this)" data-val="' + encodeURIComponent(a) + '" style="background:none;border:none;color:#9ca3af;cursor:pointer;font-size:20px;line-height:1">&#215;</button>' +
                '</div>';
        }).join('');
    }
}

function removeActivityByName(name) {
    selectedActivities = selectedActivities.filter(function(a){ return a !== name; });
    document.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
        if (cb.value === name) cb.checked = false;
    });
    renderSelected();
}

function filterActivities(q) {
    q = q.toLowerCase();
    document.querySelectorAll('.division-item').forEach(function(div) {
        div.style.display = div.textContent.toLowerCase().includes(q) ? 'block' : 'none';
    });
    document.getElementById('emptyTabMsg').style.display = 'none';
}

function filterByTab(cat, btn) {
    document.querySelectorAll('.tab').forEach(function(t){ t.classList.remove('active'); });
    btn.classList.add('active');
    var msg = document.getElementById('emptyTabMsg');
    if (!cat) {
        document.querySelectorAll('.division-item').forEach(function(d){ d.style.display = 'none'; });
        msg.style.display = 'block';
    } else {
        msg.style.display = 'none';
        document.querySelectorAll('.division-item').forEach(function(d){
            d.style.display = d.getAttribute('data-cat') === cat ? 'block' : 'none';
        });
    }
}

function validateStep2() {
    if (selectedActivities.length === 0) {
        var err = document.createElement('div');
        err.style.cssText = 'position:fixed;top:24px;left:50%;transform:translateX(-50%);background:#fff;border:1.5px solid #e91e8c;border-radius:10px;padding:14px 28px;font-size:14px;color:#e91e8c;font-weight:600;box-shadow:0 8px 32px rgba(233,30,140,.15);z-index:99999;display:flex;align-items:center;gap:10px';
        err.innerHTML = '&#9888; Please select at least one business activity.';
        document.body.appendChild(err);
        setTimeout(function(){ if(err.parentElement) err.remove(); }, 3000);
        return;
    }
    var serviceType = window.location.pathname.split('/').pop();
    // Submit via form POST to save to session
    var form = document.createElement('form');
    form.method = 'POST';
    var submitUrl = '/spc/company-management/apply/rn-step3/submit';
    var customUrlInput = document.getElementById('custom_submit_url');
    if (customUrlInput &amp;&amp; customUrlInput.value) { submitUrl = customUrlInput.value; }
    
    
    form.action = submitUrl;
    // CSRF token
    var csrf = document.createElement('input');
    csrf.type = 'hidden';
    csrf.name = 'csrf_token';
    csrf.value = document.querySelector('meta[name="csrf_token"]') ?
        document.querySelector('meta[name="csrf_token"]').content : '';
    form.appendChild(csrf);
    // service_type
    var st = document.createElement('input');
    st.type = 'hidden';
    st.name = 'service_type';
    st.value = serviceType;
    form.appendChild(st);
    // Add each selected activity
    selectedActivities.forEach(function(act) {
        var inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'business_activities';
        inp.value = act;
        form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
}
</script>
</body>
</html>
</template>


<!-- ══ RENEWAL WITH AMENDMENT TEMPLATES ══ -->

<!-- RA Step 1: Company Selection -->
<template id="template_ra_step1" name="RA Step1 Company Selection">
<html>
<head><meta charset="utf-8"/><title>Company Selection | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>

</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step active"><div class="step-num">1</div><div class="step-label">Company</div></div>
        <div class="progress-step"><div class="step-num">2</div><div class="step-label">Renewal type</div></div>
        <div class="progress-step"><div class="step-num">3</div><div class="step-label">Legal type</div></div>
        <div class="progress-step"><div class="step-num">4</div><div class="step-label">Business activities</div></div>
        <div class="progress-step"><div class="step-num">5</div><div class="step-label">Shareholder(s)</div></div>
        <div class="progress-step"><div class="step-num">6</div><div class="step-label">Manager(s)</div></div>
        <div class="progress-step"><div class="step-num">7</div><div class="step-label">Director(s)</div></div>
        <div class="progress-step"><div class="step-num">8</div><div class="step-label">UBO</div></div>
        <div class="progress-step"><div class="step-num">9</div><div class="step-label">Nature of business</div></div>
        <div class="progress-step"><div class="step-num">10</div><div class="step-label">Supporting documents</div></div>
        <div class="progress-step"><div class="step-num">11</div><div class="step-label">Review application</div></div>
        <div class="progress-step"><div class="step-num">12</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">10.00 &#9432;</div></div>
        <div class="sidebar-links">
            <a href="#">SAVE &amp; CONTINUE LATER</a>
            <a href="#">CANCEL APPLICATION</a>
        </div>
    </div>
    <div class="main">
        <div class="form-title">Renewal with Amendment</div>
        <form action="/spc/company-management/apply/ra-step1/submit" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" value="renewal_amendment"/>
            <input type="hidden" name="company_id" id="ra_hidden_company_id"/>
            <input type="hidden" name="company_name" id="ra_hidden_company_name"/>
            <div class="spc-section">
                <div class="sec-num">01</div>
                <div class="sec-body">
                    <div class="sec-title">Select company</div>
                    <div class="toggle-bar">
                        <button type="button" class="toggle-btn active" id="ra-btn-list" onclick="raShowList()">Select from list</button>
                        <button type="button" class="toggle-btn inactive" id="ra-btn-manual" onclick="raShowManual()">Enter manually</button>
                    </div>
                    <div id="ra-div-list">
                        <div class="select-wrap">
                            <select name="company_id_select" onchange="raSetCompany(this)">
                                <option value="">Select company</option>
                                <t t-foreach="companies" t-as="company">
                                    <option t-att-value="company['id']" t-att-data-name="company['name']"><t t-esc="company['name']"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="info-box">&#9432; Making a selection here will auto-fill the fields with information from the initial application whenever available. Please verify and update the data as needed.</div>
                    </div>
                    <div id="ra-div-manual" style="display:none">
                        <input type="text" class="field-input" id="ra-manual-input" placeholder="Enter company name manually"/>
                    </div>
                </div>
            </div>
            <div class="spc-nav-buttons">
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
<script>
function raShowList() {
    document.getElementById('ra-div-list').style.display = 'block';
    document.getElementById('ra-div-manual').style.display = 'none';
    document.getElementById('ra-btn-list').className = 'toggle-btn active';
    document.getElementById('ra-btn-manual').className = 'toggle-btn inactive';
}
function raShowManual() {
    document.getElementById('ra-div-list').style.display = 'none';
    document.getElementById('ra-div-manual').style.display = 'block';
    document.getElementById('ra-btn-manual').className = 'toggle-btn active';
    document.getElementById('ra-btn-list').className = 'toggle-btn inactive';
}
function raSetCompany(sel) {
    var opt = sel.options[sel.selectedIndex];
    document.getElementById('ra_hidden_company_id').value = opt.value || '';
    document.getElementById('ra_hidden_company_name').value = opt.getAttribute('data-name') || '';
}
document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function() {
            var manualDiv = document.getElementById('ra-div-manual');
            if (manualDiv &amp;&amp; manualDiv.style.display !== 'none') {
                document.getElementById('ra_hidden_company_id').value = '';
                document.getElementById('ra_hidden_company_name').value = document.getElementById('ra-manual-input').value;
            }
        });
    }
});
</script>
</body>
</html>
</template>

<!-- RA Step 2: Renewal Type -->
<template id="template_ra_step2" name="RA Step2 Renewal Type">
<html>
<head><meta charset="utf-8"/><title>Renewal Type | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>

</head>
<body>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
        <div class="progress-title">Your progress</div>
        <div class="progress-step done"><div class="step-num">&#10003;</div><div class="step-label">Company</div></div>
        <div class="progress-step active"><div class="step-num">2</div><div class="step-label">Renewal type</div></div>
        <div id="sidebar-dynamic-steps"></div>
        <div class="progress-step" id="sidebar-step-supporting"><div class="step-num" id="sidebar-num-supporting">3</div><div class="step-label">Supporting documents</div></div>
        <div class="progress-step" id="sidebar-step-review"><div class="step-num" id="sidebar-num-review">4</div><div class="step-label">Review application</div></div>
        <div class="progress-step" id="sidebar-step-payment"><div class="step-num" id="sidebar-num-payment">5</div><div class="step-label">Payment</div></div>
        <div class="total-box">Total AED<div class="amount">10.00 &#9432;</div></div>
    </div>
    <div class="main">
        <div class="form-title">Renewal with Amendment</div>
        <form action="/spc/company-management/apply/ra-step2/submit" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="service_type" value="renewal_amendment"/>
            <!-- Section 01 -->
            <div class="spc-section">
                <div class="sec-row">
                    <div class="sec-num">01</div>
                    <div class="sec-body">
                        <div class="sec-title">Is the renewal with or without an amendment</div>
                        <label class="radio-label"><input type="radio" name="renewal_type" value="with_amendment" checked="checked"/> Renewal with amendment</label>
                    </div>
                </div>
            </div>
            <!-- Section 02 -->
            <div class="spc-section">
                <div class="sec-row">
                    <div class="sec-num">02</div>
                    <div class="sec-body">
                        <div class="sec-title">Select the type of amendment(s) and upload board resolution</div>
                        <p style="font-size:13px;color:#888;margin-bottom:16px">What needs to be amended?</p>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_formation_package" value="yes"/> <span>Formation Package</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_legal_type" value="yes"/> <span>Legal type</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_business_activities" value="yes"/> <span>Business Activities</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_company_info" value="yes"/> <span>Company information</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_capital_structure" value="yes"/> <span>Capital structure</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_visa_allocation" value="yes"/> <span>Visa allocation upgrade/downgrade</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_facility_type" value="yes"/> <span>Facility type</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_shareholder" value="yes"/> <span>Edit/ add/ remove Shareholder</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_manager" value="yes"/> <span>Edit/ add/ remove Manager</span></label>
                        <label class="checkbox-label"><input type="checkbox" name="amendment_director" value="yes"/> <span>Edit/ add/ remove Director</span></label>
                    </div>
                </div>
            </div>
            <!-- Section 03: Upload -->
            <div class="spc-section">
                <div class="sec-row">
                    <div class="sec-num">03</div>
                    <div class="sec-body">
                        <div class="sec-title">Upload required document</div>
                        <p style="font-size:13px;color:#555;margin-bottom:12px;font-weight:600">Board resolution</p>
                        <div class="upload-label">Board resolution</div>
                        <div class="upload-box" onclick="document.getElementById('boardResUpload').click()">
                            <input type="file" id="boardResUpload" name="board_resolution" accept=".pdf,.jpg,.jpeg,.png" style="display:none" onchange="showUploadName(this,'boardResName')"/>
                            <div class="upload-icon">&#11014;</div>
                            <div class="upload-text">Upload document</div>
                        </div>
                        <div id="boardResName" style="font-size:12px;color:#1abc9c;margin-top:4px"></div>
                        <p style="font-size:13px;color:#1abc9c;margin-top:8px;font-style:italic">'You can download the requested Board Resolution <a href="#" style="color:#1abc9c">here</a>'</p>
                        <ul class="info-list">
                            <li>The resolution must be signed by all authorized individuals (all shareholders).</li>
                            <li>The wording of the resolution clauses must not be altered under any circumstances.</li>
                            <li>The resolution must be typed on the official company letterhead.</li>
                            <li>All names, passport numbers, and nationalities must exactly match the official documents.</li>
                            <li>The final document must be fully completed, printed, and stamped using accepted methods.</li>
                        </ul>
                        <div class="ack-box" style="margin-top:16px">
                            <p style="font-size:13px;color:#555;font-weight:600;margin-bottom:10px">Acknowledgement</p>
                            <label style="display:flex;align-items:flex-start;gap:10px;font-size:13px;cursor:pointer">
                                <input type="checkbox" name="acknowledgement" value="yes" style="margin-top:2px;width:16px;height:16px;accent-color:#1a2340;flex-shrink:0" required="required"/>
                                <span>I confirm that I have read and understood all of the above requirements and will ensure full compliance.</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="spc-nav-buttons">
                <button type="button" class="spc-btn-previous" onclick="window.history.back()">PREVIOUS</button>
                <button type="submit" class="spc-btn-next">NEXT</button>
            </div>
        </form>
    </div>
</div>
<script type="text/javascript">/*<![CDATA[*/
var AMENDMENT_MAP = [
    {name: "amendment_legal_type", label: "Legal type"},
    {name: "amendment_business_activities", label: "Business activities"},
    {name: "amendment_company_info", label: "Company information"},
    {name: "amendment_capital_structure", label: "Nature of business"},
    {name: "amendment_visa_allocation", label: "Visa allocation"},
    {name: "amendment_facility_type", label: "Facility type"},
    {name: "amendment_shareholder", label: "Shareholder(s)"},
    {name: "amendment_manager", label: "Manager(s)"},
    {name: "amendment_director", label: "Director(s)"}
];
function updateSidebar() {
    var selected = AMENDMENT_MAP.filter(function(a) {
        var cb = document.querySelector('input[name="' + a.name + '"]');
        return cb && cb.checked;
    });
    var container = document.getElementById('sidebar-dynamic-steps');
    if (!container) return;
    container.innerHTML = '';
    var stepNum = 3;
    selected.forEach(function(a) {
        var div = document.createElement('div');
        div.className = 'progress-step';
        div.innerHTML = '<div class="step-num">' + stepNum + '</div><div class="step-label">' + a.label + '</div>';
        container.appendChild(div);
        stepNum++;
    });
    var sn = document.getElementById('sidebar-num-supporting');
    var rn = document.getElementById('sidebar-num-review');
    var pn = document.getElementById('sidebar-num-payment');
    if (sn) sn.textContent = stepNum;
    if (rn) rn.textContent = stepNum + 1;
    if (pn) pn.textContent = stepNum + 2;
}
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[type=checkbox]').forEach(function(cb) {
        cb.addEventListener('change', updateSidebar);
    });
    updateSidebar();
});
/*]]>*/</script>
</body>
</html>
</template>


<!-- RA Step 3: Legal Type -->
<template id="template_ra_step3" name="RA Step3 Legal Type">
<html><head><meta charset="utf-8"/><title>Legal Type | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num"><t t-if="snum &lt; current_step">&#10003;</t><t t-else=""><t t-esc="snum"/></t></div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" action="/spc/company-management/apply/ra-step3/submit">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Select the legal type</div>
                <div class="legal-options">
                    <label class="legal-card selected" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="fze" checked="checked" style="display:none"/>
                        <div class="legal-card-title">Free Zone Establishment</div>
                        <div class="legal-card-sub">1 Shareholder (Limited Liability Company)</div>
                    </label>
                    <label class="legal-card" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="fzc"/>
                        <div class="legal-card-title">Free Zone Company</div>
                        <div class="legal-card-sub">Multiple shareholders (Limited Liability Company)</div>
                    </label>
                    <label class="legal-card" onclick="selectCard(this)">
                        <input type="radio" name="legal_type" value="branch"/>
                        <div class="legal-card-title">Branch</div>
                    </label>
                </div>
            </div>
        </div>
        <div class="spc-section">
            <div class="sec-num">02</div>
            <div class="sec-body">
                <div class="sec-title">Select package type</div>
                <div class="package-options">
                    <label class="pkg-label"><input type="radio" name="package_type" value="Standard" checked="checked"/> Standard</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Publishing"/> Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="E-Publishing"/> E-Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - Standard"/> Instant License - Standard</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - Publishing"/> Instant License - Publishing</label>
                    <label class="pkg-label"><input type="radio" name="package_type" value="Instant License - E-Publishing"/> Instant License - E-Publishing</label>
                </div>
                <div class="info-box">&#9432; For more details on our business setup packages, click <a href="#">here</a></div>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script>
function selectCard(el){
    document.querySelectorAll('.legal-card').forEach(function(c){c.classList.remove('selected')});
    el.classList.add('selected');
    el.querySelector('input[type=radio]').checked = true;
}
</script>
</body></html>
</template>

<!-- RA Step 4: Business Activities -->
<template id="template_ra_step4" name="RA Step4 Business Activities">
<html>
<head>
    <meta charset="utf-8"/>
    <title>Business Activities | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f6fa;color:#333}
.layout{display:flex;min-height:100vh}
.sidebar{width:260px;background:#1a2340;color:#fff;padding:32px 20px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto}
.sidebar-logo{font-size:18px;font-weight:700;margin-bottom:8px}
.sidebar-logo span{display:block;font-size:11px;font-weight:400;opacity:.6}
.progress-title{font-size:11px;text-transform:uppercase;letter-spacing:1px;opacity:.5;margin-bottom:16px;margin-top:24px}
.progress-step{display:flex;align-items:center;gap:10px;margin-bottom:12px;opacity:.5}
.progress-step.active{opacity:1}.progress-step.done{opacity:.8}
.step-num{width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
.progress-step.active .step-num{background:#1abc9c;border-color:#1abc9c}
.progress-step.done .step-num{background:#fff;color:#1a2340;border-color:#fff}
.progress-step-num{width:28px;height:28px;border-radius:50%;border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;color:#fff}
.progress-step-num.active{background:#1abc9c;border-color:#1abc9c}
.progress-step-num.done{background:#fff;color:#1a2340}
.progress-step-label{font-size:13px;color:#fff;opacity:.6}
.progress-step-label.active{opacity:1}
.step-label{font-size:13px}
.total-box{margin-top:24px;font-size:12px;opacity:.7}
.total-box .amount{font-size:20px;font-weight:700;opacity:1;color:#fff}
.main{margin-left:260px;padding:40px 48px;min-height:100vh}
.form-title{font-size:26px;font-weight:700;color:#1abc9c;margin-bottom:28px}
.step-title{font-size:15px;font-weight:700;color:#1a2340;margin-bottom:8px}
.step-sub{font-size:13px;color:#888;margin-bottom:16px}
.search-wrap{position:relative;margin-bottom:16px;max-width:500px}
.search-bar{width:100%;padding:10px 40px 10px 16px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none}
.search-bar:focus{border-color:#1abc9c}
.search-icon{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#aaa}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tab{padding:6px 14px;border:1px solid #ddd;border-radius:20px;background:#fff;font-size:12px;cursor:pointer;color:#555}
.tab.active{background:#1a2340;color:#fff;border-color:#1a2340}
.divisions-wrap{max-width:800px;margin-bottom:24px}
.division-item{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;margin-bottom:8px}
.division-header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;cursor:pointer;background:#fafafa;font-size:14px;font-weight:600;color:#1a2340}
.division-body{display:none;padding:12px 16px;border-top:1px solid #e5e7eb}
.division-body.open{display:block}
.div-arrow{font-size:12px;color:#aaa}
.row-item{display:flex;align-items:flex-start;gap:8px;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:13px}
.row-item-left{display:flex;align-items:flex-start;gap:8px;flex:1}
.row-item input[type=checkbox]{width:15px;height:15px;margin-top:2px;accent-color:#1abc9c;flex-shrink:0}
.row-expand-btn{background:none;border:1px solid #ddd;border-radius:4px;padding:2px 8px;cursor:pointer;font-size:14px;color:#1a3c6e;margin-left:8px}
.sub-items{display:none;padding:8px 0 8px 24px}
.sub-items.open{display:block}
.sub-item-label{font-size:12px;color:#888;margin-bottom:6px}
.sub-activity{display:flex;align-items:flex-start;gap:8px;font-size:13px;padding:4px 0;cursor:pointer}
.sub-activity input{width:14px;height:14px;margin-top:2px;accent-color:#1abc9c}
.empty-state{text-align:center;padding:40px 20px}
.spc-nav-buttons{display:flex;justify-content:space-between;margin-top:32px;gap:16px}
.spc-btn-prev{background:#fff;color:#1a2340;border:2px solid #1a2340;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
.spc-btn-next{background:#1abc9c;color:#fff;border:none;border-radius:8px;padding:12px 36px;font-size:15px;font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div style="padding-top:16px;border-top:1px solid rgba(255,255,255,.15)">
        <div class="progress-title">Your progress</div>
        <t t-foreach="steps" t-as="step">
            <div class="progress-step">
                <t t-if="step_index + 1 == current_step">
                    <div class="progress-step-num active"><t t-esc="step_index + 1"/></div>
                    <div class="progress-step-label active"><t t-esc="step"/></div>
                </t>
                <t t-elif="step_index + 1 &lt; current_step">
                    <div class="progress-step-num done">&#10003;</div>
                    <div class="progress-step-label"><t t-esc="step"/></div>
                </t>
                <t t-else="">
                    <div class="progress-step-num"><t t-esc="step_index + 1"/></div>
                    <div class="progress-step-label"><t t-esc="step"/></div>
                </t>
            </div>
        </t>
    </div>
    <div class="total-box">
        <div style="font-size:11px;opacity:.6;margin-bottom:2px">Total</div>
        <div style="font-size:11px;opacity:.6">AED</div>
        <div style="font-size:20px;font-weight:700"><t t-esc="'%.2f' % (fee or 0)"/> <span style="font-size:14px">&#9432;</span></div>
    </div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <div class="step-label">01</div>
    <div class="step-title">Select business activity(s)</div>
    <div class="step-sub">What business activity(s) will the company practice?</div>
    <div class="search-wrap">
        <input type="text" class="search-bar" id="activitySearch" placeholder="Search by keyword" oninput="filterActivities(this.value)"/>
        <span class="search-icon">&#128269;</span>
    </div>
    <div class="tabs" id="tabsRow">
        <button class="tab active" onclick="filterByTab('',this)">All</button>
        <t t-foreach="categories" t-as="cat">
            <button class="tab" t-attf-onclick="filterByTab('#{cat[0]}',this)"><t t-esc="cat[1]"/></button>
        </t>
    </div>
    <div class="divisions-wrap" id="divisionsWrap">
        <div class="empty-tab-msg" id="emptyTabMsg">Select a category tab to view activities.</div>
        <t t-foreach="categories" t-as="cat">
            <t t-set="cat_data" t-value="activities_data.get(cat[0], {})"/>
            <t t-foreach="cat_data.get('divisions', {}).items()" t-as="div_item">
                <t t-set="div_name" t-value="div_item[0]"/>
                <t t-set="div_acts" t-value="div_item[1]"/>
                <div class="division-item" t-att-data-cat="cat[0]" style="display:none">
                    <div class="division-header" onclick="toggleDivision(this)">
                        <span><t t-esc="div_name"/></span>
                        <span class="div-arrow">&#8964;</span>
                    </div>
                    <div class="division-body">
                        <t t-foreach="div_acts" t-as="act">
                            <t t-if="'.' not in act['code']">
                                <t t-set="child_prefix" t-value="act['code'] + '.'"/>
                                <t t-set="has_children" t-value="any(child_prefix in a['code'] for a in div_acts)"/>
                                <div class="row-item" t-att-data-parent="act['code']">
                                    <div class="row-item-left">
                                        <input type="checkbox" t-att-value="act['name']" t-att-id="'cb_' + act['code']" name="business_activities" onchange="updateSelected(this)"/>
                                        <label t-att-for="'cb_' + act['code']" style="cursor:pointer;font-weight:600"><t t-esc="act['name']"/></label>
                                    </div>
                                    <t t-if="has_children">
                                        <button type="button" class="row-expand-btn" t-attf-onclick="toggleSub('#{act['code']}', this)" title="Expand">+</button>
                                    </t>
                                </div>
                                <t t-if="has_children">
                                    <div class="sub-items" t-att-id="'sub_' + act['code']">
                                        <div class="sub-item-label">This class includes:</div>
                                        <t t-foreach="div_acts" t-as="child">
                                            <t t-if="child['code'].startswith(child_prefix)">
                                                <label class="sub-activity">
                                                    <input type="checkbox" t-att-value="child['name']" name="business_activities" onchange="updateSelected(this)"/>
                                                    <span><t t-esc="child['name']"/></span>
                                                </label>
                                            </t>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </div>
    <div style="margin-bottom:24px">
        <div class="step-label">02</div>
        <div class="step-title">List of business activity(s) selected</div>
        <div id="selectedList" style="margin-top:12px;min-height:60px;border:1px solid #eee;border-radius:8px;padding:12px">
            <div id="emptySelected" style="text-align:center;padding:20px;color:#aaa">
                <div style="font-size:32px">&#127881;</div>
                <div style="font-weight:600;color:#1a2340">Woohoo!</div>
                <div style="font-size:13px">No Activity selected yet.</div>
            </div>
        </div>
    </div>
    <form method="post" t-att-action="form_submit_url" id="actForm">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div id="hiddenActivities"></div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script type="text/javascript">/*<![CDATA[*/
var selectedActivities = [];
function filterByTab(cat, btn) {
    document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active')});
    btn.classList.add('active');
    var items = document.querySelectorAll('.division-item');
    var msg = document.getElementById('emptyTabMsg');
    if (!cat) {
        items.forEach(function(el){el.style.display='block'});
        msg.style.display='none';
    } else {
        var found = false;
        items.forEach(function(el){
            if (el.getAttribute('data-cat') === cat) { el.style.display='block'; found=true; }
            else el.style.display='none';
        });
        msg.style.display = found ? 'none' : 'block';
    }
}
function toggleDivision(hdr) {
    var body = hdr.nextElementSibling;
    body.classList.toggle('open');
}
function toggleSub(code, btn) {
    var sub = document.getElementById('sub_' + code);
    if (sub) { sub.classList.toggle('open'); btn.textContent = sub.classList.contains('open') ? '-' : '+'; }
}
function updateSelected(cb) {
    var val = cb.value;
    if (cb.checked) { if (selectedActivities.indexOf(val) === -1) selectedActivities.push(val); }
    else { selectedActivities = selectedActivities.filter(function(v){return v !== val}); }
    renderSelected();
}
function renderSelected() {
    var list = document.getElementById('selectedList');
    var empty = document.getElementById('emptySelected');
    var hidden = document.getElementById('hiddenActivities');
    hidden.innerHTML = '';
    if (selectedActivities.length === 0) {
        empty.style.display = 'block';
        return;
    }
    empty.style.display = 'none';
    selectedActivities.forEach(function(a) {
        var inp = document.createElement('input');
        inp.type = 'hidden'; inp.name = 'business_activities'; inp.value = a;
        hidden.appendChild(inp);
    });
    var html = selectedActivities.map(function(a,i) {
        return '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;border-bottom:1px solid #f5f5f5;font-size:13px"><span>' + a + '</span><button type="button" onclick="removeActivity(' + i + ')" style="background:none;border:none;color:#e74c3c;cursor:pointer;font-size:16px">&#215;</button></div>';
    }).join('');
    list.innerHTML = html;
}
function removeActivity(idx) {
    var val = selectedActivities[idx];
    selectedActivities.splice(idx, 1);
    document.querySelectorAll('input[type=checkbox]').forEach(function(cb){ if(cb.value===val) cb.checked=false; });
    renderSelected();
}
function filterActivities(q) {
    q = q.toLowerCase();
    document.querySelectorAll('.row-item').forEach(function(row){
        var label = row.querySelector('label');
        if (label) row.style.display = label.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
/*]]>*/</script>
</body></html>
</template>


<!-- RA Step 5: Shareholders -->
<template id="template_ra_step5" name="RA Step5 Shareholders">
<html><head><meta charset="utf-8"/><title>Shareholder Information | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>
.accordion{border:1px solid #e0e0e0;border-radius:10px;margin-bottom:12px;overflow:hidden}
.accordion-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;cursor:pointer;background:#fff;font-weight:600;font-size:14px;color:#1a2340}
.accordion-header:hover{background:#f8f9fa}
.accordion-arrow{font-size:12px;transition:transform .2s}
.accordion-arrow.open{transform:rotate(180deg)}
.accordion-body{display:none;padding:24px;border-top:1px solid #e0e0e0;background:#f9f9f9}
.accordion-body.open{display:block}
.field-row{position:relative;margin-bottom:16px}
.field-row label{position:absolute;top:8px;left:14px;font-size:11px;color:#888;pointer-events:none;z-index:1}
.field-row .field-input{width:100%;padding:24px 14px 8px;border:1px solid #d0d0d0;border-radius:8px;font-size:14px;color:#333;outline:none;background:#fff}
.field-row .field-input:focus{border-color:#1abc9c}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.type-toggle{display:flex;gap:0;margin-bottom:20px;max-width:300px}
.type-btn{flex:1;padding:10px;border:1px solid #ddd;background:#fff;font-size:13px;font-weight:600;cursor:pointer;color:#555}
.type-btn:first-child{border-radius:8px 0 0 8px}
.type-btn:last-child{border-radius:0 8px 8px 0}
.type-btn.active{background:#1a2340;color:#fff;border-color:#1a2340}
.upload-label{font-size:13px;color:#374151;font-weight:500;margin-bottom:8px;display:block}
.count-input{width:120px;padding:12px 14px;border:1px solid #d0d0d0;border-radius:8px;font-size:15px;color:#333;outline:none}
.count-input:focus{border-color:#1abc9c}
</style>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num"><t t-if="snum &lt; current_step">&#10003;</t><t t-else=""><t t-esc="snum"/></t></div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
    <div class="sidebar-links">
        <a href="#">SAVE &amp; CONTINUE LATER</a>
        <a href="#">CANCEL APPLICATION</a>
    </div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" t-att-action="form_submit_url" id="ra_sh_form" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Number of shareholders</div>
                <input class="count-input" type="number" name="shareholder_count" id="sh_count" value="1" min="1" max="10" onchange="buildAccordions()"/>
            </div>
        </div>
        <div class="spc-section">
            <div class="sec-num">02</div>
            <div class="sec-body">
                <div class="sec-title">Shareholder details</div>
                <div id="sh_accordions"></div>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script type="text/javascript">/*<![CDATA[*/
function buildAccordions(){
    var count = parseInt(document.getElementById('sh_count').value) || 1;
    var container = document.getElementById('sh_accordions');
    container.innerHTML = '';
    for(var i = 1; i <= count; i++){
        container.innerHTML += shAccordion(i);
    }
}
function shAccordion(i){
    return '<div class="accordion">' +
        '<div class="accordion-header" onclick="toggleAcc(this)">' +
            'Shareholder ' + i +
            '<span class="accordion-arrow">&#8964;</span>' +
        '</div>' +
        '<div class="accordion-body open">' +
            '<div class="type-toggle">' +
                '<button type="button" class="type-btn active" onclick="shToggleType('+i+',\'individual\',this)">Individual</button>' +
                '<button type="button" class="type-btn" onclick="shToggleType('+i+',\'corporate\',this)">Corporate</button>' +
            '</div>' +
            '<input type="hidden" name="sh_'+i+'_type" id="sh_'+i+'_type" value="individual"/>' +
            '<div class="two-col">' +
                '<div class="field-row"><label>First name</label><input class="field-input" type="text" name="sh_'+i+'_first_name" placeholder=" "/></div>' +
                '<div class="field-row"><label>Last name</label><input class="field-input" type="text" name="sh_'+i+'_last_name" placeholder=" "/></div>' +
            '</div>' +
            '<div class="field-row"><label>Passport number</label><input class="field-input" type="text" name="sh_'+i+'_passport_no" placeholder=" "/></div>' +
            '<div class="field-row"><label>Nationality</label><input class="field-input" type="text" name="sh_'+i+'_nationality" placeholder=" "/></div>' +
            '<div class="two-col">' +
                '<div class="field-row"><label>Email</label><input class="field-input" type="email" name="sh_'+i+'_email" placeholder=" "/></div>' +
                '<div class="field-row"><label>Mobile</label><input class="field-input" type="tel" name="sh_'+i+'_mobile" placeholder=" "/></div>' +
            '</div>' +
            '<div class="two-col">' +
                '<div class="field-row"><label>Date of birth</label><input class="field-input" type="date" name="sh_'+i+'_dob"/></div>' +
                '<div class="field-row"><label>Shares (%)</label><input class="field-input" type="number" name="sh_'+i+'_shares" placeholder=" " min="0" max="100"/></div>' +
            '</div>' +
            '<div class="upload-label">Passport copy</div>' +
            '<div class="upload-box" onclick="document.getElementById(\'sh_'+i+'_passport\').click()">' +
                '<input type="file" id="sh_'+i+'_passport" name="sh_'+i+'_passport_copy" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>' +
                '<div class="upload-icon">&#11014;</div>' +
                '<div class="upload-text">Upload passport copy</div>' +
            '</div>' +
        '</div>' +
    '</div>';
}
function toggleAcc(header){
    var body = header.nextElementSibling;
    var arrow = header.querySelector('.accordion-arrow');
    body.classList.toggle('open');
    arrow.classList.toggle('open');
}
function shToggleType(i, type, btn){
    document.getElementById('sh_'+i+'_type').value = type;
    btn.parentElement.querySelectorAll('.type-btn').forEach(function(b){b.classList.remove('active')});
    btn.classList.add('active');
}
document.addEventListener('DOMContentLoaded', function(){ buildAccordions(); });
/*]]>*/</script>
</body></html>
</template>


<!-- RA Supporting Documents -->
<template id="template_ra_supporting_docs" name="RA Supporting Documents">
<html><head><meta charset="utf-8"/><title>Supporting Documents | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num">
                <t t-if="snum &lt; current_step">&#10003;</t>
                <t t-else=""><t t-esc="snum"/></t>
            </div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
    <div class="sidebar-links">
        <a href="#">SAVE &amp; CONTINUE LATER</a>
        <a href="#">CANCEL APPLICATION</a>
    </div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" t-att-action="form_submit_url" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Upload supporting documents</div>
                <div class="upload-row">
                    <div>
                        <div class="upload-label">Passport copy of manager(s)</div>
                        <div class="upload-box" onclick="document.getElementById('doc_passport').click()">
                            <input type="file" id="doc_passport" name="doc_passport" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                            <div class="upload-icon">&#11014;</div>
                            <div class="upload-text">Upload document</div>
                        </div>
                    </div>
                    <div>
                        <div class="upload-label">UAE visa / entry stamp copy</div>
                        <div class="upload-box" onclick="document.getElementById('doc_visa').click()">
                            <input type="file" id="doc_visa" name="doc_visa" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                            <div class="upload-icon">&#11014;</div>
                            <div class="upload-text">Upload document</div>
                        </div>
                    </div>
                    <div>
                        <div class="upload-label">Authorization form (if applicable)</div>
                        <div class="upload-box" onclick="document.getElementById('doc_auth').click()">
                            <input type="file" id="doc_auth" name="doc_auth" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/>
                            <div class="upload-icon">&#11014;</div>
                            <div class="upload-text">Upload document</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
</body></html>
</template>


<!-- RA Step 6: Managers -->
<template id="template_ra_step6" name="RA Step6 Managers">
<html><head><meta charset="utf-8"/><title>Manager Information | Renewal Amendment</title>
<t t-call="spc_portal.spc_new_modules_shared_css"/>
<style>
.accordion{border:1px solid #e0e0e0;border-radius:10px;margin-bottom:12px;overflow:hidden}
.accordion-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;cursor:pointer;background:#fff;font-weight:600;font-size:14px;color:#1a2340}
.accordion-body{display:none;padding:24px;border-top:1px solid #e0e0e0;background:#f9f9f9}
.accordion-body.open{display:block}
.field-row{position:relative;margin-bottom:16px}
.field-row label{position:absolute;top:8px;left:14px;font-size:11px;color:#888;pointer-events:none}
.field-row .field-input{width:100%;padding:24px 14px 8px;border:1px solid #d0d0d0;border-radius:8px;font-size:14px;outline:none;background:#fff}
.field-row .field-input:focus{border-color:#1abc9c}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.count-input{width:120px;padding:12px 14px;border:1px solid #d0d0d0;border-radius:8px;font-size:15px;outline:none}
.count-input:focus{border-color:#1abc9c}
</style>
</head><body>
<div class="layout">
<div class="sidebar">
    <div class="sidebar-logo">&#9670; SPC<span>Free Zone</span></div>
    <div class="progress-title">Your progress</div>
    <t t-foreach="steps" t-as="step">
        <t t-set="snum" t-value="step_index + 1"/>
        <div t-attf-class="progress-step #{snum == current_step and 'active' or snum &lt; current_step and 'done' or ''}">
            <div class="step-num"><t t-if="snum &lt; current_step">&#10003;</t><t t-else=""><t t-esc="snum"/></t></div>
            <div class="step-label"><t t-esc="step"/></div>
        </div>
    </t>
    <div class="total-box">Total AED<div class="amount">10.00</div></div>
</div>
<div class="main">
    <div class="form-title">Renewal with Amendment</div>
    <form method="post" t-att-action="form_submit_url" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="service_type" t-att-value="service_type"/>
        <div class="spc-section">
            <div class="sec-num">01</div>
            <div class="sec-body">
                <div class="sec-title">Number of managers</div>
                <input class="count-input" type="number" name="manager_count" id="mgr_count" value="1" min="1" max="10" onchange="buildMgrAccordions()"/>
            </div>
        </div>
        <div class="spc-section">
            <div class="sec-num">02</div>
            <div class="sec-body">
                <div class="sec-title">Manager details</div>
                <div id="mgr_accordions"></div>
            </div>
        </div>
        <div class="spc-nav-buttons">
            <button type="button" class="spc-btn-prev" onclick="window.history.back()">PREVIOUS</button>
            <button type="submit" class="spc-btn-next">NEXT</button>
        </div>
    </form>
</div>
</div>
<script type="text/javascript">/*<![CDATA[*/
function buildMgrAccordions(){
    var count = parseInt(document.getElementById('mgr_count').value)||1;
    var c = document.getElementById('mgr_accordions');
    c.innerHTML='';
    for(var i=1;i<=count;i++) c.innerHTML+=mgrCard(i);
}
function mgrCard(i){
    return '<div class="accordion"><div class="accordion-header" onclick="this.nextElementSibling.classList.toggle('open')">Manager '+i+'</div><div class="accordion-body open"><div class="two-col"><div class="field-row"><label>First name</label><input class="field-input" type="text" name="mgr_'+i+'_first_name" placeholder=" "/></div><div class="field-row"><label>Last name</label><input class="field-input" type="text" name="mgr_'+i+'_last_name" placeholder=" "/></div></div><div class="field-row"><label>Nationality</label><input class="field-input" type="text" name="mgr_'+i+'_nationality" placeholder=" "/></div><div class="two-col"><div class="field-row"><label>Email</label><input class="field-input" type="email" name="mgr_'+i+'_email" placeholder=" "/></div><div class="field-row"><label>Mobile</label><input class="field-input" type="tel" name="mgr_'+i+'_mobile" placeholder=" "/></div></div><div class="field-row"><label>Passport number</label><input class="field-input" type="text" name="mgr_'+i+'_passport_no" placeholder=" "/></div><div class="upload-label">Passport copy</div><div class="upload-box" onclick="document.getElementById('mgr_'+i+'_pf').click()"><input type="file" id="mgr_'+i+'_pf" name="mgr_'+i+'_passport_file" style="display:none" accept=".pdf,.jpg,.jpeg,.png"/><div class="upload-icon">&#11014;</div><div class="upload-text">Upload passport</div></div></div></div>';
}
document.addEventListener('DOMContentLoaded', function(){ buildMgrAccordions(); });
/*]]>*/</script>
</body></html>
</template>

