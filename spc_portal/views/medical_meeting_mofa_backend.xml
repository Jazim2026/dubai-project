                            <field name="payment_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="doc_individual_ids" widget="many2many_binary"/>
                                <field name="doc_commercial_ids" widget="many2many_binary"/>
                                <field name="doc_invoice_ids" widget="many2many_binary"/>
                            </group>
